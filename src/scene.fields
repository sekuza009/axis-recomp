0x110      4          u32 source                                # where its items load from: 0 / 1 loose files with the first / second extension (shp / obj, ske / ase), 2 the packed archive (Shape.dat / Skeleton.dat); every caller passes 2
0x114      4          i32 capacity                              # items it has room for
0x118      4          u8 *nodes                                 # the name tree: one 0x4c-byte TreeNode per item
0x11c      4          u8 *items                                 # the items (skeletons 0x24 bytes, shapes 0x4c)
0x120      4          i32 count                                 # items loaded
