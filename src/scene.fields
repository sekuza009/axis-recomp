# The game's record types and the scene object. tools/mkscene.py turns this into scene.h: packed structs with
# padding between the known fields and a compile-time check of every offset. Sections start with
# "struct Name size"; fields are "offset  size  declaration  # comment". Add fields as rebuilds need them.

struct MessageSlot 0x14                                         # a message waiting in the box (Scene.msgRing)
4          4          u32 text                                  # its text block in Scene.msgText
8          4          i32 colour                                # index into g_textColours; 16 and up: none

struct EventLine 0x108                                          # one line of the event list (Scene.events)
0          4          u32 type                                  # 0..5: the colour
4          0x100      char text[0x100]
0x104      4          u32 time                                  # Scene.eventTime when it was written

struct Player 0x8888                                            # a player's record (Scene.players)
0xe0       4          i32 levelShown                             # (by use) the level last announced ("LEVEL UP!" when the emblem's passes it)
0xf8       4          i32 startPoints                            # the level points it started the match with
0x374      4          i32 sendFlag                               # (unclear) cleared each frame; 1: its state is sent (net_sendPlayerState)
0x8868     4          i32 killPending                            # (by use) 1: it died; the kill is reported (msg_kill with lastAttacker) and this cleared
0x538      4          i32 lastWarp                               # (by use) the warp zone (item) it came through last (-1 none: not kept off it)
0x53c      4          i32 onWarp                                 # 1: touching a warp zone this frame
0x540      4          float warpWait                             # seconds before it can warp again (2)
8          4          i32 hackingLevel                           # (the ARM CENTER's HACKING LEVEL) a cloaked actor (timerFlags 0x200) is seen by those whose level is above its own
0xc        4          float lockOnTime                           # (the ARM CENTER's LOCK-ON TIME) x the weapon's ring range: the lock-on reaches that far
0x10       4          float targetKeepTime                       # (the ARM CENTER's TARGET KEEP TIME) seconds a lock-on holds once out of reach
0x14       4          float loadMax                              # (by use) the weight carried without slowing (the chest's, by level and items)
0x18       4          float load                                 # the parts' and items' weight (over loadMax: slower)
# the items' bonuses (actor_computeStats: item kinds 0x1b .. 0x23)
0x404      0x10       float ammoFactor[4]                        # x the arms' ammunition, per kind
0x414      0x10       i32 ammoBonus[4]                           # + rounds, per kind
0x424      4          float rangeBonus                           # + the sight range (radiusSq)
0x428      4          float lockOnTimeFactor
0x42c      4          float targetKeepFactor
0x430      4          i32 hackingBonus
0x434      4          float boostTimeFactor
0x438      4          float rechargeTimeFactor
0x43c      4          float restTimeFactor
0x440      4          float loadFactor
0x444      4          float shieldFactor
0x4f4      0x40       char message[0x40]                         # (by use) a message for the local player ("OUT OF AMMO!")
0x534      4          float messageTime                          # its time shown (-10000: none)
0x124      4          float armorDeadline                        # (by use) blinkTime + 10 while in play (the local and bots'); past it: the armour is gone
0x4a4      4          float effectScale                          # (by use) the emitters' scale by the speed (0.5 .. 3)
0x4d0      4          i32 order                                  # (by use) an order to carry out this frame (-1 none): 0 refill, 1 ammunition, 2 / 3 orderFlag on / off, 4 a death
0x4d4      4          i32 orderFlag                              # (unclear) sent as state bit 0x1000
0x8800     4          i32 pathReverse                            # (by use) 1: the path is followed backwards
0x8804     4          float botWait                              # (by use) seconds a bot stays put
0x8808     4          i32 botWaitTrigger                         # (by use) a trigger a bot waits for (-1 none)
0x8810     4          i32 lookActor                              # (by use) the actor a bot looks at (-1 none)
0x8814     4          i32 lookPath                               # the path whose point it looks at (-1 none)
0x8818     4          i32 lookPoint
0x8824     4          float scanTime                             # (by use) a bot looks for a target every half second
0x8828     4          float burstPause                           # (by use) seconds to the next burst (botTimes[3])
0x882c     4          float burstFire                            # seconds of the burst left (botTimes[4])
0x8830     4          float dodgeTime                            # (by use) seconds to the next sideways step (botTimes[0])
0x8834     4          float heightTime                           # seconds to the next height change (botTimes[1])
0x8844     4          float lookTime                             # (by use) seconds to the next random look (2)
0x886c     4          float stuckTime                            # (by use) the path checked every second: moved under 500 -> dropped
0x8870     4          i32 stuckPath                              # the path dropped
0x8874     0xc        float stuckMove[3]                         # the moves summed over the second
0x38       4          float mobility                             # (the ARM CENTER's MOBILITY) how fast the movement keys ramp (a second)
0x3c       4          float moveAccel                            # the velocity's change towards the keys' (a second)
0x40       4          float leanPitch                            # the body's lean with the pitch
0x44       4          float boostTime                            # (by use) seconds of running the energy lasts
0x48       4          float rechargeTime                         # seconds the energy takes to refill
0x4c       4          float restTime                             # seconds of rest after running
0x54       0x10       float runTop[4]                            # (by use) the top speeds running: forward, back, right, left
# the motion state: this frame's (pos .. fireAnim, from the next one each frame: actor_frame.c), the next one
# (nextPos .. fireCycle: the keys', or moved towards the sent one), the sent one (netPos .. netMotion)
0x168      4          float forward                              # (by use) forward speed (-1 .. 1, more running)
0x16c      4          float strafe                               # sideways speed
0x170      4          float climb                                # 0 .. 1: going up (the altitude key)
0x174      4          float lean                                 # (by use) the body's lean forward (degrees x 10: from the speed and pitch)
0x178      4          float run                                  # 0 .. 1: running (the booster key)
0x180      0xc        float nextPos[3]
0x18c      4          float nextPitch
0x190      4          float nextYaw
0x198      4          float nextStrafe
0x19c      4          float nextClimb
0x1a0      4          float nextLean
0x1a4      4          float nextRun
0x1ac      0xc        float netPos[3]                            # (by use) the state last received (another machine's actor)
0x1b8      4          float netPitch
0x1bc      4          float netYaw
0x1c0      0x14       float netMotion[5]                         # forward, strafe, climb, lean, run
0x1d4      0xc        float botGoal[3]                           # (by use) where a bot goes
0x1e0      4          float botLookPitch                         # (by use) the pitch a bot turns to
0x1e4      4          float botLookYaw
0x1e8      4          i32 netFired                               # (by use) 1: rounds received this frame (fired by the others' copy)
0x1ec      4          i32 firing                                 # (by use) 1: firing this frame
0x378      0xc        float velocity[3]                          # (by use) moves towards the keys' (moveAccel)
0x384      0xc        float move[3]                              # (by use) this frame's move (nextPos - pos)
0x390      0x18       float pose[6]                              # (by use) the body's pose: swing, lean, head turn; 3 animation frames
0x3e8      4          float radius                               # (by use) its sphere against the others and the walls
0x4a8      4          float footstepTime                         # (by use) a footstep every third of a second
0x4e0      0xc        float deathPos[3]                          # (by use) where it died (its position while not in play)
0x885c     0xc        float push[3]                              # (by use) a hit's push on the local actor (with hitFlash)
0x150      4          float stateTime                            # (by use) seconds in its state (dying: out after 2)
0x1f4      4          float burstTime                            # (by use) the time to the burst's next round
0x448      4          i32 shieldRegen                            # (by use) shield regained a second (up to shieldMax)
0x4b0      4          float staminaRest                          # (by use) the rest after running (back to 1)
0x4ec      4          float glow                                 # (by use) a fresh shot's flash (and speed unless cloaked)
0x544      4          float shieldRegenTime                      # (by use) seconds towards the next shield regained
0x54c      4          i32 breakUp                                # (by use) the parts' break-up step (one a frame, to 7)
0x87f4     4          i32 botNeeds                               # (by use) bit 0: low armour (under 0.3); bit 1: both weapons empty
0x8858     4          float botTargetTime                        # (by use) seconds left on the bot's target (10.5)
0x8884     4          float beepTimer                            # (by use) the warning beep while aimed at (0.5 s)
0x104      4          i32 id                                     # (by use) its id (the next serial, or the network's)
0x114      4          i32 level                                  # (by use) its player's level (0 .. 8)
0x164      4          float yaw                                  # (by use) the heading (with pitch: the look)
0x484      4          i32 detail                                 # (unclear) the parts' variant wanted: they are reloaded when it differs from detailLoaded
0x488      4          i32 detailLoaded
0x498      4          i32 slotLoaded                             # (by use) the slot whose item was loaded last (another player's actor)
0x49c      4          i32 variantLoaded                          # (by use) the parts' variant loaded (0 for the selected actor, else detail + 1)
0x4c0      4          i32 lastAttacker                           # (by use) the actor that hit it last (credited with the kill)
0x110      4          i32 pilot                                  # (unclear) compared with the stage's local actor slot: its own actor when equal
0x11c      4          i32 bot                                    # (by use) not 0: run by the game (targets, following)
0x154      0xc        float pos[3]                               # (by use) its position (ray traces start there)
0x160      4          float pitch                                # (by use) the look's pitch, within +-89 degrees with the input's
0x194      4          float nextForward                          # (by use) the forward speed the keys build up (-1 .. 1, more running): copied to forward
0x1a8      4          float fireCycle                            # (by use) the firing cycle, wrapping at 1
0x1f0      4          i32 burstLeft                              # (by use) rounds of the current burst still to fire
0x48c      4          i32 weaponLowering                         # (by use) 1: the weapon is going down (weaponLower from 1 to 0)
0x490      4          float weaponLower
0x881c     4          i32 followTarget                           # (by use) the actor a bot follows (-1 none)
0x8820     4          i32 botTarget                              # (by use) the actor a bot attacks (-1 none)
0          4          float radiusSq                            # (by use) the spawn record's radius squared, x 10000
0x1c       4          i32 armorMax                              # (by use) the armor it starts with (actor_startingValues)
0x20       4          i32 shieldMax                             # the shield it starts with
0x28       0x10       i32 ammoMax[4]                            # (by use) per weapon slot: the full load (ammo starts at half)
0x50       4          float speed                               # (unclear) the spawn record's speed x 27.7778, kept twice (also topSpeed)
0x64       4          u32 spawn64                               # (unclear) the spawn record's +0x1c
0x68       4          float topSpeed                            # (unclear) see speed
0x6c       4          float accel                               # (unclear) the spawn record's +0x2c x 10
0x70       4          u32 spawn70                                 # (unclear) the spawn record's +0x34
0x74       4          i32 spawn74                               # (unclear) the spawn record's +0x38 x 10, whole
0x78       4          u32 spawn78                               # (unclear) the spawn record's +0x3c
0x7c       4          float dodgeSpread                         # (by use) a bot's sideways step about its target: up to +- this (the spawn record's +0x40 x 100)
0x80       4          float climbSpread                         # a bot's height about its target: up to +- this (the spawn record's +0x44 x 100)
0x84       0x14       float botTimes[5]                            # (by use) a bot's timings, seconds: [0] between sideways steps, [1] between height changes, [2] its distance kept from the target, [3] the pause between bursts, [4] a burst's length
0x44c      4          i32 inForward                             # the input it acts on this frame (actor_setInput): held forward
0x450      4          i32 inBackward
0x454      4          i32 inStepLeft
0x458      4          i32 inStepRight
0x464      4          float inPitch                             # the turn asked for this frame
0x468      4          float inYaw
0x46c      4          i32 inFire
0x470      4          i32 inAltitude
0x474      4          i32 inBooster
0x478      4          i32 inView                                # the view key (-1 none)
0x47c      4          i32 inPrevWeapon
0x480      4          i32 inNextWeapon
0x87f8     4          i32 target1                               # (by use) its targets (-1 none; dropped with the bullet: actor_clearTargetRefs)
0x87fc     4          i32 target2
0x884c     4          i32 cameraValue                           # (by use) the camera's value while it follows this actor (camera_setTarget)
4          4          float detectionAngle                      # (by use, the ARM CENTER's DETECTION ANGLE) tenths of a degree: the head's by level (the alert ring shows it)
0xec       4          i32 score                                 # shown top left
0x108      4          i32 active                                # 1: the slot is in use (0 for the local player's: "press fire" may be shown)
0x120      4          float blinkTime                           # (unclear) the energy bar blinks 4 times a second by it while warned
0x128      4          i32 armor                                 # (by use) shown bottom left (ARMOR)
0x12c      4          i32 shield                                # shown bottom left (SHIELD)
0x130      0x10       i32 ammo[4]                               # per weapon slot
0x140      4          i32 slot                                  # (by use) the selected item slot (the player record\'s items); its icon is the gauge\'s cell (3 x 3)
0x148      4          i32 actorType                             # index into Scene.actorInfo / snapshotTex
0x17c      4          float fireAnim                             # the frame of the weapon's firing animation (fireCycle a frame late; > 0: a larger, fainter crosshair)
0x3f0      4          i32 timerFlags                            # bit 8 + k: timer k shown
0x3f4      0x10       float timers[4]                           # seconds left (2: boost, the energy bar turns blue)
0x494      4          float gauge                               # > 0: the gauge is shown (its alpha, at most 1)
0x4ac      4          float energyUsed                          # 0..1
0x4b4      4          i32 overheat                              # 1: the energy bar is red
0x4b8      4          i32 warned                                # 1: the energy bar blinks red
0x4c4      4          i32 mechType                              # (by use) its mech: the actor type named in kill messages
0x4cc      4          i32 weapon                                # the selected weapon slot
0x548      4          float damageFlash                         # > 0: a white flash over the screen at this alpha
0x8854     4          float hitFlash                            # > 0: a red flash at half this alpha
0x8880     4          i32 alert                                 # (unclear) 1: the alert ring (red in network games)
0x98       0x40       char name[0x40]
0xdc       4          i32 emblem                                # emblem shown in the ranking
0xd8       4          i32 statD8                                # (unclear) cleared with the scores (match_4620e0)
0xe4       4          i32 kills
0xe8       4          i32 deaths
0xf0       4          i32 statF0                                # (unclear) cleared with the scores
0xf4       4          i32 statF4                                # (unclear) cleared with the scores
0xfc       4          i32 timePlayed                            # seconds
0x100      4          float timeExtra                           # (by use) added to timePlayed when a team's leader is picked; cleared with the scores
0x10c      4          i32 player                                 # (by use) the player record it belongs to (stride 0x47fd2; -1 none); the ranking shows that player's flag (unless Scene.network)
0x118      4          i32 team                                  # 0 / 1 in team games
0x14c      4          i32 state                                 # 1: in play
0x87bc     4          float screenX                             # projected position on the screen, pixels
0x87c0     4          float screenY
0x87cc     4          float topY                                # (by use) screen y of the point the marks stand on (above the player)
0x87e0     4          i32 onScreen                              # 1: projected in front of the camera
0x87e8     4          float lockedOn                            # > 0: locked on by the local player
0x87ec     4          float lockSize                            # how far the lock-on box still has to close
0x87f0     4          float labelFade                           # > 0: the name label is up (alpha labelFade / 3)
0x3ec      4          i32 statusIcon                            # (unclear) 1 / 2: an icon over the player
0x4d8      4          i32 markSolo                              # (unclear) 1: a mark (icon 8) after the player's ranking row and over the player, games without teams
0x550      4          i32 viewMarked                            # set by hud_pass for the player the view follows
0x4dc      4          i32 markTeam                              # (unclear) 1: a mark (the team's icon) after the player's ranking row and over the player, team games

struct ActorInfo 0x2e18                                         # an actor type's record (Scene.actorInfo)
0x2ddc     4          i32 damageMode                             # (by use, a weapon's) 0: its damage off the armour first, 1: off the shield
0x2de0     4          i32 damage                                 # a hit's damage
0x2e04     4          i32 hitSound                               # its hit sound (< 0 none)
0x2e14     4          float push                                 # > 0: a hit pushes the actor (x 10, away from the bullet)
0x2dc0     4          i32 ammoSlot                              # (by use, a weapon's) the ammunition slot it uses (Player.ammo)
0x2dc4     4          i32 ammoPerShot                           # ammunition one shot takes
0x2dc8     4          i32 burst                                 # rounds a burst
0x2dcc     4          float burstGap                            # (unclear) the time between bursts
0x2de4     4          float stepLength                          # a shot's first step (traced)
0x2de8     4          float velocity                            # its speed (0: it arrives at once)
0x2dec     4          float spread                              # aimed shots spread by it, less the owner's steadiness
0x2df0     4          float flashSize                           # its muzzle flash's size
0x2df4     4          float splashRadius                        # (unclear)
0x2dfc     4          i32 shotMode                              # 3: fired into a random cone; its muzzle flash is particle kind shotMode + 10
0x2e00     4          i32 sound                                 # its firing sound (< 0 none)
0x2e08     4          float cycleTime                           # seconds a firing cycle
0x2e0c     4          float tracer                              # > 0: the local player's tracer
0          0x40       char name[0x40]                           # the folder under Actor/
0x2e10     4          float ringRange                           # (unclear) > 0: the alert ring is shown

struct PlayerRecord 0x47fd2                                      # a player of the match (Scene / Stage playerRecords): its team, mech parts and items; its actor points back (Player.player)
0          4          i32 used                                   # (by use) 1: in use (playerRecord_markUsed / markFree)
0x479c2    0x600      u32 emblem[16][24]                         # (by use) its emblem: 24 x 16 RGBA (its screenshot, Save\<name>.BMP)
0x47fca    4          i32 emblemChanged                          # 1: to be copied into the emblem atlas (flagShown: it is there)
0x44       4          i32 level                                  # (by use) its level (the profile's factors by it)
0x48       4          i32 team
0x30c      0x14       i32 parts[5]                               # its mech's parts: head, chest, arms, legs, booster (records of the stage's part tables; "invalid headIndex")
0x320      0x18       i32 items[6]                              # per item slot (Player.slot): its weapon's record (index into Scene.actorInfo; < 0 none)
0x47fc6    4          i32 flagShown                             # 1: its flag is shown (ranking, markers)

struct Model 0x4c                                               # a shape (skel_data.c: its 0x34-byte file header, then its box; a map object's model, an object list's entries...)
4          4          i32 blockSize                              # its data block (take_block): the parts and their tables
8          4          u8 *block
0xc        4          i32 ownsBlock                              # 1: allocated here (freed with it)
0x10       4          i32 partCount
0x14       4          u8 *parts                                  # partCount ShapePart records (0x80 bytes), at the block's start
0x20       0xc        float centre[3]                            # (by use) a point of the file's header: the box starts from it
0x30       4          u32 version                                # 0x71110300: the current format (older: 0x68-byte parts)
0x34       0xc        float low[3]                               # the box over its parts
0x40       0xc        float high[3]
0x18       4          i32 colourCount                           # (by use) dwords in a shading colour buffer for it
0x1c       4          i32 count1c                                # (unclear) cleared with colourCount (stage_buildMeshDrawRecords)
0x2c       4          float radius                              # its bounding sphere

struct ShapePart 0x80                                           # a shape's part (Model.parts): one material's vertices and primitives
0          0x40       char name[0x40]                            # (by use) its material's name (the texture looked up by it: names.c)
0x44       4          i32 texture                                # its texture's id (-1 / 0 none)
0x48       4          i32 colourBase                             # its first vertex in the shape's colour buffer
0x4c       4          i32 vertexCount
0x50       4          u8 *vertices                               # 12 bytes each
0x54       4          u8 *normals                                # 12 bytes each
0x58       4          u8 *colours                                # 4 bytes each
0x5c       4          float *texCoords                           # 2 floats each
0x60       4          i32 primCount
0x64       4          u8 *prims                                  # ShapePrim records (0xc bytes)
0x68       0x18       float box[6]                               # its low and high corners

struct ShapePrim 0xc                                            # a part's primitive: its index list
4          4          i32 indexCount
8          4          u8 *indices                                # 4 bytes each

struct ListedObject 0x64                                        # an object list's entry (ObjectList.entries)
0          4          Model *shape                              # none: an empty entry
8          4          u32 *colours                              # its shading colours (Model.colourCount dwords)
0xc        0x40       float matrix[16]                          # where it is placed

struct ObjectList 0x30                                          # shapes placed by their own matrices (data_46f7a0, hud_46fd20; the size is unknown)
4          4          i32 blockSize                              # (by use) its block: the entries (100 bytes each), their colours when preLit, the skeletons
8          4          u8 *block
0xc        4          i32 ownsBlock                              # 1: allocated here
0x10       4          i32 count
0x14       4          ListedObject *entries
0x18       4          i32 colourCount                            # the entries' shapes' colours summed
0x1c       4          i32 frameCount                            # 0: nothing to draw (ObjectList_load: the skeletons named, one a frame)
0x20       4          i32 *frames                               # frames[frame] == 0: nothing to draw
0x24       4          i32 frame
0x2c       4          i32 preLit                                # 1: lit here, drawn with its own colours

struct LightFactors 0xb010                                      # (by use) the light factors shape_shadeParts takes (the size is unknown)
0xb00c     4          i32 enabled                               # 1: a pre-lit object list uses them without point lights

struct MapObject 0x2cc                                          # a map object (Scene.objects): animated scenery
0          4          i32 id                                     # (by use) a serial (Stage.objectSerial)
8          4          i32 nameIndex                              # its type's name (Stage.objectNames)
0x18       0x40       char animPath[0x40]                        # its animation ("dir/map/name"; none: empty)
0x58       0xc        float place[3]                             # its position (the type record's)
0x64       0x10       float rotation[4]                          # a quaternion
0x74       0x40       float placeMatrix[16]                      # translation x rotation
0xb4       0x40       float placeInverse[16]
0x134      0x40       float matrixInverse[16]                    # (matrix: a copy of placeMatrix)
0x174      0x40       float identity1[16]
0x1b4      0x40       float identity2[16]
0x1f4      0x40       float relMatrix[16]                        # matrix x placeInverse
0x234      0x40       float relInverse[16]
0x274      4          u32 typeValue1                             # (unclear) the type record's +0xa8, +0xac
0x278      4          u32 typeValue2
4          4          i32 active                                # 1: in use
0xc        1          u8 flags                                  # bit 1 (2): not drawn
0xf4       0x40       float matrix[16]                          # where it is drawn
0x27c      4          Model *model
0x280      8          u32 colours[2]                             # (by use) two runs of its shading colours (from Stage.objectColours; object_initObjectBy)
0x288      4          i32 colourSide                             # which run is drawn (0: the first)
0x28c      4          void *unit                                # its collision unit (none: 0)
0x290      4          i32 animated                              # 1: its skeleton plays
0x294      4          void *skeleton
0x29c      4          float animRate                            # 1 / the period (0: stopped)
0x2a0      4          i32 animMode
0x2bc      0xc        float pos[3]                              # the centre of its bounding sphere

struct ItemType 0x90                                            # a kind of map item (Stage.itemTypes)
0x8c       4          Model *model                              # its shape when items are drawn in 3D (none: not drawn)

struct MapItem 0x28                                             # an item lying on the map (Stage.items): power-ups, ammo...
4          4          i32 warpTo                                 # (by use) a warp zone's: the item it leads to
8          4          i32 warpPitch                              # its pitch there (x 10)
0          4          i32 type                                  # index into Stage.itemTypes and the item atlas; < 0: none
0xc        0xc        float pos[3]
0x1c       4          float angle                               # its turn, tenths of a degree
0x20       4          i32 taken                                 # 1: taken (not drawn)
0x24       4          float fade                                # below 1: drawn faded (alpha 255 * fade)

struct Projectile 0x12c                                         # a particle or effect (Stage.projectiles: particle_init / particle_update): flashes, sparks, beams, trails, explosions...
0          4          i32 id                                    # a serial (Stage +0x20f2da8)
8          4          i32 kind                                  # what it is: 2 / 3 explosions, 9 sparks, 25 / 26 beams, 40 .. 49 trails, 50 a scripted effect ...
0xc        4          i32 owner                                 # the actor (or player) it belongs to
0x10       0xc        float pos[3]
0x1c       0xc        float target[3]                           # (by use) the point it aims at; some kinds keep a size in target[0]
0x28       4          u32 matrixFrom                            # (by use) a matrix copied into matrix at its start (0: none)
0x2c       0x40       float matrix[16]
0x6c       4          float drawAge                             # its age as drawn this frame (age before the frame's step)
0x70       4          float life                                # seconds it lives (it is freed past it)
0x74       4          float age
