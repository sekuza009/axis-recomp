# The game's record types and the scene object. tools/mkscene.py turns this into scene.h: packed structs with
# padding between the known fields and a compile-time check of every offset. Sections start with
# "struct Name size"; fields are "offset  size  declaration  # comment". Add fields as rebuilds need them.

struct MessageSlot 0x14                                         # a message waiting in the box (Scene.msgRing)
4          4          u32 text                                  # its text block in Scene.msgText
8          4          i32 colour                                # index into g_textColours; 16 and up: none

struct EventLine 0x108                                          # one line of the event list (Scene.events)
0          4          u32 type                                  # 0..5: the colour
4          0x104      char text[0x104]

struct Player 0x8888                                            # a player's record (Scene.players)
4          4          float heading                             # (by use) tenths of a degree (the alert ring turns with it)
0xec       4          i32 score                                 # shown top left
0x120      4          float blinkTime                           # (unclear) the energy bar blinks 4 times a second by it while warned
0x128      4          i32 counterA                              # (unclear) the first of the two counters bottom left
0x12c      4          i32 counterB
0x130      0x10       i32 ammo[4]                               # per weapon slot
0x140      4          i32 gaugeIcon                             # cell of the gauge (3 x 3 cells)
0x148      4          i32 actorType                             # index into Scene.actorInfo / snapshotTex
0x17c      4          float aimBonus                            # (unclear) > 0: a larger, fainter crosshair
0x3f0      4          i32 timerFlags                            # bit 8 + k: timer k shown
0x3f4      0x10       float timers[4]                           # seconds left (2: boost, the energy bar turns blue)
0x494      4          float gauge                               # > 0: the gauge is shown (its alpha, at most 1)
0x4ac      4          float energyUsed                          # 0..1
0x4b4      4          i32 overheat                              # 1: the energy bar is red
0x4b8      4          i32 warned                                # 1: the energy bar blinks red
0x4cc      4          i32 weapon                                # the selected weapon slot
0x548      4          float damageFlash                         # > 0: a white flash over the screen at this alpha
0x8854     4          float hitFlash                            # > 0: a red flash at half this alpha
0x8880     4          i32 alert                                 # (unclear) 1: the alert ring (red in network games)
0x98       0x40       char name[0x40]
0xdc       4          i32 emblem                                # emblem shown in the ranking
0xe4       4          i32 kills
0xe8       4          i32 deaths
0xfc       4          i32 timePlayed                            # seconds
0x10c      4          i32 flagOwner                             # whose flag the ranking shows for this player (unless Scene.network)
0x118      4          i32 team                                  # 0 / 1 in team games
0x14c      4          i32 state                                 # 1: in play
0x87bc     4          float screenX                             # projected position on the screen, pixels
0x87c0     4          float screenY
0x87cc     4          float topY                                # (by use) screen y of the point the marks stand on (above the player)
0x87e0     4          i32 onScreen                              # 1: projected in front of the camera
0x87e8     4          float lockedOn                            # > 0: locked on by the local player
0x87ec     4          float lockSize                            # how far the lock-on box still has to close
0x87f0     4          float labelFade                           # > 0: the name label is up (alpha labelFade / 3)
0x3ec      4          i32 statusIcon                            # (unclear) 1 / 2: an icon over the player
0x4d8      4          i32 markSolo                              # (unclear) 1: a mark (icon 8) after the player's ranking row and over the player, games without teams
0x108      4          i32 waitingRespawn                        # (unclear) 0: "press fire" may be shown
0x550      4          i32 viewMarked                            # set by hud_pass for the player the view follows
0x4dc      4          i32 markTeam                              # (unclear) 1: a mark (the team's icon) after the player's ranking row and over the player, team games

struct ActorInfo 0x2e18                                         # an actor type's record (Scene.actorInfo)
0          0x40       char name[0x40]                           # the folder under Actor/
0x2e10     4          float ringRange                           # (unclear) > 0: the alert ring is shown

struct FlagSlot 0x47fd2                                         # (unclear) a record of stride 0x47fd2 whose first field says a flag is shown
0          4          i32 shown

struct Model 0x30                                               # a map object's model (skeleton; the size is unknown: only the fields used)
0x2c       4          float radius                              # its bounding sphere

struct MapObject 0x2cc                                          # a map object (Scene.objects): animated scenery
4          4          i32 active                                # 1: in use
0xc        1          u8 flags                                  # bit 1 (2): not drawn
0xf4       0x40       float matrix[16]                          # where it is drawn
0x27c      4          Model *model
0x280      4          u32 poseFrom                              # the pose's source and destination; passed to the view volume by poseSide
0x284      4          u32 poseTo
0x288      4          i32 poseSide                              # 0: poseFrom, else poseTo
0x2bc      0xc        float pos[3]                              # the centre of its bounding sphere

struct Scene 0x2343b0b                                          # the scene: the one large object of a match, built by game_loadAllData
8          4          i32 network                                # (by use) 1: a network game (3: (unclear) another mode, no team marks) (JOIN, RECORD and TEAM in the menu; the ranking shows each player's own flag, from flagGlTexture)
0x74       4          u8 view[4]                                 # the camera's view volume object starts here (passed by address)
0x38       4          float fps                                  # frames per second, shown by hud_drawFps
0x16c517c  0x5c300    ActorInfo actorInfo[32]                    # (count unclear)
0x179d1f6  0x47fd20   FlagSlot flags[16]
0x1eca030  0x100      i32 snapshotTex[64]                        # texture id of each actor type's snapshot (< 0: not loaded; count unclear)
0xbc06a8   4          i32 hudBarTexture                          # texture id of the counters' plate and weapon slots
0xbc06ac   4          i32 markerTexture                          # texture id of the solo / team marks over players
0xbc06b0   4          i32 emblemTexture                          # texture id (manager * 512 + slot): emblems, 10 a row from texel 224
0xbc06b4   4          i32 menuBoxTexture                         # texture id of the menu box cells
0xbe16f8   4          i32 fogOn                                  # 1: the screen is cleared to the fog colour
0xbe16fc   0xc        u32 fogColour[3]                           # r, g, b (floats, passed on unchanged)
0xbe170c   4          i32 fogInOverlay                           # 1: the stage's fog volume is drawn in the 2D pass
0xbe1710   0x10       u8 fogVolume[0x10]
0xbe1720   0xc        u32 fogVolumeArgs[3]                       # (floats, passed on unchanged)
0x9ee048   0x10       u32 glFogColour[4]                         # the fog OpenGL draws with (hud_472900): r, g, b, a (floats, kept as bits)
0x9ee058   4          u32 glFogStart                             # (floats, kept as bits)
0x9ee05c   4          u32 glFogEnd
0x9ee060   4          u32 glFogDensity
0xa08      4          float cullMargin                           # (by use) added to an object's radius when testing it against the camera box
0x131ae44  0xaece0    MapObject objects[1000]
0x13c9b24  4          i32 objectCount
0x20f3970  0xc        float cameraPos[3]                         # (by use) the centre of the camera box objects are tested against
0x1f1664   4          i32 objectsMode                            # (unclear) render_drawObjects' mode
0xbc06a0   4          i32 hudTexture                             # texture id of the HUD marks (lock-on boxes)
0x1ecca70  0x88880    Player players[16]
0x2222148  0x40       float lockTimers[16]                       # per player: the lock-on building up (> 0)
0x2221fa0  4          i32 cockpitPlayer                          # (unclear) no snapshot panel while it is the viewed player
0x2221fb8  0x10       i32 teamScores[4]                          # by team slot (this_get_0x2342381_463780 gives a team's slot)
0x22e7068  0x94       u8 modelview[0x94]                         # (unclear) matrices captured for the overlay parts
0x22e70fc  0x84       u8 projection[0x84]
0x22f0408  4          i32 elapsed                                # the match's time in seconds
0x22f040c  4          float timeFraction                         # (unclear) a 0..1 time value: render_drawObjects' float; the clock blinks red by it
0x22f06a8  4          u32 flagGlTexture                          # GL texture of the flags, used while network
0x22f86ac  4          i32 flagTexture                            # texture id of the flags (4 a row)
0x22e7180  4          i32 gameMode                               # index into g_gameModeNames
0x22e7184  4          i32 teamGame                               # 1: teams
0x22e719c  4          i32 markersOff                             # (unclear) no team mate arrows or leader marks
0x22e71a0  4          i32 leaderMarkOff                          # (unclear) the team mark replaces the leader mark / rank
0x22fbbd8  0x4200     char msgText[0x40][0x108]                  # message texts: four lines of 0x41 bytes per block
0x233c318  0x280      MessageSlot msgRing[32]                    # messages waiting to be shown (ring of 32)
0x233c598  4          u32 msgWrite                               # next slot msgRing gets written to
0x233c59c  4          u32 msgRead                                # next slot replay_drawMessage shows
0x233c9d0  4          i32 viewMode                               # 0 normal; 1 no overlay parts; 2 depth cleared again
0x233c9e8  4          i32 frameFlag                              # (unclear) 1: state 2 presents its own frame
0x233c9f8  4          i32 crosshairTexture
0x233c9fc  4          i32 playing                                # 1: the local player plays; 0: watching watchedPlayer
0x233c9f0  4          i32 showEmblems                            # 1: emblems in the ranking
0x233cc10  4          i32 cameraMode
0x233cc20  4          i32 inputState                             # the match's state: 1 loading, 2 playing, 3 free camera, 4 replay
0x233cc34  4          float chatBlink                            # cursor blink clock of the chat line
0x233cc4c  4          float startTimer                           # > 0: "start" shown
0x233cc40  4          float msgFade                              # message box fade, seconds (1 or more: opaque)
0x2340c64  4          i32 watchedPlayer                          # the player a spectator watches
0x2340ce4  4          i32 hudHidden                              # 1: no HUD at all
0x2340ce8  4          i32 messagesHidden
0x2340cec  4          i32 consoleOpen                            # (by use) 1: the full-screen text list (hud_4955a0)
0x2340c9c  4          float escTimer                             # time the in-match menu has been open (fades in over 0.25 s)
0x2340cf4  4          i32 escMenuOpen
0x2340cf8  4          i32 escPage                                # 0 main, 1 team, 2 file name, 3 retry?, 4 quit?
0x2340cfc  4          i32 escCursor                              # the item under the cursor
0x2340d04  4          i32 rankingShown
0x2340d0c  0x11       char recordName[0x11]                      # the replay being recorded ("AutoPlay\%s")
0x2340d1d  4          i32 recording                              # 1: the record mark is shown
0x2340d29  4          float recordTime                           # seconds recorded
0x2340d35  4          i32 chatMode                               # 0 closed, 1 / 2 typing (team / all)
0x2342399  4          i32 matchOver                              # (by use) 1: the result is shown
0x23423a9  4          i32 stageCleared                           # (unclear) 0 with g_missionStage == g_missionProgress: "MISSION FAILED, RETRY"
0x23423ad  4          i32 scoreLimit                             # > 0: the points still needed are shown
0x23423b1  4          i32 timeLimit                              # minutes; > 0: the time left is shown
0x23423bd  4          i32 winnerTeam
0x23423a1  4          i32 roundOver                              # (unclear)
0x234240d  4          i32 localPlayer                            # the player at this machine (index into players)
0x234243e  4          i32 respawnPlayer                          # (unclear) >= 0 lets "press fire" show
0x23424f2  4          i32 cameraSlot                             # the spectator camera's number (0 shows as 10)
0x23428f6  0x40       i32 ranking[16]                            # players in rank order
0x2342936  0x40       i32 rank[16]                               # each player's place (1: first; the HUD shows rank/rankCount)
0x2342976  4          i32 rankCount
0x234297e  4          i32 counterRed                             # (unclear) three counts shown under the team box
0x2342982  4          i32 counterBlue
0x2342986  4          i32 counterGreen
0x2342f02  4          float readyTimer                           # > 0: "ready" shown
0x2342f06  0x40       char readyText[0x40]                       # shown while no countdown runs
0x234334b  0x780      char consoleLines[30][0x40]                # the full-screen text list (hud_4955a0)
0x234328f  4          i32 rankingKey                             # 1: the ranking key is held
0x23429ce  0x528      EventLine events[5]                        # the last five events (ring of 5)
0x2342ef6  4          u32 eventCount                             # events written so far
0x2342efa  4          u32 eventFirst                             # first event still shown
