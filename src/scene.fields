struct GameSettings 0x30                                         # a game's settings record (g_playerName: the arena's / axis.cfg's, g_roomRecName: the
                                                                 # registry's, g_roomSettingsName: the room form's, g_newArenaName: the new arena form's)
0          0x20       char name[32]
0x20       1          signed char map
0x21       1          signed char players
0x22       1          signed char kind                           # the room: custom rules (the map shown as CUSTOM); the arena: the kind of game
0x23       1          signed char mode
0x24       2          u8 limit[2]                                # frag, time
0x26       8          char password[8]
0x2e       1          u8 locked                                  # the password is not empty (settings_store)

struct RankedPlayer 0x3e                                         # a player of the ranking list as the game server sends it (62 bytes: g_serverReply;
                                                                 # kept in g_netPlayerList, eleven of them, by net_addPlayerRecord)
0          0x1e       char name[30]
0x1e       4          i32 kind                                   # the reply's kind: 0 a player (added), 1 refused
0x22       4          i32 value22                               # not shown, only copied to RankRow.value2a; DServer (axis_server.py) sends it as its account's 'a' (1)
0x26       4          i32 kills                                  # the columns of the ranking table (RankRow)
0x2a       4          i32 deaths
0x2e       4          i32 exp
0x32       4          i32 level                                  # its grade (the rank badge)
0x36       4          float power
0x3a       4          float rate

struct RankRow 0x44                                              # a row of the ranking table (g_roomListRows, ten: roomList_fillPage from g_netPlayerList)
4          4          i32 rank                                   # its place (the row before's when its sorted value is the same)
8          0x1e       char name[30]                              # (empty: past the list's end)
0x26       4          i32 exp                                    # (sort 2)
0x2a       4          i32 value2a                               # RankedPlayer.value22 (not shown); written, never read
0x2e       4          i32 kills                                  # (sort 1)
0x32       4          i32 deaths
0x36       4          float rate                                 # (sort 3)
0x3a       4          i32 level                                  # the rank badge (1 when the row is cleared)
0x3e       4          float power                                # (sort 0; not cleared with the rest)

struct PilotProfile 0x4c                                         # a pilot level's profile (g_profileRecords: the character profile data file's records,
                                                                 # 103 of them, indexed by a player's level; the table overlaps g_netSlots)
0          0x10       char name[16]
0x10       0x10       char title[16]
0x20       4          i32 rank                                   # its class (a MSG(545) string)
0x24       4          i32 level
0x28       0x24       i32 stats[9]                               # percentages: [0] .. [3] the weapon groups' damage, [4] .. the skills (actor and
                                                                 # ARM CENTER factors x 0.01), [5] the legs'; [7] at most 50, the others 30

struct PilotStats 0x20                                          # a pilot's standing (g_pilotLevel .., kept as g_pilotLevelKept ..: lobby_states.c take_back)
0          4          i32 level
4          4          i32 points
8          4          i32 rank                                  # its place in the ranking (message 29's reply +0x16; 0 out of the first 1000: the account panel shows OUT OF RANK(1000))
0xc        4          i32 rating
0x10       4          i32 score
0x14       4          i32 wins
0x18       4          i32 losses
0x1c       4          float winRate

struct SkirmishInfo 0x5c                                        # a skirmish map's play settings (g_skirmishInfo, 15 of them: read by files.c)
0x4c       4          i32 gameMode                               # (by use) taken for the match (menu_records.c)
0x50       4          i32 timeLimit
0x54       4          i32 fragLimit

struct ViewQuad 0x5c                                            # a queued quad or billboard (ViewVolume.quads; view_volume.c quad_fields)
0          4          i32 texture                                # (none: negative; then no texture corners)
4          8          u32 uv0[2]                                # written, never read
0xc        8          u32 uv1[2]                                # written, never read
0x14       4          u32 colour
0x18       0x40       float points[4][4]                         # its corners in clip space
0x58       4          i32 kind                                   # 2 / 3: depth-sorted into quadOrderA / B

struct ViewTriangle 0x60                                        # a queued clipped triangle (ViewVolume.triangles)
0x28       0x30       float points[3][4]                         # (by use) its corners in clip space
0x58       4          u32 matrix                                 # the matrix it is drawn under (kind 1)
0x5c       4          i32 kind                                   # 2: depth-sorted (triangleOrder)

struct ViewVolume 0x9170                                        # the view volume: what a frame draws, queued by material and depth (view_volume.c, factors.c; the size is unknown: only the fields used)
4          4          i32 blockSize                              # (by use) its lists' memory (factor_initBy)
8          4          u8 *block
0xc        4          i32 ownsBlock                              # 1: allocated here (freed with it)
0x14       0xc        void *glArrays[3]                          # (by use) the GL vertex / colour / texture-coordinate array entry points (wglGetProcAddress; none: the GL 1.1 ones)
0x10       4          i32 entryPointsSet                        # (by use) set once its three GL entry points are looked up (+0x14 .. +0x1c); written, never read
0x20       0x3000     i32 materialOrder[3072]                   # the materials in the order first queued (materialCount of them)
0x3024     4          i32 materialCount
0x3028     0x3004     u8 *materialHeads[3073]                    # per material: its first queued entry (0: none yet)
0x602c     0x3004     u8 *materialTails[3073]                    # its last (entries are linked on from it)
0x9030     4          i32 entryLimit                            # the queued parts (0x1c bytes each)
0x9034     4          u8 *entries
0x9038     4          i32 entryCount
0x903c     4          i32 matrixLimit                           # the parts' matrices (0x40 bytes each)
0x9040     4          u8 *matrices
0x9044     4          i32 matrixCount
0x9048     4          i32 colourLimit                           # the colour buffer: room for so many vertices
0x904c     4          u8 *colours
0x9050     4          i32 colourMost                            # the most vertices it held so far
0x9054     4          i32 triangleLimit                         # the clipped triangles (0x60 bytes each)
0x9058     4          u8 *triangles
0x905c     4          i32 triangleCount
0x9060     4          u8 *triangleOrder                         # (record, depth) pairs sorted back to front
0x9064     4          i32 triangleOrderCount
0x9068     4          i32 quadLimit                             # the quads and billboards (0x5c bytes each)
0x906c     4          u8 *quads
0x9070     4          i32 quadCount
0x9074     4          u8 *quadOrderA                            # sorted quads of kind 2
0x9078     4          i32 quadOrderACount
0x907c     4          u8 *quadOrderB                            # ... of kind 3
0x9080     4          i32 quadOrderBCount
0x9084     4          i32 segmentLimit                          # the objects' segments (0x24 bytes each); written, never read
0x9088     4          u8 *segments
0x908c     4          i32 segmentCount
0x9090     4          i32 entriesFull                           # 1: a list overflowed (what did not fit is left out)
0x9094     4          i32 matricesFull
0x9098     4          i32 trianglesFull
0x909c     4          i32 quadsFull
0x90a0     4          i32 segmentsFull
0x90a4     4          i32 trianglesDrawn                        # counters of the frame
0x90a8     4          i32 meshesDrawn
0x90ac     4          i32 textureBinds
0x90b0     0x40       float projection[16]
0x90f0     0x40       float modelview[16]
0x9130     0x40       float clip[16]                            # projection x modelview: points to clip space

struct Skeleton 0x24                                            # a skeleton (skel_data.c): its 0x24-byte header and the block its bones and their tables are in
4          4          i32 blockSize
8          4          u8 *block                                 # its bones (from the start) and their key tables
0xc        4          i32 ownsBlock                             # 1: allocated here (freed with it)
0x10       4          i32 boneCount
0x14       4          u8 *bones                                 # boneCount Bone records
0x18       4          i32 posKeyTotal                            # (by use) the ASE file's position keys counted (the block's size: skel_loadAseFrom)
0x1c       4          i32 rotKeyTotal                            # its rotation keys
0x20       4          i32 frames                                # its animation's frames

struct Bone 0x70                                                # a skeleton's bone (Skeleton.bones)
0x40       4          i32 parent                                # its parent bone (< 0: the root)
0x44       0xc        float pos[3]                              # its position without keys
0x50       0x10       float rotation[4]                          # its rotation without keys: angle, then axis
0x60       4          i32 posKeyCount                           # position keys, 0x20 bytes each: frame, length, base, delta
0x64       4          u8 *posKeys
0x68       4          i32 rotKeyCount                           # rotation keys, 0x28 bytes each: frame, length, base angle + axis, delta angle + axis
0x6c       4          u8 *rotKeys

struct PosKey 0x20                                              # a bone's position key (Bone.posKeys)
0          4          i32 frame                                  # the frame it starts at
4          4          i32 length                                 # frames to the next key (0: the last)
8          0xc        float pos[3]
0x14       0xc        float delta[3]                             # to the next key's position

struct RotKey 0x28                                              # a bone's rotation key (Bone.rotKeys)
0          4          i32 frame
4          4          i32 length
8          0x10       float rotation[4]                          # its rotation: angle, then axis (from the ASE, combined with the ones before)
0x18       0x10       float step[4]                              # the rotation to the next key (angle, axis)

struct Manager 0x24c                                            # a shape manager (skel_data.c; a skeleton manager is its first 0x130 bytes: SkelManager): items loaded by name into one block, found through a name tree
4          4          i32 blockSize
8          4          u8 *block                                 # the name nodes, then the items, then the data memory
0xc        4          i32 ownsBlock                             # 1: allocated here
0x10       0x100      char dir[0x100]                           # where the items' files are
0x110      4          u32 source                                # where its items load from: 0 / 1 loose files with the first / second extension, 2 the packed data file (the skeleton sets)
0x114      4          i32 capacity                              # items it has room for
0x118      4          u8 *nodes                                 # the name tree: one 0x4c-byte TreeNode per item
0x11c      4          u8 *items                                 # the items (skeletons 0x24 bytes, shapes 0x4c)
0x120      4          i32 count                                 # items loaded
0x124      4          i32 dataSize                              # the data memory items are read into
0x128      4          u8 *data
0x12c      4          i32 dataUsed
0x130      0x100      char textureDir[0x100]                    # (shapes) the textures' place, given with bindArgs to shape_bindTextureBy
0x230      4          u32 bindFlags                              # (shapes) given to shape_bindTextureBy with the tint; bit 1: tinted (shape_setTint)
0x234      0x18       u32 tint[6]                                # two hue / chroma / value triples (floats' bits)

struct SkelManager 0x130                                        # a skeleton manager (skel_data.c: skelSet_setup): Manager's first 0x130 bytes, without the textures and tint
4          4          i32 blockSize
8          4          u8 *block                                 # the name nodes, then the items, then the data memory
0xc        4          i32 ownsBlock                             # 1: allocated here
0x10       0x100      char dir[0x100]                           # where the items' files are
0x110      4          u32 source                                # where its items load from: 0 / 1 loose files with the first / second extension, 2 the packed data file (the skeleton sets)
0x114      4          i32 capacity                              # items it has room for
0x118      4          u8 *nodes                                 # the name tree: one 0x4c-byte TreeNode per item
0x11c      4          u8 *items                                 # the items (skeletons 0x24 bytes, shapes 0x4c)
0x120      4          i32 count                                 # items loaded
0x124      4          i32 dataSize                              # the data memory items are read into
0x128      4          u8 *data
0x12c      4          i32 dataUsed
struct PlayerRecord 0x47fd2                                      # a player of the match (Scene / Stage playerRecords): its team, mech parts and items; its actor points back (Player.player)
0          4          i32 used                                   # (by use) 1: in use (playerRecord_markUsed / markFree)
0x479a4    0xa        u8 partHue[5][2]                           # (by use) per part its two tints' hue (actor_setPartColor; bytes)
0x479ae    0xa        u8 partSaturation[5][2]
0x479b8    0xa        u8 partValue[5][2]
0x479c2    0x600      u32 flag[16][24]                         # (by use) its flag: 24 x 16 RGBA (the pilot's own picture, Save\<name>.BMP; drawn after its name and in the ranking)
0x47fca    4          i32 flagChanged                          # 1: to be copied into the flag atlas (flagShown: it is there)
0x47fce    4          i32 flagSent                             # (by use) its flag's pixels sent so far (0x180 = 24 x 16: all; the map's players start with all)
4          0x40       char name[0x40]                            # (by use) its name (its screenshot: Save\\<name>.BMP)
0x44       4          i32 level                                  # (by use) its level (the profile's factors by it)
0x48       4          i32 team
0x4c       0x140      char partNames[5][0x40]                    # its parts' type names (head, chest, arms, legs, booster: set_part)
0x18c      0x180      char itemNames[6][0x40]                    # its items' names (actor_setItem: the ActorInfo's name)
0x30c      0x14       i32 parts[5]                               # its mech's parts: head, chest, arms, legs, booster (records of the stage's part tables; "invalid headIndex")
0x320      0x18       i32 items[6]                              # per item slot (Player.slot): its weapon's record (index into Scene.actorInfo; < 0 none)
0x338      0x24c      Manager headShapes                     # (by use) its head type's shapes (model_sets: shape_initBy over the data after it)
0x584      0x7d00     u8 headShapeData[0x7d00]
0x8284     0x24c      Manager chestShapes                    # (by use) its chest type's shapes (model_sets: shape_initBy over the data after it)
0x84d0     0x7d00     u8 chestShapeData[0x7d00]
0x101d0    0x24c      Manager armShapes                      # (by use) its arm type's shapes (model_sets: shape_initBy over the data after it)
0x1041c    0xfa00     u8 armShapeData[0xfa00]
0x1fe1c    0x24c      Manager legShapes                      # (by use) its leg type's shapes (model_sets: shape_initBy over the data after it)
0x20068    0xfa00     u8 legShapeData[0xfa00]
0x2fa68    0x24c      Manager boosterShapes                  # (by use) its booster type's shapes (model_sets: shape_initBy over the data after it)
0x2fcb4    0x13880    u8 boosterShapeData[0x13880]
0x43534    0x130      SkelManager headSkels                 # its skeletons (skelSet_setup over the data after it)
0x43664    0x7d0      u8 headSkelData[0x7d0]
0x43e34    0x130      SkelManager chestSkels                # its skeletons (skelSet_setup over the data after it)
0x43f64    0x7d0      u8 chestSkelData[0x7d0]
0x44734    0x130      SkelManager armSkels                  # its skeletons (skelSet_setup over the data after it)
0x44864    0xfa0      u8 armSkelData[0xfa0]
0x45804    0x130      SkelManager legSkels                  # its skeletons (skelSet_setup over the data after it)
0x45934    0xfa0      u8 legSkelData[0xfa0]
0x468d4    0x130      SkelManager boosterSkels              # its skeletons (skelSet_setup over the data after it)
0x46a04    0xfa0      u8 boosterSkelData[0xfa0]
0x47fc6    4          i32 flagShown                             # 1: its flag is shown (ranking, markers)

struct TreeNode 0x4c                                            # a manager's name tree node: by strcmp, smaller left
0          0x40       char name[0x40]
0x40       4          i32 index                                 # its item's index
0x44       4          u8 *left
0x48       4          u8 *right

struct TexRecord 0x68                                           # a texture bank's material: a texture by name, its flags and colours (tex_allocIdBy)
0          0x40       char name[0x40]                            # upper-cased
0x40       4          i32 slot                                   # (by use) its slot in the GL texture cache (TextureBank.slots; -1: not cached)
0x44       4          u32 flags
0x48       0x18       float colours[6]                          # two hue / saturation / value sets
0x60       4          i32 animation                              # (by use) the name's suffix: "_ANI" 1, "_ANI0" .. "_ANI3" 1 .. 4, else 0; written, never read
0x64       4          i32 changed                                # 1: recoloured (tex_recolourMaterial; its image made again)

struct TexSlot 0x14                                             # a slot of a texture bank's GL texture cache (names.c tex_bind)
0          4          i32 index                                  # its own index
4          4          i32 record                                 # the record (texture) in it
8          4          u32 glTexture                              # its GL texture id
0xc        4          u8 *next                                   # the ring: the next slot (from the oldest on)
0x10       4          u8 *prev

struct TextureBank 0xcd144                                   # a texture bank (the game's class Texture, one per image size; names.c; TextureManager.banks): up to 512 materials and their GL texture slots
4          4          i32 ready                                 # 1: set up (tex_initBy)
8          0x100      char dir[0x100]
0x108      4          i32 indexCount                            # the image file's name index: indexCount entries of 0x44 bytes
0x10c      4          u8 *index
0x110      4          void *file                                # the image file (Data\ImageN.dat; format 0)
0x114      0x40000    u8 image[0x40000]                          # (by use) the texture being loaded: RGBA, width x height (tex_loadColorMask)
0x40114    0x40000    u8 alphaImage[0x40000]                     # its _ALPHA image (the grey becomes the image's alpha)
0x80114    0x40000    u8 colourMask[0x40000]                     # its _COLOR mask (none: all g_colourMaskRed)
0xc0114    4          i32 format
0xc0118    4          i32 width                                 # its images' size
0xc011c    4          i32 height
0xc0120    4          i32 mipmaps
0xc0124    4          i32 linear
0xc0128    0xd000     TexRecord records[512]
0xcd128    4          i32 recordCount
0xcd12c    4          u8 *slots                                  # the GL texture cache: TexSlot records (0x14 bytes), a ring
0xcd130    4          i32 slotCount                             # at most 0x200
0xcd134    4          u8 *oldest                                # the slot to reuse next
0xcd138    4          i32 loadCount                              # (by use) textures loaded into the cache (tex_bind)
0xcd13c    4          i32 counterB                              # written, never read
0xcd140    4          i32 counterC                              # written, never read

struct GroundLayer 0x20c                                        # a layer of the ground (Stage.groundLayers; map_info.c, shading.c): a height grid read from the map, drawn as strips
0          4          i32 kind                                   # (by use) 0, 1, 2: its draw records' first word 0, 8, 6 (stage_buildMeshDrawRecords)
4          0xc        float origin[3]
0x1c       4          i32 rows
0x20       4          i32 cols                                  # (rows + 1) x (cols + 1) points
0x24       4          float cellSize
0x28       4          float heightScale
0x2c       4          float texScale                            # texture coordinates: x / texScale, z / texScale
0x30       4          i32 lit                                   # 1: lit (its normals take the lights: ground_computeLighting; 4 primitives a cell)
0x34       4          u32 texture                               # its Ground<n>Map texture
0x38       4          u8 *heights                               # one byte a point (the map image's grey)
0x3c       4          u8 *flat                                  # one byte a cell: all four corners present
0x40       4          float *points                             # 3 floats a point
0x44       4          float *normals
0x48       4          u32 *colours                              # RGBA a point (light_computeLayerLightBy)
0x50       4          float *uv
0x54       4          i32 indexCapacity                         # the strips' index heap
0x58       4          u32 *indices
0x5c       4          i32 indexCount
0x60       4          i32 stripCapacity
0x64       4          u8 *strips
0x68       4          i32 stripCount
0x6c       0x90       float boxPoints[12][3]                     # (by use) its box's draw part (Stage.layerBoxModel): 12 points
0xfc       0x30       u32 boxColours[12]
0x12c      0x60       float boxUv[12][2]
0x18c      0x50       i32 boxIndices[4][5]                       # its box's four side faces, a five-point fan each (stage_buildMeshDrawRecords)
0x1dc      0x30       ShapePrim boxPrims[4]                      # the four fans (drawn only when lit)

struct WayPoint 0x14                                            # a way point (Trigger.wayPoints): a place on the trigger's path, with the actor commands run there (map_info.c, script_processCommandBy)
0          0xc        float pos[3]                               # (by use) where it is (a trigger's first one: the player within its radius fires it; bots walk the path)
0xc        4          i32 commandCount
0x10       4          u8 *commands                               # 0x30-byte commands (Stage.commands): an opcode and its arguments

struct Trigger 0x1c                                             # a trigger (Stage.triggers): its path of way points, what fires it
0          4          i32 wayPointCount
4          4          u8 *wayPoints                              # WayPoint records (0x14 bytes)
8          4          i32 armed                                  # (by use) 1: it can fire (commands 0 / 1 arm and disarm it)
0xc        4          u32 flags                                  # 1: on its time; 2: on the player within its radius
0x10       4          float time                                 # the match clock it fires at (flag 1)
0x14       4          float radiusSq                             # read as a radius: squared and scaled at load (flag 2)
0x18       4          i32 fired                                  # 1: fires this frame (its first way point's commands run; then disarmed)

struct StartPoint 0x14                                          # a multiplayer start (Stage.starts)
0          0xc        float pos[3]
0xc        0x8        float angle[2]

struct MapPlayer 0x58                                           # a player as the map's actor file gives it (Stage.mapPlayers; playerRecord_setFromMapPlayer)
4          4          i32 value                                  # (by use) player_setLevel's value; in the map file 1-based, the colour preset for its parts (map_loadActorInfoFrom)
8          0x20       char name[0x20]
0x28       4          i32 team
0x2c       0x14       i32 parts[5]                               # head, chest, arms, legs, booster
0x40       0x18       i32 items[6]                               # per item slot (-1: none)

struct SpawnRecord 0x5c                                         # an actor's spawn record (the map's actors, Stage.mapActors; actor_applySpawnRecord)
0          4          i32 player                                 # its player record
4          0xc        float pos[3]
0x10       4          float pitch
0x14       4          float yaw
0x18       4          i32 bot                                    # (by use) 1: run by the game (the map's actors but the first)
0x1c       4          u32 unused1c                              # copied with the spawn record (+0x1c to the actor's +0x64; 100 for a player's mech); not read
0x20       4          i32 armor                                  # the armour and shield it starts with (and their maximum)
0x24       4          i32 shield
0x28       4          float speed                                # x 27.7778: the actor's speed and top speed
0x2c       4          float turnRate                            # x 10: the actor's turnRate
0x30       4          float range                                # its sight range (squared, x 10000: radiusSq)
0x34       4          u32 unused34                              # copied with the spawn record (+0x34 to the actor's +0x70; 3.0 for a player's mech); not read
0x38       4          float aimError                            # the bots' aim wanders by +- this about pitch and yaw (actor_processFrame); the spawn record's +0x38 x 10, whole
0x3c       4          u32 scriptFlag                            # copied with the spawn record (+0x3c to the actor's +0x78); set 0 / 1 by trigger commands 10 / 11; not read
0x40       4          float dodgeSpread                          # x 100
0x44       4          float climbSpread                          # x 100
0x48       0x14       float botTimes[5]                          # the bot's timings (copied to the actor's)

