struct TreeNode 0x4c                                            # a manager's name tree node: by strcmp, smaller left
0          0x40       char name[0x40]                                 # its item's name, upper-cased (path_normalize), the key strcmp compares (tree_lookup); also the name item_path builds a loose file's path from
0x40       4          i32 index                                 # its item's index
0x44       4          u8 *left                                        # the node with a smaller name (strcmp < 0; 0: none) (tree_lookup links a new node here)
0x48       4          u8 *right                                       # the node with a greater name (0: none) (tree_lookup)

struct TexRecord 0x68                                           # a texture bank's material: a texture by name, its flags and colours (tex_getIdBy)
0          0x40       char name[0x40]                            # upper-cased with '/' as backslash: tex_getIdBy normalises it (path_normalize) before texRecord_init copies it as given
0x40       4          i32 slot                                  # its slot in the GL texture cache (TextureBank.slots; -1: not cached; tex_bind)
0x44       4          u32 flags                                 # 1: clamped at the edges, else repeated (tex_bind: tex_upload's mode; match_start gives it to effectTextures past 7); 2: tinted with colours through its _COLOR mask (tex_applyTintMask; set by tex_setMaterialTint; the player parts' textures, shape_setTextureSuffix); tex_markMaterialChanged keeps the bits 0x11111113
0x48       0x18       float colours[6]                          # two hue / saturation / value sets
0x60       4          i32 scrollMode                            # its texture coordinates' scrolling by the name's suffix: "_ANI" / "_ANI0" 1, "_ANI1" 2, "_ANI2" 3, "_ANI3" 4 (another "_ANI<c>": left as it was), else 0; ViewVolume_draw shifts them: 1 v +, 2 u +, 3 v -, 4 u - (view_volume.c tex_scroll)
0x64       4          i32 changed                               # 1: its image to be loaded again at its next tex_bind (set by tex_setMaterialTint when a tint differs and by tex_markMaterialChanged; tex_bind reloads and clears it; texRecord_init 0)

struct TexSlot 0x14                                             # a slot of a texture bank's GL texture cache (textures.c tex_bind)
0          4          i32 index                                  # its own index
4          4          i32 record                                 # the record (texture) in it
8          4          u32 glTexture                              # its GL texture id
0xc        4          u8 *next                                   # the ring: the next slot (from the oldest on)
0x10       4          u8 *prev                                        # the ring: the previous slot (tex_initBy); tex_bind unlinks a reused slot and puts it back just before the oldest (the newest)

struct TextureBank 0xcd144                                   # a texture bank (the game's class Texture, one per image size; textures.c; TextureManager.banks): up to 512 materials and their GL texture slots
4          4          i32 ready                                 # 1: set up (tex_initBy)
8          0x100      char dir[0x100]                                 # the folder its files are looked for under (tex_initBy, upper-cased; "." gives empty: none): "<dir>\Data\Image<n>.dat", "<dir>\<name>" (tex_path, tex_textureFileExist); every caller passes "."
0x108      4          i32 indexCount                            # the image file's name index: indexCount entries of 0x44 bytes
0x10c      4          u8 *index                                       # the image dat's name index (tex_initBy: indexCount sorted 0x44-byte entries, a 0x40-byte name and the item's file offset; 0 for formats 1 / 2): binary searched by tex_findByName, the offset used by tex_getItemFileBy; freed by Texture_dtor
0x110      4          void *file                                # the image file (Data\ImageN.dat; format 0)
0x114      0x40000    u8 image[0x40000]                         # the texture being loaded: RGBA, width x height (tex_loadImage; tex_upload)
0x40114    0x40000    u8 alphaImage[0x40000]                     # its _ALPHA image (the grey becomes the image's alpha)
0x80114    0x40000    u8 colourMask[0x40000]                     # its _COLOR mask (none: all g_packedRed)
0xc0114    4          i32 format                                      # where images come from: 0 the Data\Image<n>.dat items (PTX), 1 .BMP files, 2 .RAW files (tex_textureFileExist, tex_loadImage; above 2 a fatal message); every caller of tex_initBy passes 0
0xc0118    4          i32 width                                 # its images' size
0xc011c    4          i32 height                                      # (see width) 64, 128 or 256 (tex_initBy); checked by TextureManager_setBanks and against each image loaded (size_check, tex_textureFileExist); tex_upload's size
0xc0120    4          i32 mipmaps                                     # 1: tex_upload builds mipmaps (gluBuild2DMipmaps) and uses a mipmapped minifying filter; from g_cfgMipmaps (tex_initBy)
0xc0124    4          i32 linear                                      # 1: tex_upload filters linearly (GL_LINEAR), else GL_NEAREST; from g_cfgLinearFilter (tex_initBy)
0xc0128    0xd000     TexRecord records[512]                          # its materials, recordCount used: added by tex_getIdBy (texRecord_init), bound by tex_bind; a texture id is the bank x 512 + the record (view_volume.c tex_scroll)
0xcd128    4          i32 recordCount                                 # records used: 0 at tex_initBy, +1 per new material in tex_getIdBy (512: a fatal message; a new one is bound at once while below slotCount)
0xcd12c    4          u8 *slots                                  # the GL texture cache: TexSlot records (0x14 bytes), a ring
0xcd130    4          i32 slotCount                             # at most 0x200
0xcd134    4          u8 *oldest                                # the slot to reuse next
0xcd138    4          i32 loadCount                             # textures loaded into the cache (tex_bind); cleared by tex_initBy / tex_clearSetCounters; written, never read
0xcd13c    4          i32 clearedCd13c                              # only cleared (tex_initBy, tex_clearSetCounters with loadCount); never read
0xcd140    4          i32 clearedCd140                              # only cleared (tex_initBy, tex_clearSetCounters with loadCount); never read

struct GroundLayer 0x20c                                        # a layer of the ground (Stage.groundLayers; map_info.c, shading.c): a height grid read from the map, drawn as strips
0          4          i32 kind                                  # 0 a floor, 1 a ceiling (normals flipped, front faces culled, its water lit from below), 2 neither: not collided, unlit, both sides drawn; its draw parts' flags 0, 8, 6 (ground_buildLayerModels)
4          0xc        float origin[3]                                 # its grid's corner: point (r, c) is origin + (c x cellSize, height x heightScale, r x cellSize) (map_loadGroundInfoFrom); ground_buildDrawLists culls cells by it and puts the water surface at its height [1]
0x1c       4          i32 rows                                        # rows of cells (see cols): from the map's ground file (map_loadGroundInfoFrom); sizes its points, the strips' heaps, drawing (ground_buildDrawLists) and its collision triangles (collision_tris.c)
0x20       4          i32 cols                                  # (rows + 1) x (cols + 1) points
0x24       4          float cellSize                                  # a cell's side in x and z (map_loadGroundInfoFrom: points c x cellSize, r x cellSize from origin); ground_buildDrawLists finds the cells in view range by it
0x28       4          float heightScale                               # a point's height: its map image grey (0 .. 255) x heightScale, + origin[1] (map_loadGroundInfoFrom); not read elsewhere
0x2c       4          float texScale                            # texture coordinates: x / texScale, z / texScale
0x30       4          i32 water                                 # 1: a water layer: a surface drawn around the camera (waterModel: waterPrims, waterColours lit from above, or for kind 1 from below)
0x34       4          u32 texture                               # its Ground<n>Map texture
0x38       4          u8 *heights                               # one byte a point (the map image's grey)
0x3c       4          u8 *drawnCells                            # one byte a cell: 1 when its four corners are all grey pixels of the map image (map_loadGroundInfoFrom); ground_buildDrawLists draws only those (bit 0); collision takes every cell
0x40       4          float *points                             # 3 floats a point
0x44       4          float *normals                                  # 3 floats a point: the four triangles' normals around it summed (edges straight up; negated for kind 1) (map_loadGroundInfoFrom); lit by light_computeLayerLightBy
0x48       4          u32 *colours                              # RGBA a point (light_computeLayerLightBy)
0x50       4          float *uv                                       # 2 floats a point: its x and z over texScale (map_loadGroundInfoFrom); the layer model part's texture coordinates (ground_buildLayerModels)
0x54       4          i32 indexCapacity                         # the strips' index heap
0x58       4          u32 *indices                                    # the strips' index heap, indexCapacity of them ((cols + 200) x rows x 2: map_loadGroundInfoFrom); filled each frame by ground_buildDrawLists (strip_pair)
0x5c       4          i32 indexCount                                  # indices used this frame (0 at ground_buildDrawLists' start, +2 per strip_pair; past indexCapacity a fatal message)
0x60       4          i32 stripCapacity                               # room for strips: rows x 200 + 4 (map_loadGroundInfoFrom); more is a fatal message (ground_buildDrawLists)
0x64       4          u8 *strips                                      # the strips (0x0c-byte prims: type 5, index count, indices) made each frame (ground_buildDrawLists); the layer model part's prims (ground_buildLayerModels)
0x68       4          i32 stripCount                                  # strips made this frame (ground_buildDrawLists; 0 at its start): the layer model part's primCount
0x6c       0x90       float waterPoints[12][3]                  # a water layer's surface around the camera, made each frame (ground_buildDrawLists): 0 .. 3 a square at the view range, 4 .. 11 a ring of eight at 1.5 x the far plane, at the layer's height
0xfc       0x30       u32 waterColours[12]                            # the water surface's 12 colours (RGBA): its light from straight above (below for kind 1), or all white for kind 2 (light_computeLayerLightBy); the water model part's colours (ground_buildLayerModels)
0x12c      0x60       float waterUv[12][2]                            # the water surface's 12 texture coordinates: x and z over texScale, made each frame (ground_buildDrawLists: water_point); the water model part's (ground_buildLayerModels)
0x18c      0x50       i32 waterIndices[4][5]                    # the surface's four five-point fans (ground_buildLayerModels)
0x1dc      0x30       ShapePrim waterPrims[4]                   # the four fans (Stage.waterModel's part has them only for a water layer)

struct WayPoint 0x14                                            # a way point (Trigger.wayPoints): a place on the trigger's path, with the actor commands run there (map_info.c, script_processCommandBy)
0          0xc        float pos[3]                              # where it is (a trigger's first one: the player within its radius fires it; bots walk the path: actor_pickPathPoint)
0xc        4          i32 commandCount                                # its commands (0x30 bytes each at commands), from the map file; map_loadWayPointInfoFrom checks their total against Stage.commandCount; script_processCommandBy runs that many
0x10       4          u8 *commands                               # 0x30-byte commands (Stage.commands): an opcode and its arguments

struct Trigger 0x1c                                             # a trigger (Stage.triggers): its path of way points, what fires it
0          4          i32 wayPointCount                               # its way points (a run of Stage.wayPoints at wayPoints; map_loadTriggerInfoFrom checks their total against Stage.wayPointCount); a bot's path ends past the last (actor_processFrame); actor_pickPathPoint scans them
4          4          u8 *wayPoints                              # WayPoint records (0x14 bytes)
8          4          i32 armed                                 # 1: it can fire (script_processTriggers; 0 after firing; commands 0 / 1 arm and disarm it; from the map file)
0xc        4          u32 flags                                  # 1: on its time; 2: on the player within its radius
0x10       4          float time                                 # the match clock it fires at (flag 1)
0x14       4          float radiusSq                             # read as a radius: squared and scaled at load (flag 2)
0x18       4          i32 fired                                 # 1: to fire (script_processTriggers sets it on its time / the player within its radius, for an armed one; script command 2 sets it for any trigger): script_processTriggers then runs its first way point's commands (script_processCommandBy entry 0), clears it and disarms it

struct StartPoint 0x14                                          # a multiplayer start (Stage.starts)
0          0xc        float pos[3]                                    # where it is (the play file's kind-1 record: map_loadPlayInfoFrom); a free one (spawn_point) is where local_spawn puts the local player and bot_spawns the bots
0xc        0x8        float angle[2]                                  # pitch and heading: the play file's two angles x 10 (map_loadPlayInfoFrom); local_spawn gives them to the local player's actor (bot_spawns takes only the position)

struct MapPlayer 0x58                                           # a player as the map's actor file gives it (Stage.mapPlayers; playerRecord_setFromMapPlayer)
4          4          i32 character                             # player_setCharacter's value; in the map file 1-based, the colour preset for its parts (map_loadActorInfoFrom)
8          0x20       char name[0x20]                                 # its name, given to player_setName for every map player but the first (playerRecord_setFromMapPlayer via map_loadActorInfoFrom)
0x28       4          i32 team                                        # its team, given to player_setTeam for every map player but the first (playerRecord_setFromMapPlayer via map_loadActorInfoFrom)
0x2c       0x14       i32 parts[5]                               # head, chest, arms, legs, booster
0x40       0x18       i32 items[6]                               # per item slot (-1: none)

struct SpawnRecord 0x5c                                         # an actor's spawn record (the map's actors, Stage.mapActors; actor_applySpawnRecord)
0          4          i32 player                                 # its player record
4          0xc        float pos[3]                                    # where it spawns (actor_applySpawnRecord, script command 15); bot_spawns puts a free start point's position (spawn_point; else mapStart) in a copy instead
0x10       4          float pitch                                     # the actor's starting pitch (actor_applySpawnRecord: via stage_setupActorSlot to actor_setupFromParts, Actor.pitch)
0x14       4          float yaw                                       # the actor's starting heading (actor_applySpawnRecord: via stage_setupActorSlot to actor_setupFromParts, Actor.yaw)
0x18       4          i32 bot                                   # 1: run by the game (the map's actors but the first; bot_spawns spawns these); copied to Actor.bot (actor_applySpawnRecord)
0x1c       4          u32 unused1c                              # copied to the actor's +0x64 (actor_applySpawnRecord; 100 for a player's mech, the maps' spawns 100, 1000 netsphere, 10 gigantic-core); never read
0x20       4          i32 armor                                  # the armour and shield it starts with (and their maximum)
0x24       4          i32 shield                                      # (see armor) its shield and shieldMax (actor_applySpawnRecord)
0x28       4          float speed                               # km/h: x 27.7778 (to cm/s) the actor's speed and baseSpeed (actor_applySpawnRecord)
0x2c       4          float turnRate                            # x 10: the actor's turnRate
0x30       4          float range                                # its detection range (squared, x 10000: the actor's detectionRangeSq)
0x34       4          float unused34                            # copied to the actor's +0x70 (actor_applySpawnRecord; 3.0 for a player's mech); never read
0x38       4          float aimError                            # the actor's aimError in degrees (actor_applySpawnRecord: x 10, whole, into Actor.aimError)
0x3c       4          u32 scriptFlag                            # copied to the actor's +0x78 (Actor.scriptFlag; actor_applySpawnRecord); not read
0x40       4          float dodgeSpread                          # x 100
0x44       4          float climbSpread                          # x 100
0x48       0x14       float botParams[5]                         # the bot's settings (copied to the actor's Actor.botParams: [2] a distance, the rest seconds)

struct BmpFile 0x48                                             # an uncompressed 24-bit .BMP read in pieces (class BMPRGBFile: classes.c)
0          4          u32 vtable                                      # the class's vtable (0x4a96f8): set by the users of a local one (playerRecord_loadFlag, tex_textureFileExist, tex_loadImage) and by BMPRGBFile_dtor; not otherwise read
4          4          void *file                                 # open (none: 0)
8          2          u16 type                                   # its BITMAPFILEHEADER ("BM")
0xa        4          u32 fileSize                              # written, never read
0x12       4          i32 dataOffset                             # where its pixels start
0x16       4          u32 infoSize                               # its BITMAPINFOHEADER
0x1a       4          i32 bmpWidth                                    # the BITMAPINFOHEADER's width, read with it (image_initBy, image_tryOpen); copied to width
0x1e       4          i32 bmpHeight                                   # the BITMAPINFOHEADER's height (image_initBy, image_tryOpen); copied to height
0x22       2          u16 planes                                      # the BITMAPINFOHEADER's planes, read with it (image_initBy, image_tryOpen); never read
0x24       2          u16 bitCount                               # 24 only
0x26       4          u32 compression                            # 0 only
0x3e       4          i32 width                                  # bmpWidth, bmpHeight kept
0x42       4          i32 height                                      # (see width) rows, stored bottom-up: image_copyTo clips by it and finds a row's offset from it; playerRecord_loadFlag wants 15 or more, tex_textureFileExist the bank's height

struct HeadType 0xaa8                                           # a head part type (Stage.headTypes; the ARM CENTER's head panel: armc_parts.c)
0x40       8          i32 shapeCount[2]                         # per detail level (Actor.lowDetail: [0] near, [1] far): the shapes (ObjectList_load's ns) ..
0x448      0x440      char shapeNames[2][0x220]                 # .. their names (0x44 apart: a name and its bone's translation scale, a float: ListedObject.scale)
0x888      8          i32 skelCount[2]                           # .. the skeletons ..
0x990      0x100      char skelNames[2][0x80]                    # .. and their names (0x40 apart)
0          0x40       char name[0x40]                           # its type name: the maker's folder and the part (MILLIA\HEAD ...: Component.dat); set_part copies it to PlayerRecord.partNames[0]; the ARM CENTER's head panel shows it with '\' and '/' as '-' (panel_name)
0xa90      4          float weight                                    # WEIGHT (message 606), tons: with the arms', legs' and booster's (the chest has none) and outside game types 2 .. 11 the items', the actor's load (mech_stats); the head panel's g_headWeight (armc_readPartPanels)
0xa94      4          float detectionRange                      # DETECTION RANGE (message 601), 1/100 m (the panel shows x 0.01 m): x the pilot character's skill factor (stats[7] x 0.01 + 1), + the item bonus rangeBonus, squared = the actor's detectionRangeSq (mech_stats)
0xa98      4          float detectionAngle                      # DETECTION ANGLE (message 602), tenths of a degree: x the pilot character's skill factor (stats[7] x 0.01 + 1) = the actor's detectionAngle (mech_stats)
0xa9c      4          i32 hackingLevel                                # HACKING LEVEL (message 603): + the item bonus hackingBonus = the actor's hackingLevel (mech_stats); a cloaked actor (stateFlags 0x200) is seen and targeted only by actors of a higher level (actor_processFrame, objects.c)
0xaa0      4          float lockOnTime                          # a factor on the weapon's lock-on time (x ActorItem.targetingTime x the item factor lockOnTimeFactor: the actor's lockOnTime, compared with aimTime in actor_processFrame); the panel's LOCK ON EFFICIENCY (message 604) is 100 / it, in %
0xaa4      4          float targetKeepTime                            # TARGET KEEPING TIME (message 605), seconds: x the item factor targetKeepFactor = the actor's targetKeepTime (mech_stats), how long a lock lasts once the aim leaves (actor_processFrame); the panel's x 1000

struct ChestType 0xabc                                          # a chest part type (Stage.chestTypes)
0x40       8          i32 shapeCount[2]                         # per detail level (Actor.lowDetail: [0] near, [1] far): the shapes (ObjectList_load's ns) ..
0x448      0x440      char shapeNames[2][0x220]                 # .. their names (0x44 apart: a name and its bone's translation scale, a float: ListedObject.scale)
0x888      8          i32 skelCount[2]                           # .. the skeletons ..
0x990      0x100      char skelNames[2][0x80]                    # .. and their names (0x40 apart)
0xa90      8          i32 armsJoint[2]                          # per detail level: the entry (in its shape list) the arms hang on; legsJoint .. boosterJoint the same for the legs, head and booster (actor_processFrame)
0xa98      8          i32 legsJoint[2]                                # (see armsJoint) the legs': their pose is loaded from that entry's matrix, then turned by pose[2] (actor_processFrame)
0xaa0      8          i32 headJoint[2]                                # (see armsJoint) the head's (actor_processFrame: part_matrix)
0xaa8      8          i32 boosterJoint[2]                             # (see armsJoint) the booster's: turned there by pose[0] and pose[1] (actor_processFrame: part_matrix)
0          0x40       char name[0x40]                                 # its type name (KYRIE\CHEST ...: Component.dat); set_part copies it to PlayerRecord.partNames[1]; the ARM CENTER's chest panel shows it with '\' and '/' as '-' (armc_readPartPanels: panel_name)
0xab0      4          float weightLimit                         # WEIGHT LIMIT (message 611), tons: x the pilot character's skill factor (stats[8] x 0.01 + 1) x the item factor loadFactor = the actor's loadMax (mech_stats)
0xab4      4          i32 maxArmor                                    # MAX ARMOR (message 612): x the pilot character's factor (stats[6] x 0.01 + 1), rounded = the actor's armorMax (mech_stats); the chest panel's g_chestMaxArmor
0xab8      4          i32 maxShield                                   # MAX SHIELD (message 613): x the pilot character's factor (stats[6] x 0.01 + 1) x the item factor shieldFactor, rounded = the actor's shieldMax (mech_stats); the chest panel's g_chestMaxShield

struct ArmType 0x1300                                           # an arm part type (Stage.armTypes)
0x40       8          i32 shapeCount[2]                         # per detail level (Actor.lowDetail: [0] near, [1] far): the shapes (ObjectList_load's ns) ..
0x848      0x880      char shapeNames[2][0x440]                 # .. their names (0x44 apart: a name and its bone's translation scale, a float: ListedObject.scale)
0x10c8     8          i32 skelCount[2]                           # .. the skeletons ..
0x11d0     0x100      char skelNames[2][0x80]                    # .. and their names (0x40 apart)
0x12d0     0x18       i32 weaponJoints[3][2]                    # per detail level, the entries the weapons hang on: [0] slots 0 .. 3 (the right fist), [1] slot 4 (the RSW bone), [2] slot 5 (LSW) (actor_processFrame, muzzle_camera)
0          0x40       char name[0x40]                                 # its type name (KYRIE\ARM ...: Component.dat); set_part copies it to PlayerRecord.partNames[2]; the ARM CENTER's arm panel shows it with '\' and '/' as '-' (armc_readPartPanels: panel_name)
0x12e8     4          float weight                                    # WEIGHT (message 626), tons: part of the actor's load (mech_stats, see HeadType.weight); the arm panel's g_armsWeight
0x12ec     0x14       i32 stats[5]                              # [0] the FIRE CONTROL SYSTEM level (message 621; the actor's accuracy), [1 ..] CAPACITY FOR 30MM, 60MM, E-PAK, MISSLE (messages 622 .. 625): x the item factor ammoFactor, + ammoBonus = the actor's ammoMax (mech_stats)

struct LegType 0x13f4                                           # a leg part type (Stage.legTypes)
0x40       8          i32 shapeCount[2]                         # per detail level (Actor.lowDetail: [0] near, [1] far): the shapes (ObjectList_load's ns) ..
0x848      0x880      char shapeNames[2][0x440]                 # .. their names (0x44 apart: a name and its bone's translation scale, a float: ListedObject.scale)
0x10c8     8          i32 skelCount[2]                           # .. the skeletons ..
0x11d0     0x100      char skelNames[2][0x80]                    # .. and their names (0x40 apart)
0x12d0     0x100      i32 emitters[2][0x20]                     # its puffs: [0] the entries, [1] 1: only while running (run > 0, the booster key) (actor_processFrame: emit)
0x13d0     4          i32 emitterCount                                # how many of emitters are used: emit spawns a puff at each (actor_processFrame)
0x13d4     4          i32 emitterCountCopy                       # the same value as emitterCount in every Component.dat record (2 / 4); never read
0          0x40       char name[0x40]                                 # its type name (KYRIE\LEG ...: Component.dat); set_part copies it to PlayerRecord.partNames[3]; the ARM CENTER's leg panel shows it with '\' and '/' as '-' (armc_readPartPanels: panel_name)
0x13d8     4          float weight                                    # WEIGHT (message 637), tons: part of the actor's load (mech_stats, see HeadType.weight); the leg panel's g_legsWeight
0x13dc     4          float agility                             # AGILITY (ARM CENTER legs, message 631): x the pilot character's skill factor (stats[4] x 0.01 + 1) x (1 - the overload) = the actor's mobility (at least 0; a third in the rocket arena) (mech_stats)
0x13e0     4          float inertia                             # INERTIA (ARM CENTER legs, message 632): x the speed = the actor's moveAccel
0x13e4     4          float speedCorrection                           # SPD CORRECTION (message 633): + the pilot character's stats[5] x 0.01 + 1, x the booster's speeds[0], x (1 - the overload) = the actor's speed, at least 100 (mech_stats); the panel shows x 100 as a percentage
0x13e8     4          float forwardBoostCorrection              # F.BOOST SPD CORRECTION (message 634): + the pilot character's legs skill (stats[5] x 0.01) + 1, x the booster's speed [1], / the speed, x (1 - the overload) = the actor's runTop[0] (mech_stats)
0x13ec     4          float backBoostCorrection                 # B.BOOST SPD CORRECTION (message 636): with the booster's speed [2], negated
0x13f0     4          float sideBoostCorrection                 # S.BOOST SPD CORRECTION (message 635): with the booster's speed [3]

struct BoosterType 0x1820                                       # a booster part type (Stage.boosterTypes)
0x40       8          i32 shapeCount[2]                         # per detail level (Actor.lowDetail: [0] near, [1] far): the shapes (ObjectList_load's ns) ..
0xa48      0xaa0      char shapeNames[2][0x550]                 # .. their names (0x44 apart: a name and its bone's translation scale, a float: ListedObject.scale)
0x14e8     8          i32 skelCount[2]                           # .. the skeletons ..
0x15f0     0x100      char skelNames[2][0x80]                    # .. and their names (0x40 apart)
0x16f0     0x100      i32 emitters[2][0x20]                     # its thrust: [0] the entries, [1] 1: only while running (run > 0, the booster key) (actor_processFrame: emit)
0x17f0     4          i32 emitterCount                                # how many of emitters are used: emit spawns a thrust particle at each (actor_processFrame)
0x17f4     4          i32 emitterCountCopy                       # the same value as emitterCount in every Component.dat record (1 .. 5); never read
0          0x40       char name[0x40]                                 # its type name (KYRIE\BOOSTER ...: Component.dat); set_part copies it to PlayerRecord.partNames[4]; the ARM CENTER's booster panel shows it with '\' and '/' as '-' (armc_readPartPanels: panel_name)
0x17f8     4          float weight                                    # its weight: added with the legs', arms' and head's into Actor.load (mech_stats, then the items'); shown as g_boosterWeight in the ARM CENTER panel (armc_readPartPanels)
0x17fc     4          i32 thrustType                            # THRUST TYPE (message 641): 0 PLASMA THRUST ENGINE, 1 ION THRUST ENGINE, 2 GRAVITY ION ENGINE (section_booster shows MSG(651 + it) via g_boosterThrustType, armc_readPartPanels); its puffs are particle kind 5 + it (emit, actor_frame.c); its step sound every third of a second is sound it, + 3 while inBooster (actor_processFrame); also copied to g_unusedMechStat (armc_readMechStats)
0x1800     4          float lean                                # the actor's boosterTilt: how far the booster joint tips with the aim's pitch (actor_processFrame's pose[1]); 0.0 in every booster of Component.dat
0x1804     0xc        float times[3]                            # seconds: [0] ACTIVE TIME, [1] RECHARGE TIME, [2] DELAY FOR RECHARGE (messages 642 .. 644); x the item factors boostTimeFactor, rechargeTimeFactor, restTimeFactor = the actor's boostTime, rechargeTime, restTime (mech_stats)
0x1810     0x10       float speeds[4]                           # 1/100 m a second (x 0.036 = km/h on the panel): [0] NORMAL SPEED (message 645), [1] .. [3] the boost's forward, back and side speeds (MAX SPEED FWD/SWD/BWD, message 646); with the legs' corrections = the actor's speed and runTop[0 .. 2] (mech_stats)

struct CollisionTri 0xac                                        # a triangle of the collision space (Space.planes; collisionTri_setup): its corners, edges, face and
                                                                 # edge planes, unit and part; a bullet's hit (Bullet.hit)
0          4          i32 flags                                 # 0x10: takes no marks (a transparent part's triangle, or the background floor's; read by hit_surface); 1: its unit disabled (space_disableUnit sets it, space_enableUnit clears it), skipped by the ray and sphere traces; else 0 (collisionTri_setup)
4          0x24       float cornerPoints[3][3]                  # its triangle's corners (collisionTri_setup)
0x28       0x24       float edges[3][3]                         # edge i: corner i + 1 - corner i, normalized (collisionTri_setup)
0x4c       0xc        float normal[3]                            # the face's: (-edge 0) x edge 1
0x58       4          float dist                                 # the face plane: normal . corner 0
0x5c       0x30       float edgePlanes[3][4]                     # edge k's plane: normal x edge k, through corner k (its normal and distance)
0x8c       4          struct SpaceUnit *unit                           # its collision unit (none: 0: the ground's triangles, collision_tris.c ground_triangle); the unit's index (its first field) is the map object's (Stage.objects): hit_surface / decal read *it
0x90       4          i32 part                                   # the object's shape part
0x94       0xc        i32 cornerIndices[3]                       # the corners' vertex indices in the part
0xa0       4          u8 *listNext                               # its unit's list (space_addUnitTriangle: the next plane; the free pool walks +0xa4 as its next)
0xa4       4          u8 *listPrev                                    # in use: the previous plane of its unit's list (space_addUnitTriangle; space_disableUnit / space_enableUnit walk back from SpaceUnit.lastPlane by it); free: the next free plane (reset_pool chains +0xa4, space_getNextFreePlanePtr)

struct TimeSync 0x38                                            # a frame timer on the performance counter (timer.c; class TimeSync)
0          4          u32 vtable                                 # 0x4aa46c (TimeSync_ctor / _dtor); TimeSync_clear, which the ctor calls right after, zeroes it again (as in the original)
4          4          i32 started                               # 1: its frequency and start read (TimeSync_frameTime; TimeSync_clear 0)
8          4          i32 frames                                 # frames counted towards the next second
0xc        8          u64 frequency                              # the counter's
0x14       8          u64 lastCount                              # its reading at the last frame
0x1c       8          int64_t rise                              # the last frame's counter rise; its low half is read straight back (0x487533) to add to riseSum, and nothing reads it on a later frame
0x24       8          int64_t riseSum                            # the rises summed (past a second: fps, then cleared)
0x2c       4          float fps                                  # frames per second (0 for a sum not positive)
0x30       4          float frameTime                            # the last frame's seconds, at most maxFrame
0x34       4          float maxFrame                            # the longest frame time: 1/15 s (0x3d888889), set on the first call because nothing else ever sets it (TimeSync_clear zeroes it)

struct SpaceUnit 0x14                                           # a unit of the collision space (Space.units; spaceSlot_clear): a map object (one unit for all its parts not flagged 0x20: space_buildUnit; the part is CollisionTri.part)
0          4          i32 index                                 # its map object's number (Stage.objects; space_buildUnit' id); -1 when cleared (spaceSlot_clear). CollisionTri.unit points at it
4          4          u8 *lastPlane                              # its planes' list (CollisionTri.listNext / listPrev): the last
8          4          SpaceNode *lastNode                        # its planes' nodes: the last
0xc        4          u8 *poolPrev                               # its links in the units' pool
0x10       4          u8 *poolNext                                    # the next unit of the free pool (space_resetUnits chains the units; space_getNextFreeUnitPtr moves the pool's freeHead to it and clears that one's poolPrev)

struct ParticleDesc 0x7c                                        # what a particle is made from (particle_spawn's record; particle_init)
0          4          i32 kind                                        # the particle's kind, copied to Particle.kind (particle_init; isQuad 1 makes kind 50 instead): 0/1/8 0.5 s, 2/3 burst sounds, 4 glow flare, 5..7 puffs, 10..18 spun / headed, 20..24 aimed, 25/26 beams, 40..49 hit marks
4          4          i32 owner                                 # copied to Particle.owner, whose meaning is by kind: the actor it belongs to (glows and shells against cockpitActor), the player whose part shapes the debris shows (9: playerRecords index), a glow flare's alpha byte (4), a flag 1 (22, 25 ...), a random 0 .. 7 (emit(): the legs' / booster's puffs)
8          0xc        float pos[3]                                    # where it starts, copied to Particle.pos (particle_init): an impact point (weapons.c effect), a joint's centre (emit), the dying actor's position (actor_dies), a glowing object's place (mapObject_frame)
0x14       0xc        float target[3]                           # copied to Particle.target, whose meaning is by kind (see there): an aim point, a hit's surface normal (effect(): impacts and marks), puffs' scale and alpha (emit()), a velocity ...
0x20       4          u32 matrixFrom                             # a matrix to copy (none: 0)
0x24       4          const float *markCorners                  # kinds 40 .. 49, a bullet's mark on the surface it hit (weapons.c decal): the hit triangle's three corners (the map object's own vertices when matrixFrom is its matrix, else in the world)
0x28       4          const float *markCoords                   # and the corners' coordinates in the mark's plane about the impact (six floats: corner 0 (its distance, 0), then corners 1 and 2 (u, v)), world units; particle_mark makes them texture coordinates (x 0.005 + 0.5, or (/ (size + margin) + 1) / 2; [1] unused, v 0.5)
0x2c       4          float size                                # the particle's baseSize (0: none)
0x30       4          i32 isQuad                                 # 1: a kind 50 quad, from the fields below
0x34       0x18       u8 quad[0x18]                              # its texture, two texture corners (floats u, v: Particle.quadUv0 / quadUv1), colour (Particle.quadTexture ..)
0x4c       0x30       float quadPoints[4][3]                          # isQuad 1: the quad's four corners (x, y, z, world), copied to Particle.quadPoints (particle_init) and drawn by particle_draw (ViewVolume_addQuad); written for weapon beams (weapons.c beam: the last and current point's corners)

