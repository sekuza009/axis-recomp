0xc        4          u32 colour                                 # packed RGBA
0x10       0xc        float pos[3]                              # a point light's position (kinds 2, 3)
0x1c       0xc        float dir[3]                              # a directional light's direction (kind 1)
0x28       4          float radius                              # a point light's reach (kinds 2, 3)

