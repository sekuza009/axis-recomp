struct Particle 0x12c                                         # a particle or effect (Stage.particles: particle_init / particle_update): flashes, sparks, beams, trails, explosions...
0          4          i32 id                                    # a serial (Stage.particleSerial, particle_init); kind 0 picks its frame by id % 8 (particle_draw)
8          4          i32 kind                                  # what it is: 0 a small puff, 2 / 3 explosions (3: an actor's death), 4 a light's glow flare, 5 .. 7 thrust puffs (booster thrustType + 5), 8 a hit flash, 9 debris (a dead actor's part shapes, falling), 10 .. 18 muzzle flashes (shotMode + 10), 20 .. 26 shots in flight (shotMode + 0x14; 25 / 26 beams), 30 .. 39 impacts (shotMode + 0x1e), 40 .. 49 hit marks on surfaces (shotMode + 0x28: weapons.c decal), 50 a textured quad (a beam weapon's side: weapons.c beam)
0xc        4          i32 owner                                 # by kind: the actor it belongs to (muzzle flashes; glows halve for the cockpit actor's), 1 for a shot drawn from the cockpit actor's own first 0.03 s (kinds 20 .. 26: 22 / 25 / 26 then not drawn, nor particle_beam's dots), the hit actor's 0x2000 flag (kind 8: texture 4), the dead actor's player record (kind 9 debris), the flare's alpha 0 .. 255 (kind 4), a random 0 .. 7 (puffs 5 .. 7, unused)
0x10       0xc        float pos[3]
0x1c       0xc        float target[3]                           # by kind: the point it aims at (20 / 21 / 24 aimed from pos; 25 / 26 beams from it back); the hit surface's normal (impacts 30 .. 39 on a surface, hit marks 40 .. 49: weapons.c effect()), or for a hit on an actor the direction away from it (30 .. 39, 8); a piece of debris' velocity (9); smoke puffs' scale [0] and alpha factor [1] (5 .. 7); a glow flare's half-size [0] and colour bits [1] (4)
0x28       4          u32 matrixFrom                            # a matrix it is placed by, as a pointer (0: none): a muzzle entry's (flashes), an emitter joint's (puffs) or a hit map object's (hit marks); copied into matrix at its start (particle_spin), and a hit mark (40 .. 49) is drawn through it every frame
0x2c       0x40       float matrix[16]
0x6c       4          float drawAge                             # its age as drawn this frame (age before the frame's step)
0x70       4          float life                                # seconds it lives (it is freed past it)
0x74       4          float age
0x78       4          u32 colour                                # (its byte 0x7b: the alpha, set as it fades)
0x7c       4          float lightRadius                         # the radius of the white point light it casts at pos (stage_refillLights, when above 0): 0 at its start, then (1 - age / life)^2 x 3000 (kind 2), 5000 (3), 2000 (25, 26), 1000 (30, 31), 1500 (32 .. 34, 37, 38), 5000 (35), 3000 (36) (particle_update); 0 for other kinds
0x80       4          float baseSize                            # the descriptor's size
0x84       0x24       union { float fade; float markPoints[3][3]; }   # fade: (kind 9, debris) the wait to its next puff (0.1 s);
                                                                 # markPoints: (hit marks, kinds 40 .. 49) their triangle's three points
0xb4       0x18       float markUv[6]                           # (kinds 40 .. 49, a hit mark) the hit triangle's three corners' texture coordinates (u, v), the mark's texture centred (0.5, 0.5) on the impact: corner offsets (ParticleDesc.markCoords, weapons.c decal's uv) x 0.005 + 0.5, or (offset / (baseSize + 200 / 400) + 1) / 2
0xd4       0xc        u32 markColours[3]                        # (kinds 40 .. 49, a hit mark) its three corners' colours: white (g_white), their alpha fading over its second second (particle_draw: (2 - drawAge) x 256 once drawAge > 1)
0xe4       4          i32 quadTexture                           # kind 50, a quad: its texture (ViewVolume_addQuad's), two texture corners, colour, points (ParticleDesc.quad)
0xe8       8          float quadUv0[2]                            # (kind 50) a texture corner (u, v)
0xf0       8          float quadUv1[2]                            # (kind 50) the other texture corner (u, v)
0xf8       4          u32 quadColour
0xfc       0x30       float quadPoints[4][3]
4          4          i32 active                                # 1: in use

struct Bullet 0x4e8                                             # a bullet in flight (Stage.bullets: bullet_init, bullet_update)
0xc0       4          float homeTimer                            # (by use; seen running) a homing bullet turns again every 1/15 s
0xd0       4          i32 struck                                # 1: it hit something, an actor (hit_actor) or a surface (hit_surface): splash damage then (splash); 0 from bullet_init
0xd4       0x3c0      float trail[20][4][3]                        # (by use; seen running) a trail's ring of cross-sections (4 points each: weapons.c trail)
0x494      0x50       float trailAge[20]                        # (kind 3 trails) each cross-section's bullet age when made (trail); bullet_drawTrail ends the trail at the first one more than 1 s old. A beam (kind 7) leaves its length in [0] (beam), never read
0x4e4      4          i32 trailCount                             # the cross-sections made (the ring's next: % 20)
0          4          i32 id                                    # the next serial (Stage.bulletSerial: both bullet_spawn calls pass id -1); a beam picks its texture quarter by id % 4
4          4          i32 active                                # 1: in use
8          4          i32 weapon                                # its weapon's record (index into Scene.actorItems)
0xc        4          i32 owner                                 # the actor that fired it
0x10       4          u32 muzzle                                # the muzzle entry's matrix (FiredRound.muzzle; bullet_init passes it as its muzzle flash's ParticleDesc.matrixFrom)
0x54       0xc        float from[3]                             # where it was fired from
0x60       0xc        float impact[3]                           # where it ends, its impact point: the first step's end or hit (bullet_init; a network round: its target point), an actor's hit point (fly_local), a guided round's world hit (fly_local), or the network's point (actor_processFrame); its impact, mark and sound are made there (hit_actor, hit_surface)
0x6c       4          struct CollisionPlane *hit                       # the surface (a CollisionPlane in Space.planes) where it ends: the first step's trace (bullet_init), each step's for a guided round (fly_local), the network's (actor_processFrame, bullet_init for a received round); 0: none, also when it hits an actor. hit_surface makes its impact and mark
0x70       4          float age                                 # seconds in flight
0x74       4          float life                                # the age at which it ends (s): the first step's length (or the distance to its hit) over the weapon's speed, kept to 0 .. 10 (bullet_init; a network round: 10); cut to its age when it hits an actor, to the world hit for a guided round (fly_local), or to age - dt by the network (actor_processFrame)
0x78       0xc        float prev[3]                             # its point before this frame's move
0x84       0xc        float pos[3]                              # its point
0x90       0xc        float netPoint[3]                         # the point the network sent (another player's bullet)
0x9c       4          i32 moved                                 # 1: drawn this frame (draw_shot): a local round after its step (fly_local); another player's when the network sent a new point (netPoint, actor_processFrame), which it then moves to (otherwise it steps on by step undrawn); cleared after each frame
0xa0       0xc        float vel[3]
0xac       0xc        float step[3]                             # this frame's move: a local round's dt x vel (a weapon of no speed: vel itself; fly_local); another player's the unit direction to the network's point (bullet_update), added again on frames with no new point
0xb8       4          i32 hitActor                              # an actor it hit (-1 none), which takes it first
0xbc       4          i32 homingTarget                          # the actor a guided round homes on (bullet_init's fourth argument; < 0 none: the local player's own round follows the aim point)
0xc4       0xc        float homingPoint[3]                      # the point a guided round homes on without a target actor (the local player's own: 200000 along the aim)

struct SpacePool 0x10                                           # one of the collision space's pools (space_pools.c): an array of records and its free list
0          4          i32 count                                 # records
4          4          u8 *records
8          4          u8 *freeHead                              # the first free record (each free one links on)
0xc        4          i32 used                                  # records taken

struct SpaceNode 0x10                                            # a node of the collision space's lists (its pool: Space.nodes): a block's items
                                                                 # (SpaceBlock.items) and a unit's planes (SpaceUnit.lastNode); a list runs from its
                                                                 # head, the newest, through next
0          4          u8 *item                                  # the CollisionPlane it holds (a block's item or one of a unit's planes); the plane's first byte bit 1 (space_disableUnit): left out of the static space's tests (space_collideBlock / space_traceBlock skip it only outside the moving units' lists)
4          4          u8 *block                                 # (a block's items) the block; written (space_insertItem), never read
8          4          struct SpaceNode *newer                   # the one put in after it (the list's back link; in the pool's free list the one before it, 0 at the head); written, never read
0xc        4          struct SpaceNode *next                    # the one put in before it (the lists run from the newest through it); in the pool's free list the next free one

struct SpaceBlock 0x50                                          # a block of the collision space (Space.blocks): an octree node over a box
0          0xc        float low[3]
0xc        0xc        float high[3]
0x18       4          SpaceNode *items                           # its items' list
0x1c       4          i32 itemCount                              # over Space.splitCount (depth left): it splits
0x24       4          i32 split                                  # 1: its items are in its children
0x28       0x20       u8 *children[8]
0x48       4          u8 *poolPrev                               # its links in the blocks' pool
0x4c       4          u8 *poolNext

struct Space 0xf4                                               # the collision space (space_pools.c; 0xf4 bytes: CollisionVolume_clear zeroes 0x3d dwords, Stage.spaceData follows it; only the fields used)
4          4          i32 blockSize                              # its pools' memory (space_initBy: allocated when none is given)
8          4          u8 *block
0xc        4          i32 ownsBlock                              # 1: allocated here
0x10       0x10       SpacePool planes                          # 0xac-byte planes
0x20       0x10       SpacePool nodes                           # 0x10-byte nodes
0x30       0x10       SpacePool units                           # 0x14-byte units
0x40       0x10       SpacePool blocks                          # 0x50-byte blocks
0x50       4          i32 cellCapacity                          # cells the cells' table has room for
0x54       4          u16 *cells                                 # the cells' table: a cell's root block (blocks.records index; 0xffff: none)
0x58       4          i32 cellCount                             # nx * ny * nz; written, never read
0x5c       0xc        float min[3]                              # its bounds
0x68       0xc        float max[3]
0x74       4          i32 cellsZ                                # the grid's cells along z (pos[2]): collision_initVolume's (levelHigh[2] - levelLow[2]) / size_z, space_setBy's first count
0x78       4          i32 cellsX                                # the grid's cells along x (pos[0])
0x7c       4          i32 cellsY                                # the grid's cells along y (pos[1])
0x80       0xc        float cellSize[3]                         # a cell's size, stored (z, x, y): cellSize[0] = (max[2] - min[2]) / cellsZ, [1] = x extent / cellsX, [2] = y extent / cellsY
0x8c       4          u32 margin                                # a float (500.0, loading.c): how far the space's box, the grid cells and the blocks' boxes are widened for a triangle put in (space_insertTriangle, space_insertItem) and a point looked up (space_collideAt); also Scene.spaceMargin, the free camera's step cap
0x90       4          i32 splitCount                            # items a block holds before it splits (space_setBy; 16, loading.c; space_insertItem)
0x94       4          i32 depth                                 # the blocks' recursion depth (at most 8)
0x98       4          i32 lastHit                               # space_collideAt's last result; written, never read

struct PartInfo 0x80                                            # an ARM CENTER part-info record (g_partRecords, g_viewedPart: armc_parts.c part_info)
0          0x40       char name[0x40]                            # the item's folder path after its last slash
0x40       4          i32 slotType                              # SLOT TYPE (ActorItem.slotType): message 321 + this, 0 HAND, 1 SHOULDER; -1: an empty record (EMPTY SLOT, part_info with idx -1)
0x44       4          i32 ammoType                              # BULLET TYPE (ActorItem.ammoType): message 323 + this: 0 30mm, 1 60mm, 2 E-PAK, 3 ROCKET; -1: a special weapon (SPECIAL WEAPON, message 771). The viewed record's is g_viewedPartAmmoType
0x48       4          i32 ammoPerShot                           # BULLET CONSUMPTION (ActorItem.ammoPerShot, "cell"); in the viewed record of a special weapon (ammoType -1) armc_viewedPartRecord overwrites it with the actorItems index (g_viewedPartAmmoPerShot, the same memory), shown as message 745 + it: 772 .. 780 for items 27 .. 35, the item's description lines ("EXTRA CHARGE OF ALL TYPE|BULLETS BY 30%" ..)
0x4c       4          i32 burst                                  # "Round"
0x50       4          i32 damageType                             # message 327 + this: "IMPACT" ..
0x54       4          i32 damage
0x58       4          float range                                # range x 0.01: "m"
0x5c       4          float speed                                # velocity x 0.01: "m/s"
0x60       4          float spread                              # ActorItem.spread x 0.1 (k_tenthsToDegrees): shown "%.1f" with message 752 "'" (DISPERSION ANGLE)
0x64       4          float hitRange                            # x 0.01: "m" (HIT RANGE)
0x68       4          float splashRadius                         # x 0.01: "m"
0x6c       4          i32 splashBorderDamage                    # (SPLASH BORDER DAMAGE)
0x70       4          float cycleTime                            # x 1000: "ms"
0x74       4          float guidance                            # ActorItem.guidance x 0.1 (k_tenthsToDegrees): shown "%.1f" with message 752 "'" (GUIDANCE)
0x78       4          float targetingTime                       # x 1000: "ms" (TARGETING TIME)
0x7c       4          float weight

struct Mission 0xfc                                              # one of the 30 missions of axis.mis (g_missions: mission_loadAxisMis; screen 900's list, which nothing in the menus opens)
0          4          i32 unused0                               # an entry's first word in axis.mis (mission_loadAxisMis), 0 when the list is cleared; nothing reads it
4          0x40       char name[64]                              # the list's first column
0x44       0x20       char title[32]                             # its second
0x64       0x80       char briefing[128]                         # (shown under the list for the one picked)
0xe4       4          i32 number                                 # the third column
0xe8       4          i32 unusedE8                              # read from axis.mis with the entry, cleared with the list; nothing reads it
0xec       4          i32 result                                 # the fourth: a message (MSG(511) + result * 0x80): 0 DON'T, 1 SUCCEED, 2 FAILED (seen with a test axis.mis)
0xf0       4          i32 unusedF0                              # read from axis.mis with the entry, -1 when the list is cleared; nothing reads it
0xf4       4          i32 blockSize                              # its block in axis.mis (read after all the entries); the record's last four bytes (+0xf8) are never touched

struct NetPacketMessage 0x40c                                    # a DirectPlay message carrying slot data (kinds 6 and 7: net_handleMessage; the match's
                                                                 # packets are kind 7, g_netSendPacket)
0          4          u32 kind
4          1          u8 slot                                   # kind 7: the sender's slot (net_sendPacketData: g_localSlot); kind 6 (g_netSlotMsg, 8 bytes): the slot the host gives the receiver (g_netClaimedSlot), taken as the local one
5          4          i32 size                                   # (0x40)
9          0x403      u8 data[0x403]                             # the packet: its first byte the number (net_packets.c)

struct NetSlot 0x410                                             # one of the sixteen network player slots (g_netSlots): the packet layer's player table
0          4          i32 used
4          4          u32 id                                     # its DirectPlay player id
8          4          i32 waiting                                # a packet is waiting in packet
0xc        4          u32 size                                  # the packet's size (0x40: net_handleMessage stores only that); written, never read (netq_receive uses 0x40)
0x10       0x400      u8 packet[0x400]                           # the packet received (64 bytes: its first byte the number, bit 7 a resend request
                                                                 # for the player in the second)

struct DPSessionDesc2 0x50                                       # DirectPlay's DPSESSIONDESC2 (dplay.h; ANSI): hosting, joining and enumerating (net_tables.c)
0          4          u32 size                                   # dwSize (0x50)
4          4          u32 flags                                  # dwFlags
8          0x10       u8 instance[16]                            # guidInstance
0x18       0x10       u8 application[16]                         # guidApplication (k_axisAppGuid)
0x28       4          u32 maxPlayers                             # dwMaxPlayers
0x2c       4          u32 players                                # dwCurrentPlayers
0x30       4          const char *name                           # lpszSessionNameA
0x34       4          const char *password                       # lpszPasswordA
0x38       4          u32 reserved1
0x3c       4          u32 reserved2
0x40       4          u32 user1                                 # the game's: map (byte 0), rotation (byte 1) as the arena hosts set it (arena_connectionOutcome, host_arena); room_hostingStep (the Ladder game room) puts the game mode here instead (the original's)
0x44       4          u32 user2                                  # the game mode
0x48       4          u32 user3                                  # the time limit (byte 0), frag limit (byte 1)
0x4c       4          u32 user4                                  # (TCP) the host's address

struct ServerRecord 0x5b                                         # an arena as the lobby server lists it (g_serverList, 256; g_arenaPacket: the hosted arena's own,
                                                                 # sent when it is set up; g_arenaInfoPacket / g_lobbyLeavePacket: its updates)
0          1          u8 kind                                   # the record's first byte as the game sends it: 0x18 in the set-up packet (lobby_announceArena), g_arenaPacket's (0x18) in the info packet (arena_info), 1 in the leave packet (send_leave); copied into g_serverList (net_addServerRecord), never read
1          0x32       char name[0x32]
0x33       0x10       char address[16]                           # the host's address as text
0x43       1          signed char map
0x44       1          signed char maxPlayers
0x45       1          signed char players
0x46       1          signed char gameMode
0x47       1          u8 fragLimit
0x48       1          u8 timeLimit
0x49       1          signed char rotation                       # the arena's map rotation (GameSettings.rotation)
0x4a       4          u32 replyKind                              # in a lobby reply (g_lobbyReplyRecord): its kind (g_lobbyReplyKind, net_receiveLobbyReply: 0 a server, 1 the list's end, 2 / 3 an answer state: g_lobbyListAnswer)
0x52       1          u8 locked
0x53       8          char password[8]

struct RoomRecord 0x79                                           # a game room as the game server lists it (g_roomList, 256; g_roomPacket: the room's own,
                                                                 # g_roomInfoPacket / g_roomLeavePacket its updates): a ServerRecord with the host's name
0          1          u8 kind                                   # the record's first byte as the game sends it: 0x18 in the set-up packet (room_announceGame); in the info packet (room_info) 1 when a player joined, else g_roomPacket's; 1 in the leave packet (send_leave); copied into g_roomList, never read
1          0x32       char name[0x32]
0x33       0x10       char address[16]
0x43       0x1e       char hostName[30]                          # the player who made it (g_ladderId)
0x61       1          signed char map
0x62       1          signed char maxPlayers
0x63       1          signed char players
0x64       1          signed char gameMode
0x65       1          u8 fragLimit
0x66       1          u8 timeLimit
0x67       1          signed char rotation                       # the room's map rotation (GameSettings.rotation)
0x68       4          u32 replyKind                              # in a game server reply (g_gameServerReply): its kind (g_gameServerReplyKind, net_receiveGameServerReply: 0 a room, 1 the list's end, 2 / 3 refused)
0x70       1          u8 locked
0x71       8          char password[8]

struct SessionDesc 0x85                                          # an arena session DirectPlay's enumeration found (dplay_enumSessionsCallback, from its
                                                                 # DPSESSIONDESC2); net_addSession keeps a malloc'd copy (SessionSlot.desc)
0          4          u32 guid                                   # a GlobalAlloc'd copy of the instance GUID: the join's argument (dplay_join)
4          0x10       u8 instance[16]                            # guidInstance
0x14       0x10       u8 application[16]                         # guidApplication
0x24       1          signed char map                            # dwUser1's low two bytes: the map ..
0x25       1          signed char rotation                       # .. and the map rotation flag
0x26       1          u8 maxPlayers                              # dwMaxPlayers
0x27       1          signed char gameMode                       # dwUser2
0x28       1          u8 fragLimit                               # dwUser3's two low bytes, the other way round
0x29       1          u8 timeLimit
0x2a       4          i32 players                                # dwCurrentPlayers
0x2e       0x46       char name[70]                              # lpszSessionName
0x74       0x10       char address[16]                           # (TCP, connection kind 0) the host's address as text

struct SessionSlot 8                                             # one of the 200 of g_sessionTable
0          4          i32 used
4          4          SessionDesc *desc

struct SessionEntry 0x4a                                         # a game of the arena lobby's / game room's list (g_sessionList, 256: arenaList_rebuild
                                                                 # from the SessionDescs, the merge of received games in net_sessions.c)
0          4          u32 guid                                   # (SessionDesc.guid) the join's argument
4          0x20       char name[32]
0x24       1          signed char rotation                       # the map rotation flag (shown "ROTATION")
0x25       1          signed char map
0x26       1          signed char maxPlayers
0x27       1          signed char players
0x28       4          i32 ping                                   # (the list is sorted by it; 0 from DirectPlay)
0x2c       1          signed char gameMode
0x2d       1          u8 fragLimit
0x2e       1          u8 timeLimit
0x2f       0x10       char address[16]                           # what dplay_openConnection opens
0x3f       8          char password[8]
0x47       1          u8 locked                                  # a password is asked for (the lock shown)

struct FileEntry 0x44                                            # a file of the replay selection / replay list (g_replayList, 1024)
0          0x40       char name[0x40]
0x40       4          i32 picked                                # 1: picked (a replay chosen in the replay selection: replaySelect_toggle / allIn / allOut; scene_startSession plays the picked ones)

struct MapChoice 8                                               # a map of the arena's map list (g_mapChoiceTable, g_mapChoiceKeptTable: 1024)
0          4          i32 chosen                                 # in the rotation
4          4          i32 type                                   # its game type (0 .. 13)

struct AccountPacket 0x10b                                       # the game server's account record (g_accountPacket, 0x10b bytes: sent with requests 14, the login, and 15, the new ID (newId_register): net_send's case 14 / 15)
0          4          i32 kind                                   # 0x18
4          0x1e       char name[30]
0x22       0xc        char password[12]
0x2e       0x32       char email[0x32]
0x60       0x10       char address[16]                          # this machine's (g_localAddress, written by net_tables' request 14 / 15 handler just before the record is sent: the login and the new ID)
0x70       0xb        u8 mech[11]                                # the default mech settings (lobby_states default_mech)
0x7b       0x90       float colours[6][6]                        # six colour pairs, each (hue, saturation, value) twice (default_mech: 0, 1, 0.6)

struct AccountForm 0x5c                                          # the account form's fields as sent (g_netAccountBuffer: message 0x1c)
0          0x1e       char name[30]
0x1e       0xc        char password[12]
0x2a       0x32       char email[0x32]

struct GameSettings 0x30                                         # a game's settings record (g_arenaName: the arena's / axis.cfg's, g_roomRecName: the
                                                                 # registry's, g_roomSettingsName: the room form's, g_newArenaName: the new arena form's)
0          0x20       char name[32]
0x20       1          signed char map
0x21       1          signed char maxPlayers                    # the most players (the form's NO OF PLAYER row, MSG(400); 0 .. 16, else 8 from axis.cfg)
0x22       1          signed char rotation                       # 1: map rotation on (the map list's maps in turn: the preview shows CUSTOM; the form's MAP ROTATION row)
0x23       1          signed char mode
0x24       2          u8 limit[2]                                # frag, time
0x26       8          char password[8]
0x2e       1          u8 locked                                  # the password is not empty (settings_store)

struct RankedPlayer 0x3e                                         # a player of the ranking list as the game server sends it (62 bytes: g_playerListReply;
                                                                 # kept in g_netPlayerList, ten of them (one ranking page), by net_addPlayerRecord)
0          0x1e       char name[30]
0x1e       4          i32 kind                                  # the reply's kind (g_serverReplyKind): 0 a player (net_addPlayerRecord adds it), 1 the list's end (g_playerListDone set, g_netLastRequest cleared)
0x22       4          i32 games                                 # Ladder rounds played (the account's g_ladderGames, see PlayerRecordPacket.games; DServer keeps it as 'a'); not shown, copied to RankRow.games
0x26       4          i32 kills                                  # the columns of the ranking table (RankRow)
0x2a       4          i32 deaths
0x2e       4          i32 exp
0x32       4          i32 level                                  # its grade (the rank badge)
0x36       4          float power
0x3a       4          float rate

struct RankRow 0x44                                              # a row of the ranking table (g_rankingRows, ten: ranking_fillPage from g_netPlayerList)
4          4          i32 rank                                   # its place (the row before's when its sorted value is the same)
8          0x1e       char name[30]                              # (empty: past the list's end)
0x26       4          i32 exp                                    # (sort 2)
0x2a       4          i32 games                                 # RankedPlayer.games (Ladder rounds played; not shown); written, never read
0x2e       4          i32 kills                                  # (sort 1)
0x32       4          i32 deaths
0x36       4          float rate                                 # (sort 3)
0x3a       4          i32 level                                  # the rank badge (1 when the row is cleared)
0x3e       4          float power                                # (sort 0; not cleared with the rest)

struct CharacterProfile 0x4c                                     # a pilot character (g_characterProfiles: the character profile data file's records,
                                                                 # the file's count of them: 9 in profeng.dat; indexed by a player's character. data_loadCharacterProfiles' stats check
                                                                 # walks 103 (0x67 = the version word - 0x115c), so its reach overlaps g_netSlots)
0          0x10       char name[16]
0x10       0x10       char corporation[16]
0x20       4          i32 sex                                    # MSG(545) + it: 1 MALE, 2 FEMALE (the SEX row)
0x24       4          i32 age                                    # the AGE row
0x28       0x24       i32 stats[9]                              # percentages, the CHARACTER SELECT rows MSG(536 ..): [0] BULLET.LV, [1] ENERGY.LV, [2] BOMB.LV, [3] MELEE.LV (the weapon groups' damage: actor_takeDamage, the ARM CENTER's bonus), [4] MOBILITY, [5] SPEED (the legs': LEG()), [6] DEFENSE, [7] SCANNING, [8] MAX.LOAD ([4] .. as character_factor / SKILL(k): stats[4 + k] x 0.01 + 1); [7] at most 50, the others 30 (else 0)
                                                                 # ARM CENTER factors x 0.01), [5] the legs'; [7] at most 50, the others 30

struct GamePacket 0x40                                          # match packet kind 1, a player's game state (net_sendGamePacket; read by net_processGamePacket)
0          1          u8 number                                  # the packet layer's number
1          1          u8 kind                                    # 1
2          1          u8 player
3          1          signed char map                            # the rotation's map and mode, now and next (0xff: none)
4          1          signed char nextMap
5          1          signed char mode
6          1          signed char nextMode
7          2          short mapNumber                           # Scene.mapNumber (the map's own number; a receiver on the same map (g_mapIndex == map) with another number has data loss, dataLossCode 1)
9          4          i32 elapsed                                # the match clock (Scene.elapsed, clockFraction)
0xd        4          float clockFraction
0x11       4          i32 timePlayed                             # the player's (Player.timePlayed, timeFraction)
0x15       4          float timeFraction
0x19       8          u32 resendAsked[2]                        # per player, a bit: [0] it is asked to send its info again (its sendFlags[2]: the receiver whose bit it is raises sendFlags[me][1], net_sendPlayerInfo), [1] its flag again (sendFlags[3]: the receiver clears its PlayerRecord.flagSent)
0x21       2          short kills
0x23       2          short deaths
0x25       4          short teamScores[2]
0x29       2          short lastPickup                             # the stage's (-1 none)
0x2b       1          u8 checkTable                             # the part type table checked (typeCheckTurn % 5: 0 headTypes, 1 chestTypes, 2 armTypes, 3 legTypes, 4 boosterTypes), and a sample of it (checkIndex) with the entry there (checkValue): a mismatch is data loss, code 2
0x2c       2          u16 checkIndex                            # a random word (table_rand() % 100000, cut to 16 bits) picking the entry: row (w / perRow) % count, column w % perRow (sample / table_ok)
0x2e       4          u32 checkValue
0x32       2          u16 checkIndex2                           # the same for the item table (actorItems, actorItemCount; perRow typeTablePerRow[5]): a mismatch is data loss, code 3
0x34       4          u32 checkValue2

struct PlayerRecordPacket 0x36                                  # the player's Ladder record sent to the game server (g_netPlayerRecordPacket, packet 0x11: lobby_states.c record_send)
0          0x1e       char name[0x1e]                            # the Ladder name (written only when asked)
0x1e       4          i32 games                                 # Ladder rounds played (g_ladderGames: one more at a Ladder match's first round, each next round and each restart)
0x22       4          i32 kills
0x26       4          i32 deaths
0x2a       4          i32 exp   
0x2e       4          i32 level                                 # actor_levelFromValue(exp): the level (1 .. 20) the Ladder exp (g_ladderExp) reaches
0x32       4          float power

struct PilotStats 0x20                                          # a pilot's standing (g_pilotLevel .., kept as g_pilotLevelKept ..: lobby_states.c take_back)
0          4          i32 level
4          4          i32 exp   
8          4          i32 rank                                  # its place in the ranking (message 29's reply +0x16; 0 out of the first 1000: the account panel shows OUT OF RANK(1000))
0xc        4          float power                               # the kill rate x 0.01 x the exp (power_from_rate); shown "%.2f" on the account panel
0x10       4          i32 games                                 # Ladder rounds played (reply +0xf3; g_ladderGames)
0x14       4          i32 kills
0x18       4          i32 deaths
0x1c       4          float killRate

struct SkirmishInfo 0x5c                                        # a skirmish map's play settings (g_skirmishInfo, 15 of them: read by files.c)
0x4c       4          i32 gameMode                              # the round's game mode (skirmish.dat: 0 DEATH MATCH, 1 TEAM DEATH MATCH, 2 SUDDEN DEATH = MSG(471) + this): the skirmish screen's GAME TYPE line; skirmish_startRound -> g_chosenGameMode
0x50       4          i32 timeLimit
0x54       4          i32 fragLimit

struct ViewQuad 0x5c                                            # a queued quad or billboard (ViewVolume.quads; view_volume.c quad_fields)
0          4          i32 texture                                # (none: negative; then no texture corners)
4          8          float uv0[2]                                # one corner's texture coordinates (u, v), for points[3]; billboard() gives points[2] (uv1[0], uv0[1]) and points[0] (uv0[0], uv1[1])
0xc        8          float uv1[2]                                # the opposite corner's texture coordinates (u, v), for points[1] (see uv0)
0x14       4          u32 colour
0x18       0x40       float points[4][4]                         # its corners in clip space
0x58       4          i32 kind                                   # 2 / 3: depth-sorted into quadOrderA / B

struct ViewTriangle 0x60                                        # a queued clipped triangle (ViewVolume.triangles)
0x28       0x30       float points[3][4]                        # its corners in clip space; for kind 1 (ViewVolume_addTriangle's raw 1) the points as given with w 1, drawn under its matrix
0x58       4          u32 matrix                                 # the matrix it is drawn under (kind 1)
0x5c       4          i32 kind                                   # 2: depth-sorted (triangleOrder)

struct ViewVolume 0x9170                                        # the view volume: what a frame draws, queued by material and depth (view_volume.c, factors.c; 0x9170 bytes: ViewVolume_clear clears 0x245c dwords; only the fields used)
4          4          i32 blockSize                             # its lists' memory (ViewVolume_initBy)
8          4          u8 *block
0xc        4          i32 ownsBlock                              # 1: allocated here (freed with it)
0x14       0xc        void *glArrays[3]                         # glVertexPointerEXT / glColorPointerEXT / glTexCoordPointerEXT (wglGetProcAddress with GL_EXT_vertex_array; 0: draw_opaque uses the GL 1.1 ones)
0x10       4          i32 entryPointsSet                        # set once its three GL entry points are looked up (+0x14 .. +0x1c); written, never read
0x20       0x3000     i32 materialOrder[3072]                   # the material lists in the order first queued (materialCount of them): each a list id, material + 1 (0: untextured, else the texture id + 1), the index into materialHeads / materialTails
0x3024     4          i32 materialCount
0x3028     0x3004     u8 *materialHeads[3073]                    # per material: its first queued entry (0: none yet)
0x602c     0x3004     u8 *materialTails[3073]                    # its last (entries are linked on from it)
0x9030     4          i32 entryLimit                            # the queued parts (0x1c bytes each)
0x9034     4          u8 *entries
0x9038     4          i32 entryCount
0x903c     4          i32 matrixLimit                           # the parts' matrices (0x40 bytes each)
0x9040     4          u8 *matrices
0x9044     4          i32 matrixCount
0x9048     4          i32 colourLimit                           # the colour buffer: room for so many vertices
0x904c     4          u8 *colours
0x9050     4          i32 colourMost                            # the most vertices the colour buffer held in this ViewVolume_draw (0 at its start; raised by fits()); never read otherwise
0x9054     4          i32 triangleLimit                         # the clipped triangles (0x60 bytes each)
0x9058     4          u8 *triangles
0x905c     4          i32 triangleCount
0x9060     4          u8 *triangleOrder                         # (record, depth) pairs sorted back to front
0x9064     4          i32 triangleOrderCount
0x9068     4          i32 quadLimit                             # the quads and billboards (0x5c bytes each)
0x906c     4          u8 *quads
0x9070     4          i32 quadCount
0x9074     4          u8 *quadOrderA                            # sorted quads of kind 2
0x9078     4          i32 quadOrderACount
0x907c     4          u8 *quadOrderB                            # ... of kind 3
0x9080     4          i32 quadOrderBCount
0x9084     4          i32 segmentLimit                          # the coloured lines (0x24 bytes each: a packed RGBA colour, then two clip-space points; ViewVolume_addSegment: the debug grid in red, the map lights' yellow stars), drawn by ViewVolume_draw as GL_LINES
0x9088     4          u8 *segments
0x908c     4          i32 segmentCount
0x9090     4          i32 entriesFull                           # 1: a list overflowed (what did not fit is left out); cleared by ViewVolume_reset; set, never read
0x9094     4          i32 matricesFull
0x9098     4          i32 trianglesFull
0x909c     4          i32 quadsFull
0x90a0     4          i32 segmentsFull
0x90a4     4          i32 trianglesDrawn                              # draw counters (cleared by ViewVolume_clearDrawCounts: by ViewVolume_initBy, and by match_drawFrame each match frame - so per frame only in a match; outside one they keep counting); counted up, never read
0x90a8     4          i32 meshesDrawn
0x90ac     4          i32 textureBinds
0x90b0     0x40       float projection[16]
0x90f0     0x40       float modelview[16]
0x9130     0x40       float clip[16]                            # projection x modelview: points to clip space

struct Skeleton 0x24                                            # a skeleton (skel_data.c): its 0x24-byte header and the block its bones and their tables are in
4          4          i32 blockSize
8          4          u8 *block                                 # its bones (from the start) and their key tables
0xc        4          i32 ownsBlock                             # 1: allocated here (freed with it)
0x10       4          i32 boneCount
0x14       4          u8 *bones                                 # boneCount Bone records
0x18       4          i32 posKeyTotal                           # its bones' position keys summed (the .ske header's; counted by skel_loadAseFrom for an ASE file, with rotKeyTotal sizing the block)
0x1c       4          i32 rotKeyTotal                            # its rotation keys
0x20       4          i32 duration                              # its animation's length in milliseconds (ASE: SCENE_LASTFRAME x (1000 / SCENE_FRAMESPEED); Skeleton.dat: 3300 = 100 frames at 33 ms, 1650 for some weapons); the key times are in the same units; skel_getBoneMatrix's t (0 .. 1) and anim_setTime scale it, ObjectList_poseBones takes animTick % (duration + 1)

struct Bone 0x70                                                # a skeleton's bone (Skeleton.bones)
0x40       4          i32 parent                                # its parent bone (< 0: the root)
0x44       0xc        float pos[3]                              # its position without keys
0x50       0x10       float rotation[4]                         # its rotation without keys: angle (radians), then axis
0x60       4          i32 posKeyCount                           # position keys, 0x20 bytes each: time, length (ms), base, delta
0x64       4          u8 *posKeys
0x68       4          i32 rotKeyCount                           # rotation keys, 0x28 bytes each: time, length (ms), base angle + axis, delta angle + axis
0x6c       4          u8 *rotKeys

struct PosKey 0x20                                              # a bone's position key (Bone.posKeys)
0          4          i32 time                                  # the time it starts at, in milliseconds (whole frames x 1000 / FRAMESPEED, as Skeleton.duration)
4          4          i32 length                                # milliseconds to the next key (0: the last)
8          0xc        float pos[3]
0x14       0xc        float delta[3]                             # to the next key's position

struct RotKey 0x28                                              # a bone's rotation key (Bone.rotKeys)
0          4          i32 time                                  # the time it starts at, in milliseconds (as PosKey.time)
4          4          i32 length                                # milliseconds to the next key (0: the last)
8          0x10       float rotation[4]                         # its rotation: angle (radians), then axis (from the ASE, combined with the ones before)
0x18       0x10       float step[4]                              # the rotation to the next key (angle, axis)

