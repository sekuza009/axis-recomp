0x43664    0x7d0      u8 headSkelData[0x7d0]                          # headSkels' block (stage_build: model_sets): 2 name nodes and skeletons (0x70 bytes each), then 0x6f0 bytes of skeleton data
0x43e34    0x130      SkelManager chestSkels                # its skeletons (SkeletonManager_initBy over the data after it)
