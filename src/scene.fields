                                                                 # (SpaceBlock.items) and a unit's planes (SpaceUnit.lastNode); a list runs from its
                                                                 # head, the newest, through next
0          4          u8 *item                                   # what it holds (a unit's: its planes; their first byte flags, 1: skipped)
4          4          u8 *block                                  # (a block's items) the block
8          4          struct SpaceNode *newer                    # the one put in after it (also the free list's link)
0xc        4          struct SpaceNode *next                     # the one put in before it

