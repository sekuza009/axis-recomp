0xe4       4          i32 quadTexture                            # (by use) kind 50, a quad: its texture, two texture corners, colour, points
0xe8       8          u32 quadUv0[2]
0xf0       8          u32 quadUv1[2]
0xf8       4          u32 quadColour
0xfc       0x30       float quadPoints[4][3]
4          4          i32 active                                # 1: in use

