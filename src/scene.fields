# The game's record types and the scene object. tools/mkscene.py turns this into scene.h: packed structs with
# padding between the known fields and a compile-time check of every offset. Sections start with
# "struct Name size"; fields are "offset  size  declaration  # comment". Add fields as rebuilds need them.

struct MessageSlot 0x14                                         # a map script's message waiting in the box (Scene.msgRing = Stage.messages; command 26 MESSAGE)
0          4          i32 speaker                               # its speaker (Stage.speakers; script_processCommand checks it exists); written, never read (hud_drawMessageBox shows only text and colour)
4          4          u32 text                                  # its text block in Scene.msgText
8          4          i32 colour                                # index into g_textColours (signed compare: < 16 used); 16 and up: the text drawn transparent (white, alpha 0)
0xc        4          i32 unusedC                               # command 26's fourth argument (script_pushMessage); never read (hud_drawMessageBox reads +4 and +8 only)
0x10       4          i32 unused10                              # the same argument again; never read

struct EventLine 0x108                                          # one line of the event list (Scene.events)
0          4          u32 type                                  # 0..5: the colour
4          0x100      char text[0x100]
0x104      4          float timeLeft                              # seconds it stays shown: Scene.eventTime (60.0) when written, counted down by events_age, which drops the oldest line once it is <= 0 (or NaN)

struct FiredRound 0x28                                          # a round as fired (Player.rounds; bullet_spawn / bullet_init take it)
0          4          i32 received                               # (by use; seen running) 0: fired here; 1: another machine's (its hit known)
4          4          i32 weapon                                 # its item (ActorItem index)
8          0xc        float from[3]                              # where it starts (the muzzle)
0x14       4          i32 hitPlane                               # a received round's collision plane (-1 none)
0x18       0xc        float dir[3]                              # fired here (received 0): the aim direction (the muzzle's +z); received: the point sent (ShotRecord.point): bullet_init aims at it and ends the round there (end = it, life 10)
0x24       4          u32 muzzle                                # the muzzle entry's matrix (&ListedObject.matrix of the weapon model's entry given at ItemModelSet +0x15a8 + variant x 0x40; Bullet.muzzle takes it)

struct ShotRecord 0x20                                          # a round an actor fired, as sent (Player.shots)
0          4          i32 inUse                                 # 1: the slot carries a round this packet (its slot's flag bit 1; 0 also for a teamless actor); actor_processFrame's received path skips the others
4          4          i32 isNew                                 # 1: a new round: the local actor's not yet announced (net_sendPlayerState sends flag 3 and clears it); a received one's bullet still to be made (actor_processFrame makes it and clears it)
8          4          i32 hitActor                              # the actor the sender's round hit (packet flag 4; -1 none): the bullet's hitActor
0xc        4          i32 hitPlane                              # the collision plane the sender's round hit (index into space.planes; -1 none or an actor hit): the bullet's hit, and a new round's FiredRound.hitPlane
0x10       4          i32 ended                                 # 1: the sender's round has run its life (age > life; packet flag 8): the bullet's life is set to age - dt so it ends this frame
0x14       0xc        float point[3]                            # the round's position as sent (its end when finished at a surface, else its pos; tenths decoded): the bullet's netPoint and end, a new round's FiredRound.dir

struct ItemModelSet 0x16bc                                      # an item's models, per variant (ActorItem.sets: [0] in hand / slot 4, [1] slot 5)
0          0xc        i32 shapeCount[3]                         # per variant (Player.variantLoaded): the shapes (ObjectList_load's ns) ..
0x90c      0x990      u8 shapeNames[3][0x330]                 # .. their names (0x44 apart: a name and its bone's translation scale, a float: ListedObject.scale) ..
0x129c     0xc        i32 skelCount[3]                          # .. the skeletons ..
0x1428     0x180      u8 skelNames[3][0x80]                   # .. and their names (0x40 apart; actor_loadWeapon)
0x1674     0x24       float muzzle[3][3]                         # the muzzle (muzzle_camera)
0x1698     0x24       float grip[3][3]                           # where the actor holds it (actor_processFrame: hold)

struct ActorItem 0x2e18                                         # an item record: a weapon or special item (Stage.actorItems; Component.dat's sixth table, "read ActorItemInfo")
0x40       0x2d78     ItemModelSet sets[2]                       # its models (actor_loadWeapon, actor_processFrame, muzzle_camera): [0] in hand and in slot 4, [1] in slot 5
0x2dd0     0xc        float burstStep[3]                        # the offset between rounds fired in the same frame: round n of the frame's rounds starts (n % burst) x this from the muzzle, in the muzzle's frame (actor_processFrame); only POD-200, AFA-210 and AFA-70A have one, and their burstGap spreads bursts over frames
0x2db8     4          float weight                              # WEIGHT (an item's): added to the actor's load (mech_stats; not in game types 2 .. 11), shown in the ARM CENTER
0x2dbc     4          i32 slotType                               # (the ARM CENTER's SLOT TYPE: message 321 + this, "HAND" ..)
0x2df8     4          i32 splashBorderDamage                    # SPLASH BORDER DAMAGE (ARM CENTER, message 312); only shown: the splash damage is half at the border (weapons.c)
0x2ddc     4          i32 damageType                            # DAMAGE TYPE (ARM CENTER; MSG(327) + this: 0 IMPACT, 1 ENERGY). 0: the shield takes the damage, the excess the armour; 1: the armour also loses 0.7 x it while the shield holds, then the excess plus 0.7 x what the shield took (actor_takeDamage)
0x2de0     4          i32 damage                                 # a hit's damage
0x2e04     4          i32 hitSound                               # its hit sound (< 0 none)
0x2e14     4          float push                                 # > 0: a hit pushes the actor (x 10, away from the bullet)
0x2dc0     4          i32 ammoType                              # BULLET TYPE (ARM CENTER; MSG(323) + this: 30mm, 60mm, E-PAK, ROCKET): the ammunition it uses (index into Player.ammo); -1: a special item, not a weapon
0x2dc4     4          i32 ammoPerShot                           # BULLET CONSUMPTION (ARM CENTER, message 303): ammunition one shot takes (actor_processFrame, weapons.c); for a special item (ammoType -1) the ARM CENTER shows MSG(745) + its actorItems index instead (772 .. 780: its description lines; armc_viewedPartRecord)
0x2dc8     4          i32 burst                                 # rounds a burst
0x2dcc     4          float burstGap                            # seconds between a burst's rounds (0: all at once; actor_processFrame)
0x2de4     4          float range                               # SHOOTING RANGE (ARM CENTER, message 307; shown x0.01 m): bullet_init traces from the muzzle this far along the direction (end; the hit found) and gives the round life = this (or the hit's distance) / velocity
0x2de8     4          float velocity                            # its speed (0: it arrives at once)
0x2dec     4          float spread                              # DISPERSION ANGLE (ARM CENTER, message 309; tenths of a degree, shown x0.1): bullet_init spreads aimed shots by (this - the owner's accuracy x 10) x K(0x4aa448) (none below 0)
0x2df0     4          float hitRange                            # HIT RANGE (ARM CENTER, message 310; shown x0.01 m): added to an actor's radius for a round's hit test (fly_local: math_segmentSphere), a beam's half-width (shotMode 7), the size of its flash, flight, impact and mark particles
0x2df4     4          float splashRadius                        # SPLASH DAMAGE RANGE (ARM CENTER, message 311; shown x0.01 m): once the round hits anything (struck: also set by hit_actor), the local machine's other live actors within this of its point take damage x (1 - d / this / 2) and the push likewise (splash, weapons.c); a bot holding it swaps weapons rather than fire at a target closer than this (actor_processFrame)
0x2dfc     4          i32 shotMode                              # the round's kind: particle kinds this + 10 (muzzle flash), + 0x14 (in flight; 3 a trail, 7 a beam instead), + 0x1e (impact), + 0x28 (surface mark), passed to actor_takeDamage; 3 also: fired into a random cone 8.1 degrees off the aim, and homing with speed and turn rate by age (home)
0x2e00     4          i32 sound                                 # its firing sound (< 0 none)
0x2e08     4          float cycleTime                           # seconds a firing cycle
0x2e0c     4          float guidance                            # GUIDANCE (ARM CENTER, message 314; tenths of a degree, shown x0.1): > 0 a guided round: every 1/15 s home() turns it by at most this toward its target / the local player's aim point (shotMode 3: this / (age + 1)^3)
0          0x40       char name[0x40]                           # the folder under Actor/
0x2e10     4          float targetingTime                       # TARGETING TIME (ARM CENTER, message 315; seconds, shown x1000 ms): the lock on an enemy is made once its aimTime passes the local player's lockOnTime x this (actor_processFrame); > 0: a lock-on weapon (aimTime counted, stage_setupView; the HUD ring)


struct BlockOwner 0x10                                          # the head Model, Manager, SkelManager and ObjectList share: their data block (take_block)
4          4          i32 blockSize
8          4          u8 *block
0xc        4          i32 ownsBlock                              # 1: allocated here (freed with it)

struct Model 0x4c                                               # a shape (skel_data.c: its 0x34-byte file header, then its box; a map object's model, an object list's entries...)
4          4          i32 blockSize                              # its data block (take_block): the parts and their tables
8          4          u8 *block
0xc        4          i32 ownsBlock                              # 1: allocated here (freed with it)
0x10       4          i32 partCount
0x14       4          u8 *parts                                  # partCount ShapePart records (0x80 bytes), at the block's start
0x20       0xc        float centre[3]                           # its bounding sphere's centre: the middle of its vertices' box, from the file's header (all 1786 Shape.dat shapes); shape_computeBounds works it out for an old-format or OBJ file (its box then also holding the origin); shape_read / model_loadObjFormatFrom start the box from it
0x30       4          u32 version                                # 0x71110300: the current format (older: 0x68-byte parts)
0x34       0xc        float low[3]                               # the box over its parts
0x40       0xc        float high[3]
0x18       4          i32 colourCount                                 # dwords in a shading colour buffer for it: a .shp model's 3 x triangleCount (ObjectList_load, object_initObjectBy); Stage.layerModel / waterModel: their layers' point counts summed, (rows + 1) x (cols + 1) each (ground_buildLayerModels)
0x1c       4          i32 triangleCount                         # its triangles: a face 1, a quad 2 (model_loadObjFormatFrom, sizing the index lists); the .shp header's (colourCount / 3); cleared with colourCount (ground_buildLayerModels)
0x2c       4          float radius                              # its bounding sphere

struct ShapePart 0x80                                           # a shape's part (Model.parts): one material's vertices and primitives
0          4          u32 flags                                  # 1 transparent (drawn a triangle at a time, depth-sorted; its collision triangles get 0x10: no marks), 2 unlit (its own colours), 4 not culled, 8 front faces culled, 0x10 no depth test, 0x20 not in the collision space (space_buildUnit)
4          0x40       char texName[0x40]                         # its texture's name ("Shape\alien\add01"; tex_getIdByName; shape_bindTextureBy appends "*<dir>"; the OBJ loader writes the material's last "_" piece)
0x44       4          i32 texture                               # its texture's id (bank x 512 + index: tex_getIdByName via shape_bindTextureBy); -1 none (shape_read, the OBJ loader's usemtl parts); 0 is a real id (bank 0's first)
0x48       4          i32 colourBase                             # its first vertex in the shape's colour buffer
0x4c       4          i32 vertexCount
0x50       4          u8 *vertices                               # 12 bytes each
0x54       4          u8 *normals                                # 12 bytes each
0x58       4          u8 *colours                                # 4 bytes each
0x5c       4          float *texCoords                           # 2 floats each
0x60       4          i32 primCount
0x64       4          u8 *prims                                  # ShapePrim records (0xc bytes)
0x68       0x18       float box[6]                               # its low and high corners

struct ShapePrim 0xc                                            # a part's primitive: its index list
0          4          i32 kind                                  # its GL primitive: 6 a fan, 5 a strip, 4 a triangle list (0 GL_POINTS: 79 prims in nameless NITRO parts, skipped by the collision space)
4          4          i32 indexCount
8          4          u8 *indices                                # 4 bytes each

struct ListedObject 0x64                                        # an object list's entry (ObjectList.entries)
0          4          Model *shape                              # none: an empty entry
8          4          u32 *colours                              # its shading colours (Model.colourCount dwords in the list's block): a pre-lit list's only (ObjectList_load; 0 otherwise or without a shape)
4          4          float scale                               # its bone's translation scale: the float after its name in the type's name record (ObjectList_load); ObjectList_poseBones multiplies the bone's position by it
0xc        0x40       float matrix[16]                          # where it is placed
0x4c       0xc        float pos[3]                              # its bone's origin placed: (0, 0, 0) through matrix, the matrix's translation (ObjectList_poseBones); without a shape, centre is copied from it
0x58       0xc        float centre[3]                            # its shape's centre placed (pos without a shape)

struct ObjectList 0x30                                          # shapes placed by their own matrices (ObjectList_relight, ObjectList_queue): the game's UnitPoseInfo class (vtable
                                                                 # 0x4a9754 at +0; its entries follow it where it is embedded, Player's part lists; its full size is unknown)
4          4          i32 blockSize                             # its block: the entries (100 bytes each), their colours when preLit, the skeletons (ObjectList_load)
8          4          u8 *block
0xc        4          i32 ownsBlock                              # 1: allocated here
0x10       4          i32 count
0x14       4          ListedObject *entries
0x18       4          i32 colourCount                            # the entries' shapes' colours summed
0x1c       4          i32 skelCount                             # its skeletons (animations; ObjectList_load's nk, by name from the skeleton cache); 0: not posed (ObjectList_poseBones) nor drawn (ObjectList_queue)
0x20       4          struct Skeleton **skeletons                      # skelCount Skeleton pointers (in the block after the entries' colours); skeletons[skel] == 0: nothing posed or drawn
0x24       4          i32 skel                                  # the skeleton (animation) in use: index into skeletons (anim_setTime; actor_processFrame always picks 0)
0x28       4          i32 animTick                              # the animation's time in milliseconds (anim_setTime: the skeleton's duration x a 0 .. 1 fraction; ObjectList_poseBones takes this % (duration + 1))
0x2c       4          i32 preLit                                # 1: lit here, drawn with its own colours

struct Player 0x8888                                            # a player's record (Scene.players)
0x8848     4          float pathRange                            # (by use; seen running) how far a bot looks for path points (1500, x1.5 while none is found)
0x3a8      0x40       float bodyMatrix[16]                       # (by use; seen running) the body's matrix (GL modelview at the actor, turned and leant: the chest's bones posed from it)
0x554      0x30       ObjectList headModel                       # (by use; seen running) the posed part models (ObjectList each, their entries following inside): the head (on the chest's neck joint; x5 with stateFlags 0x1000)
0x584      0x7d0      u8 headModelMem[0x7d0]                    # its block's memory: the entries (100 bytes each), then the skeleton pointers (ObjectList_load's mem; its size the limit)
0xd54      0x30       ObjectList chestModel                     # the chest: posed at bodyMatrix; its joints carry the legs, arms, head and booster (ChestType.legsJoint .. boosterJoint)
0xd84      0x7d0      u8 chestModelMem[0x7d0]                   # its block's memory: the entries (100 bytes each), then the skeleton pointers (ObjectList_load's mem; its size the limit)
0x1554     0x30       ObjectList armsModel                       # the arms: carry the weapon models
0x1584     0xfa0      u8 armsModelMem[0xfa0]                    # its block's memory: the entries (100 bytes each), then the skeleton pointers (ObjectList_load's mem; its size the limit)
0x2524     0x30       ObjectList legsModel                       # the legs (their frame from pose[4])
0x2554     0xfa0      u8 legsModelMem[0xfa0]                    # its block's memory: the entries (100 bytes each), then the skeleton pointers (ObjectList_load's mem; its size the limit)
0x34f4     0x30       ObjectList boosterModel                    # the booster (pose[5]: run)
0x3524     0xbb8      u8 boosterModelMem[0xbb8]                 # its block's memory: the entries (100 bytes each), then the skeleton pointers (ObjectList_load's mem; its size the limit)
0x40dc     0x30       ObjectList weaponModel                     # the weapon in hand (slots 0 .. 3)
0x410c     0x1770     u8 weaponModelMem[0x1770]                 # its block's memory: the entries (100 bytes each), then the skeleton pointers (ObjectList_load's mem; its size the limit)
0x587c     0x30       ObjectList weaponModel4                    # the slot-4 weapon
0x58ac     0x1770     u8 weaponModel4Mem[0x1770]                # its block's memory: the entries (100 bytes each), then the skeleton pointers (ObjectList_load's mem; its size the limit)
0x701c     0x30       ObjectList weaponModel5                    # the slot-5 weapon
0x704c     0x1770     u8 weaponModel5Mem[0x1770]                # its block's memory: the entries (100 bytes each), then the skeleton pointers (ObjectList_load's mem; its size the limit)
0x4bc      4          i32 lastHitMode                                # (by use; seen running) the last hit's mode (0 armour first, 1 shield first)
0x880c     4          i32 invulnerable                          # 1: hits do nothing (actor_takeDamage returns at once; script command 14 sets it, 12 and the spawn reset clear it)
0x8850     4          i32 hitPending                             # (by use; seen running) 1: a hit to send (net_sendPlayerState, then cleared)
0x24       4          i32 accuracy                                    # (by use; seen running) the arms' stats[0]: a shot's spread (ActorItem.spread, tenths of a degree) is the weapon's less 10 x this, at least 0 (bullet_init, weapons.c)
0x144      4          i32 lastWeaponSlot                         # (by use; seen running) the last of slots 0 .. 3 selected (its part shown again: actor_setWeaponSlot)
0x1f8      0xa0       ShotRecord shots[5]                        # (by use; seen running) its rounds as sent (another machine's actor: netFired)
0x298      0xc8       FiredRound rounds[5]                           # (by use; seen running) its rounds' records (ResourceSets: actor_checkDataLoss builds them; actor_processFrame fills one as each round fires)
0x360      0x14       i32 shotBullets[5]                         # the bullets they made (-1 none)
0x4a0      4          i32 firePrev                               # (by use; seen running) the fire key the frame before (a held key fires one round)
0xe0       4          i32 levelShown                             # (by use; seen running) the level last announced ("LEVEL UP!" when the grade passes it)
0xf8       4          i32 scoreCounted                          # the score already added to the Ladder record's exp (g_ladderExp; ladder_addMatchScores); set with score at the match start
                                                                 # title's points: ladder_addMatchScores)
0x374      4          i32 sendNow                               # 1: its state is sent this frame (one of its rounds ran out of life; net_sendPlayerState); cleared each frame
0x8868     4          i32 killPending                           # 1: it died (actor_dies); the match frame reports the kill (msg_kill with lastAttacker) and clears this
0x538      4          i32 lastWarp                               # (by use; seen running) the warp zone (item) it came through last (-1 none: not kept off it)
0x53c      4          i32 onWarp                                 # 1: touching a warp zone this frame
0x540      4          float warpWait                             # seconds before it can warp again (2)
8          4          i32 hackingLevel                           # (the ARM CENTER's HACKING LEVEL) a cloaked actor (stateFlags 0x200) is seen by those whose level is above its own
0xc        4          float lockOnTime                          # (the ARM CENTER's LOCK-ON TIME: the head's x lockOnTimeFactor) x the weapon's targetingTime: seconds a target must stay in the lock-on cone (its aimTime) before the lock is made
0x10       4          float targetKeepTime                       # (the ARM CENTER's TARGET KEEP TIME) seconds a lock-on holds once out of reach
0x14       4          float loadMax                              # (by use; seen running) the weight carried without slowing: the chest's weightLimit x the pilot character's MAX.LOAD factor x the items' loadFactor (mech_stats)
0x18       4          float load                                # the head's, arms', legs' and booster's weight, plus the six items' outside game types 2 .. 11 (the chest's not counted: it gives loadMax); over loadMax: mobility, speed and runTop cut by 4 x the overload fraction (mech_stats)
# the items' bonuses (actor_computeStats: item kinds 0x1b .. 0x23)
0x404      0x10       float ammoFactor[4]                        # x the arms' ammunition, per kind
0x414      0x10       i32 ammoBonus[4]                           # + rounds, per kind
0x424      4          float rangeBonus                           # + the detection range (mech_stats: added to the head's detectionRange x the pilot's factor before it is squared into detectionRangeSq)
0x428      4          float lockOnTimeFactor
0x42c      4          float targetKeepFactor
0x430      4          i32 hackingBonus
0x434      4          float boostTimeFactor
0x438      4          float rechargeTimeFactor
0x43c      4          float restTimeFactor
0x440      4          float loadFactor
0x444      4          float shieldFactor
0x4f0      4          u8 tint[4]                                 # (by use; seen running) its tint (r g b a: a cloaked actor's; alpha <= 0x10 also lights it faintly)
0x4f4      0x40       char message[0x40]                         # (by use; seen running) a message for the local player ("OUT OF AMMO!")
0x534      4          float messageTime                         # 0 on the frame a message is set (item_pickup, the warp; OUT OF AMMO! sets it to the frame time, taken off later that frame): that frame the local player's message is printed and its state sent (net_sendPlayerState); then the frame time is taken off each frame; -10000 at setup
0x124      4          float dropAge                             # the spawnAge past which the actor is dropped (actor_deactivate): kept 10 s ahead while it is alive and run here or heard from (each network state), so a silent network copy goes after 10 s; 1 at setup; a dead one's (state 3) spawnAge is set to it, so it goes the next frame
0x4a4      4          float effectScale                          # (by use; seen running) the emitters' scale by the speed (0.5 .. 3)
0x4d0      4          i32 cheat                                 # a cheat to apply this frame (-1 none): 2 / 3 big head on / off, 4 suicide; set only by chat_matchCheatCode (the local player's typed chat, codes 2 .. 4). Cases 0 (armour and shield refilled) and 1 (ammunition refilled) are handled but never set
0x4d4      4          i32 bigHead                               # 1: its head drawn five times larger (cheat 2 on, 3 off; sent as state bit 0x1000)
0x8800     4          i32 pathReverse                            # (by use; seen running) 1: the path is followed backwards
0x8804     4          float botWait                             # seconds a bot stays put (script command 4; counted down by actor_processFrame; it still aims and fires)
0x8808     4          i32 botWaitTrigger                         # (by use; seen running) a trigger a bot waits for (-1 none)
0x8810     4          i32 lookActor                              # (by use; seen running) the actor a bot looks at (-1 none)
0x8814     4          i32 lookPath                               # the path whose point it looks at (-1 none)
0x8818     4          i32 lookPoint
0x8824     4          float scanTime                             # (by use; seen running) a bot looks for a target every half second
0x8828     4          float burstPause                           # (by use; seen running) seconds to the next burst (botParams[3])
0x882c     4          float burstFire                            # seconds of the burst left (botParams[4])
0x8830     4          float dodgeTime                            # (by use; seen running) seconds to the next sideways step (botParams[0])
0x8834     4          float heightTime                           # seconds to the next height change (botParams[1])
0x8838     0xc        float cleared8838[3]                       # (by use; seen running) only zeroed (actor_setupFromParts); nothing else reads or writes it
0x8844     4          float lookTime                             # (by use; seen running) seconds to the next random look (2)
0x886c     4          float stuckTime                            # (by use; seen running) the path checked every second: moved under 500 -> dropped
0x8870     4          i32 stuckPath                              # the path dropped
0x8874     0xc        float stuckMove[3]                         # the moves summed over the second
0x38       4          float mobility                             # (the ARM CENTER's MOBILITY) how fast the movement keys ramp (a second)
0x3c       4          float moveAccel                            # the velocity's change towards the keys' (a second)
0x40       4          float boosterTilt                         # how far the booster tips with the aim's pitch (BoosterType.lean): pose[1] = (1 - climb) x (pitch + 900) / 1800 x this, the booster joint's x rotation; 0.0 in every booster of Component.dat
0x44       4          float boostTime                            # (by use; seen running) seconds of running the energy lasts
0x48       4          float rechargeTime                         # seconds the energy takes to refill
0x4c       4          float restTime                             # seconds of rest after running
0x54       0x10       float runTop[4]                            # (by use; seen running) the top speeds running: forward, back, step left, step right (the left-step key, A, drives nextStrafe toward [2]: key_axis)
# the motion state: this frame's (pos .. fireAnim, from the next one each frame: actor_frame.c), the next one
# (nextPos .. fireCycle: the keys', or moved towards the sent one), the sent one (netPos .. netMotion)
0x168      4          float forward                              # (by use; seen running) forward speed (-1 .. 1, more running)
0x16c      4          float strafe                               # sideways speed
0x170      4          float climb                                # 0 .. 1: going up (the altitude key)
0x174      4          float lean                                 # (by use; seen running) the body's lean forward (degrees x 10: from the speed and pitch)
0x178      4          float run                                  # 0 .. 1: running (the booster key)
0x180      0xc        float nextPos[3]
0x18c      4          float nextPitch
0x190      4          float nextYaw
0x198      4          float nextStrafe
0x19c      4          float nextClimb
0x1a0      4          float nextLean
0x1a4      4          float nextRun
0x1ac      0xc        float netPos[3]                            # (by use; seen running) the state last received (another machine's actor)
0x1b8      4          float netPitch
0x1bc      4          float netYaw
0x1c0      0x14       float netMotion[5]                         # forward, strafe, climb, lean, run
0x1d4      0xc        float botGoal[3]                           # (by use; seen running) where a bot goes
0x1e0      4          float botLookPitch                         # (by use; seen running) the pitch a bot turns to
0x1e4      4          float botLookYaw
0x1e8      4          i32 netFired                               # (by use; seen running) 1: rounds received this frame (fired by the others' copy)
0x1ec      4          i32 firing                                 # (by use; seen running) 1: firing this frame
0x378      0xc        float velocity[3]                          # (by use; seen running) moves towards the keys' (moveAccel)
0x384      0xc        float move[3]                              # (by use; seen running) this frame's move (nextPos - pos)
0x390      0x18       float pose[6]                             # (by use; seen running) the body's pose: [0] and [1] turn the booster (swing and tilt), [2] turns the legs; [3] .. [5] the arms', legs' and booster's animation frames (anim_setTime); nothing turns the head
0x3e8      4          float radius                               # (by use; seen running) its sphere against the others and the walls
