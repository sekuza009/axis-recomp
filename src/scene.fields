0x110      4          u32 source                                # where its skeletons load from: 0 / 1 loose .ske / .ase files, 2 the packed Data\\Skeleton.dat (skelDat_getItemFileBy); every caller passes 2
0x114      4          i32 capacity                              # items it has room for
0x118      4          u8 *nodes                                 # the name tree: one 0x4c-byte TreeNode per item
0x11c      4          u8 *items                                 # its skeletons (0x24 bytes each)
0x120      4          i32 count                                 # items loaded
0x124      4          i32 dataSize                              # the data memory items are read into
0x128      4          u8 *data
0x12c      4          i32 dataUsed
struct PlayerRecord 0x47fd2                                      # a player of the match (Scene / Stage playerRecords): its team, mech parts and items; its actor points back (Player.player)
0          4          i32 used                                   # (by use; seen running) 1: in use (playerRecord_markUsed / markFree)
0x479a4    0xa        signed char partHue[5][2]                 # (by use; seen running) per part its two tints' hue (playerRecord_setPartColour; bytes)
0x479ae    0xa        signed char partSaturation[5][2]          # per part its two tints' saturation x 128, kept to -1 .. 0.999 first (playerRecord_setPartColour: level_byte), a signed byte; sent in packet 2 (net_sendPlayerInfo, 30 bytes from partHue) and read back signed (playerRecord_applyNetColours: x k_0_0078125f)
0x479b8    0xa        signed char partValue[5][2]               # per part its two tints' value (brightness) x 128, kept to -1 .. 0.999 first (playerRecord_setPartColour: level_byte), a signed byte; sent in packet 2 (net_sendPlayerInfo) and read back signed (playerRecord_applyNetColours)
0x479c2    0x600      u32 flag[16][24]                         # (by use; seen running) its flag: 24 x 16 RGBA (the pilot's own picture, Save\<name>.BMP; drawn after its name and in the ranking)
0x47fca    4          i32 flagChanged                          # 1: to be copied into the flag atlas (flagShown: it is there)
0x47fce    4          i32 flagSent                             # (by use; seen running) its flag's pixels sent so far (0x180 = 24 x 16: all; the map's players start with all)
4          0x40       char name[0x40]                            # (by use; seen running) its name (its screenshot: Save\\<name>.BMP)
0x44       4          i32 character                              # its pilot character (g_characterProfiles: the skills and damage factors by it)
0x48       4          i32 team
0x4c       0x140      char partNames[5][0x40]                   # its parts' type names (head, chest, arms, legs, booster: copied from the part type record by set_part / actor_setActorType*InfoBy; cleared by player_clear); written, never read
0x18c      0x180      char itemNames[6][0x40]                   # its items' names (actor_setActorTypeItemInfoBy: the ActorItem's name, empty for none; cleared by player_clear); written, never read
