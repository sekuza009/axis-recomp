0x320      0x18       i32 items[6]                              # per item slot (Player.slot): its item (index into Stage.actorItems: a weapon or other hand / shoulder item; < 0 none; actor_setActorTypeItemInfoBy)
0x338      0x24c      Manager headShapes                     # (by use; seen running) its head type's shapes (model_sets: ShapeManager_initBy over the data after it)
0x584      0x7d00     u8 headShapeData[0x7d00]
0x8284     0x24c      Manager chestShapes                    # (by use; seen running) its chest type's shapes (model_sets: ShapeManager_initBy over the data after it)
0x84d0     0x7d00     u8 chestShapeData[0x7d00]
0x101d0    0x24c      Manager armShapes                      # (by use; seen running) its arm type's shapes (model_sets: ShapeManager_initBy over the data after it)
0x1041c    0xfa00     u8 armShapeData[0xfa00]
0x1fe1c    0x24c      Manager legShapes                      # (by use; seen running) its leg type's shapes (model_sets: ShapeManager_initBy over the data after it)
0x20068    0xfa00     u8 legShapeData[0xfa00]
0x2fa68    0x24c      Manager boosterShapes                  # (by use; seen running) its booster type's shapes (model_sets: ShapeManager_initBy over the data after it)
0x2fcb4    0x13880    u8 boosterShapeData[0x13880]
0x43534    0x130      SkelManager headSkels                 # its skeletons (SkeletonManager_initBy over the data after it)
0x43664    0x7d0      u8 headSkelData[0x7d0]
0x43e34    0x130      SkelManager chestSkels                # its skeletons (SkeletonManager_initBy over the data after it)
0x43f64    0x7d0      u8 chestSkelData[0x7d0]
0x44734    0x130      SkelManager armSkels                  # its skeletons (SkeletonManager_initBy over the data after it)
0x44864    0xfa0      u8 armSkelData[0xfa0]
