0x4dc      4          i32 isCommander                           # 1: its team's commander (Platoon: the most time; scene_updateRanking; YOUR COMMANDER .. HAS BEEN KILLED): the team's icon after its ranking row and over it

struct Factor 0x2c                                              # a light (LightFactors.records; factors.c builds them; shading.c's Light reads them)
0          4          i32 index                                  # its slot (factor_addFactorBy)
4          4          i32 used                                   # 1: in use
8          4          i32 kind                                   # 0 ambient, 1 directional, 2 a point light fading out over its radius, 3 a point light falling off with the distance squared
0xc        4          u32 colour                                 # packed RGBA
0x10       0xc        float pos[3]                              # a point light's position (kinds 2, 3)
0x1c       0xc        float dir[3]                              # a directional light's direction (kind 1)
0x28       4          float radius                              # a point light's reach (kinds 2, 3)

struct LightFactors 0xb010                                      # the light factors shape_shadingColours takes: vtable, 0x400 records, two counts, enabled (0xb010 bytes: the
                                                                 # size armc_drawPreview3D gives its stack copy, and the distance from Stage.dynamicLights to actorLights)
4          0xb000     Factor records[0x400]                     # its factors (LightFactors_read; 0x400 x 0x2c)
0xb004     4          i32 count                                  # records in use (a slot added when the next free is the count)
0xb008     4          i32 nextFree                               # the next free slot
0xb00c     4          i32 enabled                               # 1: a light was added (factor_addFactorBy) or read with the pool (LightFactors_read); never cleared. Only ObjectList_queue reads it: a pre-lit list is re-lit with these factors when it is 1 (or a tint is given)

struct MapObject 0x2cc                                          # a map object (Scene.objects): animated scenery
0x10       4          i32 trigger                               # x 100 (mapObject_frame): a proximity object's (flag 8) radius, a timed one's (flag 0x10) wait in seconds; 0 in every shipped map
0x14       4          i32 animPeriod                            # its animation's period in ms (anim_start passes it x 0.001 (forwards) or x -0.001 (backwards) as object_setAnimation's period: animRate = 1 / period)
0x298      4          float animTime                            # the animation's time, 0 .. 1 (mapObject_frame; skel_getBoneMatrix's t)
0x2a4      4          i32 poseStale                             # 1: its matrices to be taken from the pose again (mapObject_frame sets, uses and clears it)
0x2a8      4          float glow                                # a light's glow, 0 .. 1 (object_glow: up 4 a second while seen, down otherwise; the flare's alpha)
0x2ac      0x10       float clip[4]                              # its position projected (clip space)
0x2c8      4          float waitTime                            # a timed object's seconds waited (up to trigger x 100; mapObject_frame)
0          4          i32 id                                     # (by use; seen running) a serial (Stage.objectSerial)
8          4          i32 nameIndex                              # its type's name (Stage.objectNames); written, never read
0x18       0x40       char animPath[0x40]                        # its animation ("dir/map/name"; none: empty)
0x58       0xc        float place[3]                             # its position (the type record's)
0x64       0x10       float rotation[4]                          # a quaternion
0x74       0x40       float placeMatrix[16]                      # translation x rotation
0xb4       0x40       float placeInverse[16]                          # the inverse of placeMatrix (object_initObjectBy); relMatrix = matrix x placeInverse (object_initObjectBy, mapObject_frame)
0x134      0x40       float matrixInverse[16]                   # the inverse of matrix (world into the shape's own space): the shading (shape_shadingColours), the bounds tests of collision_moveSphere / collision_rayTrace
0x174      0x40       float animMatrix[16]                         # (by use; seen running) its skeleton's pose (bone 0, skel_getBoneMatrix; an identity without one)
0x1b4      0x40       float animInverse[16]                     # the inverse of animMatrix (identity at setup; mapObject_frame); written, never read
0x1f4      0x40       float relMatrix[16]                        # matrix x placeInverse
0x234      0x40       float relInverse[16]                            # the inverse of relMatrix (object_initObjectBy, mapObject_frame); handed with relMatrix to the collision tests of an animated object (collision_moveSphere, collision_rayTrace: nearObjects)
0x274      4          float glowSize                            # the glow flare's half-size (particle kind 4; objects with flag 1 while 3D items are on)
0x278      4          u32 glowColour                            # the glow flare's colour (RGB; its alpha from the glow)
4          4          i32 active                                # 1: in use
0xc        4          i32 flags                                 # ObjectType.flags: 1 a light (its glow and flare: object_glow, mapObject_frame), 2 not drawn and not re-shaded (stage_drawObject, mapObject_frame), 4 no collision unit (collision_initVolume), 8 animated on approach (trigger), 0x10 animated after a wait (trigger)
0xf4       0x40       float matrix[16]                          # where it is drawn
0x27c      4          Shape *model                                    # its shape (object_initObjectBy: shape_getByName in objectShapes by the type's name): drawn (stage_drawObject), shaded (shape_shadingColours), its collision unit (space_buildUnit), box for animated collisions
0x280      8          u32 colourRuns[2]                               # (by use; seen running) two pointers, kept as u32, to its runs of colourCount shading colours in Stage.objectColours (object_initObjectBy): [0] lit by the map lights, [1] [0] re-shaded with the dynamic lights each frame
0x288      4          i32 colourSide                            # 1 (always: object_initObjectBy, nothing else writes it): each frame colours[1] is colours[0] re-shaded with the dynamic lights (mapObject_frame) and drawn (stage_drawObject); 0 would draw colours[0] unchanged
0x28c      4          void *unit                                # its collision unit (none: 0)
0x290      4          i32 animated                              # 1: its animation was started (object_setAnimation) and not yet reset (anim_reset): its collision unit is out of the static space (space_disableUnit) and is traced through relMatrix / relInverse instead (collision_moveSphere, collision_rayTrace); stays 1 when held at its end (mode 1) or stopped by a mode-0 call
0x294      4          void *skeleton                                  # its animation's skeleton (object_setAnimation: skel_getSkeletonPtrBy in objectSkeletons by name); bone 0 posed at animTime into animMatrix (mapObject_frame: skel_getBoneMatrix)
0x29c      4          float animRate                            # 1 / the period (0: stopped)
0x2a0      4          i32 animMode                                    # how its animation runs (object_setAnimation's mode: script command 0x1c's, 1 from anim_start): 1 once (held at 1, reset below 0), 2 looping on the match clock, 3 reset once outside 0 .. 1 (mapObject_frame)
0x2bc      0xc        float pos[3]                              # the centre of its bounding sphere

struct ObjectType 0xb0                                          # a map object as the map's object file gives it (map_loadObjectInfoFrom; object_initObjectBy)
0          0x40       char name[0x40]                            # its shape (Stage.objectNames)
0x40       4          i32 flags                                  # MapObject.flags, trigger, animPeriod
0x44       4          i32 trigger                                     # the object file's trigger value, copied with flags and animPeriod to MapObject.trigger (object_initObjectBy); not read here otherwise
0x48       4          i32 animPeriod                            # MapObject.animPeriod: the animation's period in ms
0x4c       0x40       char animName[0x40]                        # its animation (empty: none)
0x8c       0xc        float place[3]                                  # its position (the object file's): copied to MapObject.place, the translation of placeMatrix (object_initObjectBy)
0x98       0x10       float rotation[4]                          # a quaternion
0xa8       4          float glowSize                            # the glow flare's half-size (particle kind 4; objects with flag 1 while 3D items are on)
0xac       4          u32 glowColour                            # the glow flare's colour (RGB; its alpha from the glow)

struct ItemType 0x90                                            # a kind of map item (Stage.itemTypes)
0          0x40       char name[0x40]                            # (by use; seen running) its name (empty: an unused kind)
0x4c       0x40       char shapeName[0x40]                       # its shape (catalogue_loadItemInfoFrom: shape_getByName into model)
0x40       4          i32 respawnSound                           # (by use; seen running) played as a taken item comes back (frame_loops: item_sound)
0x44       4          i32 pickSound                              # played as it is taken (a warp zone: as it warps)
0x48       4          float respawnTime                         # (by use; seen running) a taken item comes back once its MapItem.timer passes this (seconds; item_update)
0x8c       4          Shape *model                              # its shape when items are drawn in 3D (none: not drawn)

struct MapItem 0x28                                             # an item lying on the map (Stage.items): power-ups, ammo...
0x18       4          float pitch                               # the play file's first angle x 10 (a pitch, as StartPoint.angle[0]); written by map_loadPlayInfoFrom, never read
4          4          i32 warpTo                                # a warp zone's: the item it leads to (item_pickup puts the local machine's actor at that item's pos, pitch its warpPitch x 10 and heading its angle)
8          4          i32 warpPitch                             # the pitch an actor arriving here by a warp takes (x 10 into nextPitch; item_pickup reads the destination item's)
0          4          i32 type                                  # index into Stage.itemTypes and the item atlas; < 0: none
0xc        0xc        float pos[3]                              # where it lies (map_loadPlayInfoFrom); an actor in play within 1.5 x the actor's own radius of it on every axis picks it up (item_update); drawn there (stage_drawItems); a warp zone's destination point (item_pickup)
0x1c       4          float angle                               # its turn, tenths of a degree: the play file's second angle x 10, then turned 600 a second while not taken (item_update, kind 0x22 excepted; never wrapped); drawn turned by it (stage_drawItems); a warp destination's heading for the arriving actor (item_pickup)
0x20       4          i32 taken                                 # 1: taken (not drawn)
0x24       4          float timer                               # seconds since it was placed, taken or came back (item_update adds dt every frame): a taken one comes back past its type's respawnTime; under 1 (or NaN) it is drawn fading in, alpha 255 x timer (stage_drawItems); a taken one's is sent as timer / 10 + 1, at most 15 (net_sendItemStates), and received as n x 10

struct Particle 0x12c                                         # a particle or effect (Stage.particles: particle_init / particle_update): flashes, sparks, beams, trails, explosions...
0          4          i32 id                                    # a serial (Stage.particleSerial, particle_init); kind 0 picks its frame by id % 8 (particle_draw)
8          4          i32 kind                                  # what it is: 0 a small puff, 2 / 3 explosions (3: an actor's death), 4 a light's glow flare, 5 .. 7 thrust puffs (booster thrustType + 5), 8 a hit flash, 9 debris (a dead actor's part shapes, falling), 10 .. 18 muzzle flashes (shotMode + 10), 20 .. 26 shots in flight (shotMode + 0x14; 25 / 26 beams), 30 .. 39 impacts (shotMode + 0x1e), 40 .. 49 hit marks on surfaces (shotMode + 0x28: weapons.c decal), 50 a textured quad (a beam weapon's side: weapons.c beam)
0xc        4          i32 owner                                 # by kind: the actor it belongs to (muzzle flashes; glows halve for the cockpit actor's), 1 for a shot drawn from the cockpit actor's own first 0.03 s (kinds 20 .. 26: 22 / 25 / 26 then not drawn, nor particle_beam's dots; kinds 20 / 21 are drawn only when it differs from cockpitActor: the original compares the flag with an actor index), the hit actor's 0x2000 flag (kind 8: texture 4), the dead actor's player record (kind 9 debris), the flare's alpha 0 .. 255 (kind 4), a random 0 .. 7 (puffs 5 .. 7, unused)
0x10       0xc        float pos[3]                                    # where it is: the descriptor's (particle_init), a muzzle or thrust one's from its matrix (particle_placeAtMatrix), debris moved by target (debris); culled and drawn there (particle_draw); sounds and lights at it
0x1c       0xc        float target[3]                           # by kind: the point it aims at (20 / 21 / 24 aimed from pos; 25 / 26 beams from it back); the hit surface's normal (impacts 30 .. 39 on a surface, hit marks 40 .. 49: weapons.c effect()), or for a hit on an actor the direction away from it (30 .. 39, 8); a piece of debris' velocity (9); smoke puffs' scale [0] and alpha factor [1] (5 .. 7); a glow flare's half-size [0] and colour bits [1] (4)
0x28       4          u32 matrixFrom                            # a matrix it is placed by, as a pointer (0: none): a muzzle entry's (flashes), an emitter joint's (puffs) or a hit map object's (hit marks); copied into matrix at its start (particle_spin), and a hit mark (40 .. 49) is drawn through it every frame
0x2c       0x40       float matrix[16]                                # its placement: matrixFrom's copy (particle_init), turned randomly about z (particle_spin), by drawAge for debris, or the inverse look from pos to target (particle_aim, particle_beam); drawn through it
0x6c       4          float drawAge                             # its age as drawn this frame (age before the frame's step)
0x70       4          float life                                # seconds it lives (it is freed past it)
0x74       4          float age                                       # seconds since particle_init (0; particle_update adds dt after its step): copied to drawAge at the step's start; past life it is freed
0x78       4          u32 colour                                # (its byte 0x7b: the alpha, set as it fades)
0x7c       4          float lightRadius                         # the radius of the white point light it casts at pos (stage_refillLights, when above 0): 0 at its start, then (1 - age / life)^2 x 3000 (kind 2), 5000 (3), 2000 (25, 26), 1000 (30, 31), 1500 (32 .. 34, 37, 38), 5000 (35), 3000 (36) (particle_update); 0 for other kinds
0x80       4          float baseSize                            # the descriptor's size
0x84       0x24       union { float puffWait; float markPoints[3][3]; }   # puffWait: (kind 9, debris) seconds to its next smoke puff (0.1; 1 in 10 an explosion that ends it);
                                                                 # markPoints: (hit marks, kinds 40 .. 49) their triangle's three points
0xb4       0x18       float markUv[6]                           # (kinds 40 .. 49, a hit mark) the hit triangle's three corners' texture coordinates (u, v), the mark's texture centred (0.5, 0.5) on the impact: corner offsets (ParticleDesc.markCoords, weapons.c decal's uv) x 0.005 + 0.5, or (offset / (baseSize + 200 / 400) + 1) / 2
0xd4       0xc        u32 markColours[3]                        # (kinds 40 .. 49, a hit mark) its three corners' colours: white (g_white), their alpha fading over its second second (particle_draw: (2 - drawAge) x 256 once drawAge > 1)
0xe4       4          i32 quadTexture                           # kind 50, a quad: its texture (ViewVolume_addQuad's), two texture corners, colour, points (ParticleDesc.quad)
0xe8       8          float quadUv0[2]                            # (kind 50) a texture corner (u, v)
0xf0       8          float quadUv1[2]                            # (kind 50) the other texture corner (u, v)
0xf8       4          u32 quadColour                                  # (kind 50) its colour (copied with quadTexture .. from ParticleDesc.quad: particle_init); ViewVolume_addQuad's colour (particle_draw)
0xfc       0x30       float quadPoints[4][3]                          # (kind 50) its four corners (ParticleDesc.quadPoints: particle_init; it lives 0.01 s), drawn as one quad (particle_draw: ViewVolume_addQuad)
4          4          i32 active                                # 1: in use

struct Bullet 0x4e8                                             # a bullet in flight (Stage.bullets: bullet_init, bullet_update)
0xc0       4          float homeTimer                            # (by use; seen running) a homing bullet turns again every 1/15 s
0xd0       4          i32 struck                                # 1: it hit something, an actor (hit_actor) or a surface (hit_surface): splash damage then (splash); 0 from bullet_init
0xd4       0x3c0      float trail[20][4][3]                        # (by use; seen running) a trail's ring of cross-sections (4 points each: weapons.c trail)
0x494      0x50       float trailAge[20]                        # (kind 3 trails) each cross-section's bullet age when made (trail); bullet_drawTrail ends the trail at the first one more than 1 s old. A beam (kind 7) leaves its length in [0] (beam), never read
0x4e4      4          i32 trailCount                             # the cross-sections made (the ring's next: % 20)
0          4          i32 id                                    # the next serial (Stage.bulletSerial: both bullet_spawn calls pass id -1); a beam picks its texture quarter by id % 4
4          4          i32 active                                # 1: in use
8          4          i32 weapon                                # its weapon's record (index into Scene.actorItems)
0xc        4          i32 owner                                 # the actor that fired it
0x10       4          u32 muzzle                                # the muzzle entry's matrix (FiredRound.muzzle; bullet_init passes it as its muzzle flash's ParticleDesc.matrixFrom)
0x54       0xc        float from[3]                             # where it was fired from
0x60       0xc        float impact[3]                           # where it ends, its impact point: the first step's end or hit (bullet_init; a network round: its target point), an actor's hit point (fly_local), a guided round's world hit (fly_local), or the network's point (actor_processFrame); its impact, mark and sound are made there (hit_actor, hit_surface)
0x6c       4          struct CollisionTri *hit                       # the surface (a triangle in Space.planes) where it ends: the first step's trace (bullet_init), each step's for a guided round (fly_local), the network's (actor_processFrame, bullet_init for a received round); 0: none, also when it hits an actor. hit_surface makes its impact and mark
0x70       4          float age                                 # seconds in flight
0x74       4          float life                                # the age at which it ends (s): the first step's length (or the distance to its hit) over the weapon's speed, kept to 0 .. 10 (bullet_init; a network round: 10); cut to its age when it hits an actor, to the world hit for a guided round (fly_local), or to age - dt by the network (actor_processFrame)
0x78       0xc        float prev[3]                             # its point before this frame's move
0x84       0xc        float pos[3]                              # its point
0x90       0xc        float netPoint[3]                         # the point the network sent (another player's bullet)
0x9c       4          i32 moved                                 # 1: drawn this frame (draw_shot): a local round after its step (fly_local); another player's when the network sent a new point (netPoint, actor_processFrame), which it then moves to (otherwise it steps on by step undrawn); cleared after each frame
0xa0       0xc        float vel[3]                                    # its velocity, units a second: the weapon's velocity along the aim (bullet_init; a weapon of no speed: impact - from); turned towards its target by home(); a local round's step is dt x vel (fly_local)
0xac       0xc        float step[3]                             # this frame's move: a local round's dt x vel (a weapon of no speed: vel itself; fly_local); another player's the unit direction to the network's point (bullet_update), added again on frames with no new point
0xb8       4          i32 hitActor                              # an actor it hit (-1 none), which takes it first
0xbc       4          i32 homingTarget                          # the actor a guided round homes on (bullet_init's fourth argument; < 0 none: the local player's own round follows the aim point)
0xc4       0xc        float homingPoint[3]                      # the point a guided round homes on without a target actor (the local player's own: 200000 along the aim)

struct SpacePool 0x10                                           # one of the collision space's pools (collision_space.c): an array of records and its free list
0          4          i32 count                                 # records
4          4          u8 *records                                     # the pool's array of count records, laid out in Space.block (space_initBy); cleared and chained into the free list (reset_pool); planes and blocks are also found by index in it (cells, network hit planes)
8          4          u8 *freeHead                              # the first free record (each free one links on)
0xc        4          i32 used                                  # records taken

struct SpaceNode 0x10                                            # a node of the collision space's lists (its pool: Space.nodes): a block's items
                                                                 # (SpaceBlock.items) and a unit's planes (SpaceUnit.lastNode); a list runs from its
                                                                 # head, the newest, through next
0          4          u8 *item                                  # the CollisionPlane it holds (a block's item or one of a unit's planes); the plane's flags bit 0 (value 1, space_disableUnit): left out of the static space's tests (space_collideBlock / space_traceBlock skip it only outside the moving units' lists)
4          4          u8 *block                                 # (a block's items) the block; written (space_insertItem), never read
8          4          struct SpaceNode *newer                   # the one put in after it (the list's back link; in the pool's free list the one before it, 0 at the head); written, never read
0xc        4          struct SpaceNode *next                    # the one put in before it (the lists run from the newest through it); in the pool's free list the next free one

struct SpaceBlock 0x50                                          # a block of the collision space (Space.blocks): an octree node over a box
0          0xc        float low[3]                                    # its box's low corner (with high): set from mn when taken (space_getNextFreeBlockPtrBy; a child is an octant of its parent's box: make_octant); space_insertItem and space_traceBlock read the box
0xc        0xc        float high[3]                                   # its box's high corner (with low): set from mx when taken (space_getNextFreeBlockPtrBy); space_insertItem tests a triangle against the box widened by margin (collisionTri_meetsBox)
0x18       4          SpaceNode *items                           # its items' list
0x1c       4          i32 itemCount                             # items in its list (space_insertItem); over Space.splitCount with depth left it splits (then 0); a child left with none and no split is freed (drop_if_empty)
0x24       4          i32 split                                  # 1: its items are in its children
0x28       0x20       u8 *children[8]                                 # its eight octant blocks (x bit 0, z bit 1, y bit 2; 0: none), made when it splits (space_insertItem, make_octant), emptied ones freed; walked by space_collideAt and space_traceBlock
0x48       4          u8 *poolPrev                              # its back link in the blocks' free list (reset_pool, space_freeBlock; the new head's cleared when one is taken: space_getNextFreeBlockPtrBy); written, never read
0x4c       4          u8 *poolNext                                    # its next in the blocks' free list (reset_pool links them, space_freeBlock pushes it on the front); space_getNextFreeBlockPtrBy moves the head to it

struct Space 0xf4                                               # the collision space (collision_space.c; 0xf4 bytes: CollisionVolume_clear zeroes 0x3d dwords, Stage.spaceData follows it; only the fields used)
4          4          i32 blockSize                             # its pools' memory size in bytes (planes x 0xac + nodes x 0x10 + units x 0x14 + blocks x 0x50 + cells x 2: space_initBy; 10262000 in a match)
8          4          u8 *block                                       # its pools' memory: planes, nodes, units, blocks and the cells' table in that order (space_initBy: Stage.spaceData given by match_setup, else allocated); freed by CollisionVolume_release when owned
0xc        4          i32 ownsBlock                              # 1: allocated here
0x10       0x10       SpacePool planes                          # 0xac-byte planes
0x20       0x10       SpacePool nodes                           # 0x10-byte nodes
0x30       0x10       SpacePool units                           # 0x14-byte units
0x40       0x10       SpacePool blocks                          # 0x50-byte blocks
0x50       4          i32 cellCapacity                          # cells the cells' table has room for
0x54       4          u16 *cells                                 # the cells' table: a cell's root block (blocks.records index; 0xffff: none)
0x58       4          i32 cellCount                             # nx * ny * nz; written, never read
0x5c       0xc        float min[3]                              # its bounds
0x68       0xc        float max[3]                                    # its bounds' high corner (with min): levelHigh from collision_initVolume (space_setBy); sizes the cells (cellSize) and bounds lookups widened by margin (space_collideAt, space_insertTriangle)
0x74       4          i32 cellsZ                                # the grid's cells along z (pos[2]): collision_initVolume's (levelHigh[2] - levelLow[2]) / size_z, space_setBy's first count
0x78       4          i32 cellsX                                # the grid's cells along x (pos[0])
0x7c       4          i32 cellsY                                # the grid's cells along y (pos[1])
0x80       0xc        float cellSize[3]                         # a cell's size, stored (z, x, y): cellSize[0] = (max[2] - min[2]) / cellsZ, [1] = x extent / cellsX, [2] = y extent / cellsY
0x8c       4          float margin                              # 500.0 (loading.c): how far the space's box, the grid cells and the blocks' boxes are widened for a triangle put in (space_insertTriangle, space_insertItem) and a point looked up (space_collideAt); also Scene.spaceMargin, the free camera's step cap
0x90       4          i32 splitCount                            # items a block holds before it splits (space_setBy; 16, loading.c; space_insertItem)
0x94       4          i32 depth                                 # the blocks' recursion depth (at most 8)
0x98       4          i32 lastHit                               # space_collideAt's last result; written, never read

struct PartInfo 0x80                                            # an ARM CENTER part-info record (g_partRecords, g_viewedPart: armc_parts.c part_info)
0          0x40       char name[0x40]                            # the item's folder path after its last slash
0x40       4          i32 slotType                              # SLOT TYPE (ActorItem.slotType): message 321 + this, 0 HAND, 1 SHOULDER; -1: an empty record (EMPTY SLOT, part_info with idx -1)
0x44       4          i32 ammoType                              # BULLET TYPE (ActorItem.ammoType): message 323 + this: 0 30mm, 1 60mm, 2 E-PAK, 3 ROCKET; -1: a special weapon (SPECIAL WEAPON, message 771). The viewed record's is g_viewedPartAmmoType
0x48       4          i32 ammoPerShot                           # BULLET CONSUMPTION (ActorItem.ammoPerShot, "cell"); in the viewed record of a special weapon (ammoType -1) armc_viewedPartRecord overwrites it with the actorItems index (g_viewedPartAmmoPerShot, the same memory), shown as message 745 + it: 772 .. 780 for items 27 .. 35, the item's description lines ("EXTRA CHARGE OF ALL TYPE|BULLETS BY 30%" ..)
0x4c       4          i32 burst                                 # FIRE AT THE SAME TIME (ActorItem.burst: rounds a burst), shown with message 758 "Round"
0x50       4          i32 damageType                            # DAMAGE TYPE (ActorItem.damageType): message 327 + this: 0 IMPACT, 1 ENERGY
0x54       4          i32 damage                                      # DAMAGE (ActorItem.damage, part_info); shown with the pilot's skill bonus for the ammo type (damage x stats / 100, armc_drawWeaponsScreen)
0x58       4          float range                               # SHOOTING RANGE: ActorItem.range x 0.01, shown "%.0f" with message 751 "m"
0x5c       4          float speed                               # BULLET SPEED: ActorItem.velocity x 0.01, shown "%.0f" with message 759 "m/s"
0x60       4          float spread                              # ActorItem.spread x 0.1 (k_0_1f): shown "%.1f" with message 752 "'" (DISPERSION ANGLE)
0x64       4          float hitRange                            # x 0.01: "m" (HIT RANGE)
0x68       4          float splashRadius                        # SPLASH DAMAGE RANGE: ActorItem.splashRadius x 0.01, shown "%.1f" with message 751 "m"
0x6c       4          i32 splashBorderDamage                    # (SPLASH BORDER DAMAGE)
0x70       4          float cycleTime                           # FIRING DELAY: ActorItem.cycleTime x 1000, shown "%.0f" with message 754 "ms"
0x74       4          float guidance                            # ActorItem.guidance x 0.1 (k_0_1f): shown "%.1f" with message 752 "'" (GUIDANCE)
0x78       4          float targetingTime                       # TARGETING TIME: ActorItem.targetingTime x 1000, shown "%.1f" with message 754 "ms"
0x7c       4          float weight                                    # ActorItem.weight (part_info); shown with 1 decimal and message 755 "t" (armc_drawWeaponsScreen)

struct Mission 0xfc                                              # one of the 30 missions of axis.mis (g_missions: mission_loadAxisMis; screen 900's list, which nothing in the menus opens)
0          4          i32 unused0                               # an entry's first word in axis.mis (mission_loadAxisMis), 0 when the list is cleared; nothing reads it
4          0x40       char name[64]                              # the list's first column
0x44       0x20       char title[32]                             # its second
0x64       0x80       char briefing[128]                         # (shown under the list for the one picked)
0xe4       4          i32 number                                 # the third column
0xe8       4          i32 unusedE8                              # read from axis.mis with the entry, cleared with the list; nothing reads it
0xec       4          i32 result                                 # the fourth: a message (MSG(511) + result * 0x80): 0 DON'T, 1 SUCCEED, 2 FAILED (seen with a test axis.mis)
0xf0       4          i32 unusedF0                              # read from axis.mis with the entry, -1 when the list is cleared; nothing reads it
0xf4       4          i32 blockSize                             # its briefing block's size in bytes in axis.mis (read after all the entries: mission_loadAxisMis); mission_loadBriefing adds up the earlier ones for the offset, reads this many bytes into g_briefingSource and keeps it as g_briefingEnd; the record's last four bytes (+0xf8) are never touched

struct NetPacketMessage 0x40c                                    # a DirectPlay message carrying slot data (kinds 6 and 7: net_handleMessage; the match's
                                                                 # packets are kind 7, g_netSendPacket)
0          4          u32 kind                                        # the message type (net_handleMessage): 1 a chat line, 2 the host gone (its id at +4), 6 the slot the host gives the receiver, 7 a player's slot data (a 64-byte match packet)
4          1          u8 slot                                   # kind 7: the sender's slot (net_sendPacketData: g_localSlot); kind 6 (g_netSlotMsg, 8 bytes): the slot the host gives the receiver (g_netClaimedSlot), taken as the local one
5          4          i32 size                                   # (0x40)
9          0x403      u8 data[0x403]                             # the packet: its first byte the number (net_packets.c)

struct NetSlot 0x410                                             # one of the sixteen network player slots (g_netSlots): the packet layer's player table
0          4          i32 used                                        # 1: the slot is taken (net_takePlayerSlot, net_handleMessage kinds 6 / 7); 0 when freed (net_freeAllSlots, net_freeSlotsOf); net_playerInUse returns it (ranking, sends, the packet queue)
4          4          u32 id                                     # its DirectPlay player id
8          4          i32 waiting                                # a packet is waiting in packet
0xc        4          u32 size                                  # the packet's size (0x40: net_handleMessage stores only that); written, never read (netq_receive uses 0x40)
0x10       0x400      u8 packet[0x400]                           # the packet received (64 bytes: its first byte the number, bit 7 a resend request
                                                                 # for the player in the second)

struct DPSessionDesc2 0x50                                       # DirectPlay's DPSESSIONDESC2 (dplay.h; ANSI): hosting, joining and enumerating (network.c)
0          4          u32 size                                   # dwSize (0x50)
4          4          u32 flags                                  # dwFlags
8          0x10       u8 instance[16]                            # guidInstance
0x18       0x10       u8 application[16]                         # guidApplication (k_axisAppGuid)
0x28       4          u32 maxPlayers                             # dwMaxPlayers
0x2c       4          u32 players                                # dwCurrentPlayers
0x30       4          const char *name                           # lpszSessionNameA
0x34       4          const char *password                       # lpszPasswordA
0x38       4          u32 reserved1                                   # dwReserved1: zeroed with the record (dplay_enumSessions, session_desc), never set or read by the game
0x3c       4          u32 reserved2                                   # dwReserved2: zeroed with the record (dplay_enumSessions, session_desc), never set or read by the game
0x40       4          u32 user1                                 # the game's: map (byte 0), rotation (byte 1) as the arena hosts set it (arena_takeHostAnswer, host_arena); room_hostingStep (the Ladder game room) puts the game mode here instead (the original's)
0x44       4          u32 user2                                  # the game mode
0x48       4          u32 user3                                  # the time limit (byte 0), frag limit (byte 1)
0x4c       4          u32 user4                                  # (TCP) the host's address

struct ArenaRecord 0x5b                                         # an arena as the lobby server lists it (g_serverList, 256; g_arenaPacket: the hosted arena's own,
                                                                 # sent when it is set up; g_arenaInfoPacket / g_lobbyLeavePacket: its updates)
0          1          u8 kind                                   # the record's first byte as the game sends it: 0x18 in the set-up packet (lobby_announceArena), g_arenaPacket's (0x18) in the info packet (arena_info), 1 in the leave packet (send_leave); copied into g_serverList (net_addServerRecord), never read
1          0x32       char name[0x32]                                 # the arena's name (lobby_announceArena: g_arenaName); in the info and leave packets; a listed one's goes to SessionEntry.name (arena_mergeReceivedSessions)
0x33       0x10       char address[16]                           # the host's address as text
0x43       1          signed char map                                 # the arena's map (lobby_announceArena: g_arenaMap); copied to the info and leave packets; a listed one's to SessionEntry.map (arena_mergeReceivedSessions)
0x44       1          signed char maxPlayers                          # the arena's player limit (lobby_announceArena: g_arenaMaxPlayers); in the info and leave packets; a listed one's to SessionEntry.maxPlayers
0x45       1          signed char players                             # players in the arena: 1 at set-up (lobby_announceArena), g_playerCount in the info packet (arena_info), 1 in the leave packet (send_leave); a listed one's to SessionEntry.players, summed in g_arenaListPlayers
0x46       1          signed char gameMode                            # the arena's game mode (lobby_announceArena: g_arenaGameType); in the info and leave packets; a listed one's to SessionEntry.gameMode
0x47       1          u8 fragLimit                                    # the arena's frag limit (lobby_announceArena: g_arenaFragLimit); in the info and leave packets; a listed one's to SessionEntry.fragLimit
0x48       1          u8 timeLimit                                    # the arena's time limit (lobby_announceArena: g_arenaTimeLimit); in the info and leave packets; a listed one's to SessionEntry.timeLimit
0x49       1          signed char rotation                       # the arena's map rotation (GameSettings.rotation)
0x4a       4          u32 replyKind                              # in a lobby reply (g_lobbyReplyRecord): its kind (g_lobbyReplyKind, net_receiveLobbyReply: 0 a server, 1 the list's end, 2 / 3 an answer state: g_lobbyListAnswer)
0x52       1          u8 locked                                       # the arena's lock flag (lobby_announceArena: g_arenaLocked); in the info and leave packets; a listed one's to SessionEntry.locked
0x53       8          char password[8]                                # the arena's password (lobby_announceArena: g_arenaPassword); in the info and leave packets; a listed one's to SessionEntry.password

struct RoomRecord 0x79                                           # a game hosted from the game room, as the game server lists it (g_roomList, 256; g_roomPacket:
                                                                 # the hosted game's own, g_roomInfoPacket / g_roomLeavePacket its updates): an ArenaRecord with the host's name
0          1          u8 kind                                   # the record's first byte as the game sends it: 0x18 in the set-up packet (room_announceGame); in the info packet (room_info) 1 when a player joined, else g_roomPacket's; 1 in the leave packet (send_leave); copied into g_roomList, never read
1          0x32       char name[0x32]                                 # the room game's name (room_announceGame: g_roomRecName); a listed one's (net_addRoomRecord) goes to SessionEntry.name (room_mergeReceivedSessions); not in the info or leave packets
0x33       0x10       char address[16]                                # the host's address as text (room_announceGame: g_localAddress); in the info and leave packets; a listed one's goes to SessionEntry.address (room_mergeReceivedSessions)
0x43       0x1e       char hostName[30]                          # the player who made it (g_ladderId)
0x61       1          signed char map                                 # the map index (room_announceGame: GameSettings.map of g_roomRecName); copied by room_info / send_leave; a received room's goes to SessionEntry.map (room_mergeReceivedSessions)
0x62       1          signed char maxPlayers                          # the most players (GameSettings.maxPlayers, room_announceGame); copied by room_info / send_leave; received: SessionEntry.maxPlayers (room_mergeReceivedSessions)
0x63       1          signed char players                       # players in the game: 1 at room_announceGame and in the leave packet (send_leave), g_playerCount (less one when a player left) in the info packet (room_info); received: SessionEntry.players, summed into g_roomListPlayers
0x64       1          signed char gameMode                            # the game mode (GameSettings.mode, room_announceGame); copied by room_info / send_leave; received: SessionEntry.gameMode (room_mergeReceivedSessions)
0x65       1          u8 fragLimit                                    # the frag limit (GameSettings.limit[0], room_announceGame); copied by room_info / send_leave; received: SessionEntry.fragLimit (room_mergeReceivedSessions)
0x66       1          u8 timeLimit                                    # the time limit in minutes (GameSettings.limit[1], room_announceGame); copied by room_info / send_leave; received: SessionEntry.timeLimit (room_mergeReceivedSessions)
0x67       1          signed char rotation                       # the room's map rotation (GameSettings.rotation)
0x68       4          u32 replyKind                              # in a game server reply (g_gameServerReply): its kind (g_gameServerReplyKind, net_receiveGameServerReply: 0 a room, 1 the list's end, 2 / 3 refused)
0x70       1          u8 locked                                       # 1: a password is set (GameSettings.locked, room_announceGame); copied by room_info / send_leave; received: SessionEntry.locked (room_mergeReceivedSessions)
0x71       8          char password[8]                                # the room's password (GameSettings.password, room_announceGame); copied by room_info / send_leave; received: SessionEntry.password, checked on joining

struct SessionDesc 0x85                                          # an arena session DirectPlay's enumeration found (dplay_enumSessionsCallback, from its
                                                                 # DPSESSIONDESC2); net_addSession keeps a malloc'd copy (SessionSlot.desc)
0          4          u32 guid                                   # a GlobalAlloc'd copy of the instance GUID: the join's argument (dplay_join)
4          0x10       u8 instance[16]                            # guidInstance
0x14       0x10       u8 application[16]                         # guidApplication
0x24       1          signed char map                            # dwUser1's low two bytes: the map ..
0x25       1          signed char rotation                       # .. and the map rotation flag
0x26       1          u8 maxPlayers                              # dwMaxPlayers
0x27       1          signed char gameMode                       # dwUser2
0x28       1          u8 fragLimit                               # dwUser3's second byte (bits 8 .. 15; dplay_hostSession's hi): the frag limit (its low byte is timeLimit)
0x29       1          u8 timeLimit                                    # dwUser3's low byte: the host's time limit in minutes (dplay_hostSession's lo); into SessionEntry.timeLimit (arenaList_rebuild) or the joined record (arena_joinAnswer)
0x2a       4          i32 players                                # dwCurrentPlayers
0x2e       0x46       char name[70]                              # lpszSessionName
0x74       0x10       char address[16]                          # (TCP, connection kind 0) the host's address as text (net_formatAddress of dwUser4); written, never read

struct SessionSlot 8                                             # one of the 200 of g_sessionTable
0          4          i32 used                                        # 1: the slot holds a session (net_addSession), 0 free (net_findFreeSession picks the first; cleared by net_freeSessionList); net_getSession returns desc only when set
4          4          SessionDesc *desc                               # the session's malloc'd SessionDesc copy (net_addSession); returned by net_getSession, its instance compared by dplay_enumSessionsCallback to skip repeats; freed by net_freeSessionList

struct SessionEntry 0x4a                                         # a game of the arena lobby's / game room's list (g_sessionList, 256: arenaList_rebuild
                                                                 # from the SessionDescs, the merge of received games in net_sessions.c)
0          4          u32 guid                                   # (SessionDesc.guid) the join's argument
4          0x20       char name[32]                                   # the game's name (SessionDesc.name: arenaList_rebuild, or the received record's: merge); drawn in the list (game_rows); copied to g_gameTitle on joining (take_session, room_joinAnswer)
0x24       1          signed char rotation                       # the map rotation flag (shown "ROTATION")
0x25       1          signed char map                                 # the map index: shown as g_mapNames + map x 0x20 (13 characters) unless rotation (game_rows); g_mapIndex on joining (take_session, room_joinAnswer)
0x26       1          signed char maxPlayers                          # the most players: the "players / most" column (game_rows); from SessionDesc.maxPlayers or the received record
0x27       1          signed char players                             # players in the game: the "players / most" column (game_rows); a received game's summed into its screen's total (merge: g_roomListPlayers / g_arenaListPlayers)
0x28       4          i32 ping                                  # the host's ping: g_serverPing of a received game (merge; only ping > 0 are listed), 0 for DirectPlay's (arenaList_rebuild); the list is sorted by it (sessionList_sort) and shows it when pings are on (game_rows)
0x2c       1          signed char gameMode                            # the game mode: the column's name from the screen's mode strings (game_rows); g_chosenGameMode on joining (take_session, room_joinAnswer)
0x2d       1          u8 fragLimit                                    # the frag limit: g_fragLimit on joining (take_session, room_joinAnswer), also g_arenaFragLimit / g_roomRecFragLimit (arena_joinSession, arena_joinAnswer, room_joinAnswer)
0x2e       1          u8 timeLimit                                    # the time limit in minutes: g_timeLimit on joining (take_session, room_joinAnswer), also g_arenaTimeLimit / g_roomRecTimeLimit; arena_joinSession returns it
0x2f       0x10       char address[16]                           # what dplay_openConnection opens
0x3f       8          char password[8]                                # the game's password, set only from a received record (merge; DirectPlay entries leave it); compared with the typed one on joining (gameList_pageFrame, arena_gamesPageFrame: mismatch, message 0x27)
0x47       1          u8 locked                                  # a password is asked for (the lock shown)

struct FileEntry 0x44                                            # a file of the replay selection / replay list (g_replayList, 1024)
0          0x40       char name[0x40]                                 # the replay's file name (a *.ape of the autoplay folder: autoplay_listFiles); drawn in the replay selection list; the picked ones copied to Scene.replayFiles (scene_startSession)
0x40       4          i32 picked                                # 1: picked (a replay chosen in the replay selection: replaySelect_toggle / allIn / allOut; scene_startSession plays the picked ones)

struct MapChoice 8                                               # a map of the arena's map list (g_mapChoiceTable, g_mapChoiceKeptTable: 1024)
0          4          i32 chosen                                 # in the rotation
4          4          i32 type                                   # its game type (0 .. 13)

struct AccountPacket 0x10b                                       # the game server's account record (g_accountPacket, 0x10b bytes: sent with requests 14, the login, and 15, the new ID (newId_register): net_send's case 14 / 15)
0          4          i32 kind                                   # 0x18
4          0x1e       char name[30]                                   # the account ID: g_accountName, by login_send (request 14, the login) and newId_register (request 15, the new ID)
0x22       0xc        char password[12]                               # the account password: g_accountPassword (login_send, newId_register)
0x2e       0x32       char email[0x32]                                # the e-mail: g_accountEmail, set only by newId_register (the login leaves it)
0x60       0x10       char address[16]                          # this machine's (g_localAddress, written by net_tables' request 14 / 15 handler just before the record is sent: the login and the new ID)
0x70       0xb        u8 mech[11]                                # the default mech settings (lobby_states default_mech)
0x7b       0x90       float colours[6][6]                        # six colour pairs, each (hue, saturation, value) twice (default_mech: 0, 1, 0.6)

struct AccountForm 0x5c                                          # the account form's fields as sent (g_netAccountBuffer: message 0x1c)
0          0x1e       char name[30]                                   # the account ID (g_accountName), sent by account_sendChange
0x1e       0xc        char password[12]                               # the new password (g_accountPassword, once the old one matches g_ladderPassword and the repeat matches: account_sendChange)
0x2a       0x32       char email[0x32]                                # the e-mail (g_accountEmail, account_sendChange)

struct GameSettings 0x30                                         # a game's settings record (g_arenaName: the arena's / axis.cfg's, g_roomRecName: the
                                                                 # registry's, g_roomSettingsName: the room form's, g_newArenaName: the new arena form's)
0          0x20       char name[32]                                   # the game's title (the form's TITLE row, typed in; settings_store copies it): the DirectPlay session name (dplay_host), RoomRecord.name (room_announceGame), g_gameTitle
0x20       1          signed char map                                 # the map index (the form shows g_mapAbouts + map x 0x50 unless rotation): dplay_host's dwUser1 low byte, g_mapIndex (arena_takeHostAnswer), RoomRecord.map
0x21       1          signed char maxPlayers                    # the most players (the form's NO OF PLAYER row, MSG(400); 0 .. 16, else 8 from axis.cfg)
0x22       1          signed char rotation                       # 1: map rotation on (the map list's maps in turn: the preview shows CUSTOM; the form's MAP ROTATION row)
0x23       1          signed char mode                                # the game mode (the form shows the mode names, 0x80 apart): dplay_host's dwUser2, g_chosenGameMode (arena_takeHostAnswer), RoomRecord.gameMode
0x24       2          u8 limit[2]                               # [0] the frag limit (FRAG LIMIT row), [1] the time limit in minutes (TIME LIMIT row): dplay_host's dwUser3 high / low byte, g_fragLimit / g_timeLimit when hosting, RoomRecord.fragLimit / timeLimit (room_announceGame)
0x26       8          char password[8]                                # the password (typed in; the form shows it as stars); not empty sets locked (settings_store); copied to RoomRecord.password (room_announceGame)
0x2e       1          u8 locked                                  # the password is not empty (settings_store)

struct RankedPlayer 0x3e                                         # a player of the ranking list as the game server sends it (62 bytes: g_playerListReply;
                                                                 # kept in g_netPlayerList, ten of them (one ranking page), by net_addPlayerRecord)
0          0x1e       char name[30]                                   # the player's ID; empty ends the page (ranking_fillPage); copied by net_addPlayerRecord, then to RankRow.name
0x1e       4          i32 kind                                  # the reply's kind (g_playerListReplyKind): 0 a player (net_addPlayerRecord adds it), 1 the list's end (g_playerListDone set, g_netLastRequest cleared)
0x22       4          i32 games                                 # Ladder rounds played (the account's g_ladderGames, see PlayerRecordPacket.games; DServer keeps it as 'a'); not shown, copied to RankRow.games
0x26       4          i32 kills                                 # the KILL column (sort 1): copied by net_addPlayerRecord, then to RankRow.kills
0x2a       4          i32 deaths                                      # (see kills) the DEATH column
0x2e       4          i32 exp                                         # (see kills) the EXP column (sort 2)
0x32       4          i32 level                                  # its grade (the rank badge)
0x36       4          float power                                     # (see level) the POWER column (sort 0), copied to RankRow.power
0x3a       4          float rate                                      # (see level) the kill rate: the RATE column (sort 3), copied to RankRow.rate

struct RankRow 0x44                                              # a row of the ranking table (g_rankingRows, ten: ranking_fillPage from g_netPlayerList)
4          4          i32 rank                                   # its place (the row before's when its sorted value is the same)
8          0x1e       char name[30]                              # (empty: past the list's end)
0x26       4          i32 exp                                    # (sort 2)
0x2a       4          i32 games                                 # RankedPlayer.games (Ladder rounds played; not shown); written, never read
0x2e       4          i32 kills                                  # (sort 1)
0x32       4          i32 deaths                                      # the DEATH column (ranking_drawTable; not a sort column); 0 when cleared (ranking_fillPage, ranking_enter)
0x36       4          float rate                                 # (sort 3)
0x3a       4          i32 level                                  # the rank badge (1 when the row is cleared)
0x3e       4          float power                                # (sort 0; not cleared with the rest)

struct CharacterProfile 0x4c                                     # a pilot character (g_characterProfiles: the character profile data file's records,
                                                                 # the file's count of them: 9 in profeng.dat; indexed by a player's character. data_loadCharacterProfiles' stats check
                                                                 # walks 103 (0x67 = the version word - 0x115c), so its reach overlaps g_netSlots)
0          0x10       char name[16]                                   # the pilot's name (e.g. Sonien): drawn by profile_drawPilotSelect and profile_drawChosenPilot
0x10       0x10       char corporation[16]                            # the pilot's corporation (e.g. Nitro): drawn under the name (profile_drawPilotSelect, profile_drawChosenPilot)
0x20       4          i32 sex                                    # MSG(545) + it: 1 MALE, 2 FEMALE (the SEX row)
0x24       4          i32 age                                    # the AGE row
0x28       0x24       i32 stats[9]                              # percentages, the CHARACTER SELECT rows MSG(536 ..): [0] BULLET.LV, [1] ENERGY.LV, [2] BOMB.LV, [3] MELEE.LV (the weapon groups' damage: actor_takeDamage, the ARM CENTER's bonus), [4] MOBILITY, [5] SPEED (the legs': LEG()), [6] DEFENSE, [7] SCANNING, [8] MAX.LOAD ([4] .. as character_factor / SKILL(k): stats[4 + k] x 0.01 + 1); [7] at most 50, the others 30 (else 0)

struct GamePacket 0x40                                          # match packet kind 1, a player's game state (net_sendGamePacket; read by net_processGamePacket)
0          1          u8 number                                  # the packet layer's number
1          1          u8 kind                                    # 1
2          1          u8 player                                       # the sending player's slot (net_sendGamePacket); the receiver drops it above 0x10; only player 0's (the host's) sets the clock, rotation, checks and team scores; its actor gets timePlayed, kills, deaths
3          1          signed char map                            # the rotation's map and mode, now and next (0xff: none)
4          1          signed char nextMap                             # (see map) Scene.nextMap; the receiver sets Scene.nextMap from it (net_processGamePacket)
5          1          signed char mode                                # (see map) the current rotation entry's mode; the receiver applies it (game_setGameTypeFlags) when it switches map
6          1          signed char nextMode                            # (see map) Scene.nextMode; the receiver sets Scene.nextMode from it
7          2          short mapNumber                           # Scene.mapNumber (the map's own number; a receiver on the same map (g_mapIndex == map) with another number has data loss, dataLossCode 1)
9          4          i32 elapsed                                # the match clock (Scene.elapsed, clockFraction)
0xd        4          float clockFraction                             # (see elapsed) Scene.clockFraction, the part of a second; set on the receiver from player 0's packet
0x11       4          i32 timePlayed                             # the player's (Actor.timePlayed, timeFraction)
0x15       4          float timeFraction                              # (see timePlayed) Actor.timeFraction; set into the sender's actor
0x19       8          u32 resendAsked[2]                        # per player, a bit: [0] it is asked to send its info again (its sendFlags[2]: the receiver whose bit it is raises sendFlags[me][1], net_sendPlayerInfo), [1] its flag again (sendFlags[3]: the receiver clears its PlayerRecord.flagSent)
0x21       2          short kills                                     # the sender's Actor.kills (low 16 bits); the receiver sets that actor's kills
0x23       2          short deaths                                    # the sender's Actor.deaths (low 16 bits); the receiver sets that actor's deaths
0x25       4          short teamScores[2]                             # Scene.teamScores[0] / [1] (low 16 bits); the receiver takes them from player 0's packet only
0x29       2          short lastPickup                          # the map item (Stage.items index) the sender last picked up (Stage.lastPickup, -1 after each send; -1 none): the receiver marks it taken (MapItem.taken 1, timer 0)
0x2b       1          u8 checkTable                             # the part type table checked (typeCheckTurn % 5: 0 headTypes, 1 chestTypes, 2 armTypes, 3 legTypes, 4 boosterTypes), and a sample of it (checkIndex) with the entry there (checkValue): a mismatch is data loss, code 2
0x2c       2          u16 checkIndex                            # a random word (table_rand() % 100000, cut to 16 bits) picking the entry: row (w / perRow) % count, column w % perRow (sample / table_ok)
0x2e       4          u32 checkValue                                  # (see checkTable) the entry at checkIndex in the sender's table (sample); the receiver's table_ok compares it with its own
0x32       2          u16 checkIndex2                           # the same for the item table (actorItems, actorItemCount; perRow typeTablePerRow[5]): a mismatch is data loss, code 3
0x34       4          u32 checkValue2                                 # (see checkIndex2) the item table's entry there; compared by table_ok, a mismatch is data loss code 3

struct PlayerRecordPacket 0x36                                  # the player's Ladder record sent to the game server (g_netPlayerRecordPacket, packet 0x11: lobby_states.c record_send)
0          0x1e       char name[0x1e]                            # the Ladder name (written only when asked)
0x1e       4          i32 games                                 # Ladder rounds played (g_ladderGames: one more at a Ladder match's first round, each next round and each restart)
0x22       4          i32 kills                                       # (see games) g_ladderKills (record_send)
0x26       4          i32 deaths                                      # (see games) g_ladderDeaths (record_send)
0x2a       4          i32 exp                                         # (see games) g_ladderExp, cut to kills x 2 when above kills x 150 (ladder_checkAndSendRecord)
0x2e       4          i32 level                                 # level_fromPoints(exp): the level (1 .. 20) the Ladder exp (g_ladderExp) reaches
0x32       4          float power                                     # g_ladderPower: the kill rate x 0.01 x the exp (power_from_rate)

struct PilotStats 0x20                                          # a pilot's standing (g_pilotLevel .., kept as g_pilotLevelKept ..: lobby_states.c take_back)
0          4          i32 level                                       # the level (1 .. 20): login reply +0xef, 1 for a new ID, level_fromPoints(exp) in record_send; the account panel's LEVEL and rank badge, the ARM CENTER's unlocked parts (level - 1)
4          4          i32 exp                                         # the exp: login reply +0xff, set by record_send; shown on the account panel; compared between the two copies (pilotRecord_syncCopies)
8          4          i32 rank                                  # its place in the ranking (message 29's reply +0x16; 0 out of the first 1000: the account panel shows OUT OF RANK(1000))
0xc        4          float power                               # the kill rate x 0.01 x the exp (power_from_rate); shown "%.2f" on the account panel
0x10       4          i32 games                                 # Ladder rounds played (reply +0xf3; g_ladderGames)
0x14       4          i32 kills                                       # kills: login reply +0xf7, set by record_send; shown on the account panel; take_back uses it when the Ladder kills are over 300 above
0x18       4          i32 deaths                                      # deaths: login reply +0xfb, set by record_send; shown on the account panel
0x1c       4          float killRate                                  # the kill rate in percent (kill_rate: kills x 100 / (kills + deaths)): login reply +0x107, set by record_send; shown "%.2f" on the account panel

struct SkirmishInfo 0x5c                                        # a skirmish map's play settings (g_skirmishInfo, 15 of them: read by files.c)
0x4c       4          i32 gameMode                              # the round's game mode (skirmish.dat: 0 DEATH MATCH, 1 TEAM DEATH MATCH, 2 SUDDEN DEATH = MSG(471) + this): the skirmish screen's GAME TYPE line; skirmish_startRound -> g_chosenGameMode
0x50       4          i32 timeLimit                                   # the round's time limit in minutes (skirmish.dat): g_timeLimit (skirmish_startRound); Round.timeLimit of the solo rotation (make_rotation)
0x54       4          i32 fragLimit                                   # the round's frag limit (skirmish.dat): g_fragLimit (skirmish_startRound); Round.fragLimit of the solo rotation (make_rotation)

struct ViewQuad 0x5c                                            # a queued quad or billboard (ViewVolume.quads; view_volume.c quad_fields)
0          4          i32 texture                                # (none: negative; then no texture corners)
4          8          float uv0[2]                                # one corner's texture coordinates (u, v), for points[3]; billboard() gives points[2] (uv1[0], uv0[1]) and points[0] (uv0[0], uv1[1])
0xc        8          float uv1[2]                                # the opposite corner's texture coordinates (u, v), for points[1] (see uv0)
0x14       4          u32 colour                                      # its packed RGBA colour (quad_fields, from the caller's colour); glColor4ubv when drawn (billboard)
0x18       0x40       float points[4][4]                         # its corners in clip space
0x58       4          i32 kind                                   # 2 / 3: depth-sorted into quadOrderA / B

struct ViewTriangle 0x60                                        # a queued clipped triangle (ViewVolume.triangles)
0x28       0x30       float points[3][4]                        # its corners in clip space; for kind 1 (ViewVolume_addTriangle's raw 1) the points as given with w 1, drawn under its matrix
0x58       4          u32 matrix                                 # the matrix it is drawn under (kind 1)
0x5c       4          i32 kind                                  # ViewVolume_addTriangle's raw: 1 drawn first as given under its matrix (ViewVolume_draw), 2 depth-sorted (triangleOrder) and merged back to front with the kind-2 quads (draw_transparent's); others never drawn

struct ViewVolume 0x9170                                        # the view volume: what a frame draws, queued by material and depth (view_volume.c, factors.c; 0x9170 bytes: ViewVolume_clear clears 0x245c dwords; only the fields used)
4          4          i32 blockSize                             # its lists' memory size in bytes: entries x 0x1c + matrices x 0x40 + colours x 4 + triangles x 0x68 + quads x 0x64 + segments x 0x24 (ViewVolume_initBy; 1240000 for Scene.view)
8          4          u8 *block                                       # the memory the lists are carved from (ViewVolume_initBy: operator_new, then ownsBlock, or the caller's, Scene.viewMemory); freed by ViewVolume_release when owned
0xc        4          i32 ownsBlock                              # 1: allocated here (freed with it)
0x14       0xc        void *glArrays[3]                         # glVertexPointerEXT / glColorPointerEXT / glTexCoordPointerEXT (wglGetProcAddress with GL_EXT_vertex_array; 0: draw_opaque uses the GL 1.1 ones)
0x10       4          i32 entryPointsSet                        # set once its three GL entry points are looked up (+0x14 .. +0x1c); written, never read
0x20       0x3000     i32 materialOrder[3072]                   # the material lists in the order first queued (materialCount of them): each a list id, material + 1 (0: untextured, else the texture id + 1), the index into materialHeads / materialTails
0x3024     4          i32 materialCount                               # material lists queued (materialOrder entries: ViewVolume_queueModel); ViewVolume_draw walks that many; 0 by ViewVolume_reset
0x3028     0x3004     u8 *materialHeads[3073]                    # per material: its first queued entry (0: none yet)
0x602c     0x3004     u8 *materialTails[3073]                    # its last (entries are linked on from it)
0x9030     4          i32 entryLimit                            # the queued parts (0x1c bytes each)
0x9034     4          u8 *entries                                     # (see entryLimit) the queued parts, linked per material from materialHeads (ViewVolume_queueModel)
0x9038     4          i32 entryCount                                  # (see entryLimit) used (ViewVolume_queueModel); cleared by ViewVolume_reset
0x903c     4          i32 matrixLimit                           # the parts' matrices (0x40 bytes each)
0x9040     4          u8 *matrices                                    # (see matrixLimit) the slots: ViewVolume_queueModel takes the next for the current GL modelview when no matrix is given
0x9044     4          i32 matrixCount                                 # (see matrixLimit) used (ViewVolume_queueModel); cleared by ViewVolume_reset
0x9048     4          i32 colourLimit                           # the colour buffer: room for so many vertices
0x904c     4          u8 *colours                                     # (see colourLimit) the buffer: a mesh's vertex colours lit and / or tinted there for drawing (item_colours)
0x9050     4          i32 colourMost                            # the most vertices the colour buffer held in this ViewVolume_draw (0 at its start; raised by fits()); never read otherwise
0x9054     4          i32 triangleLimit                         # the clipped triangles (0x60 bytes each)
0x9058     4          u8 *triangles                                   # (see triangleLimit) the records (ViewVolume_addTriangle)
0x905c     4          i32 triangleCount                               # (see triangleLimit) queued (ViewVolume_addTriangle; a culled one taken back); ViewVolume_draw draws the kind 1 ones, sorts kind 2; cleared by ViewVolume_reset
0x9060     4          u8 *triangleOrder                         # (record, depth) pairs sorted back to front
0x9064     4          i32 triangleOrderCount                          # (see triangleOrder) the kind 2 triangles listed there by ViewVolume_draw (0 first), sorted by render_depthSortTriangles
0x9068     4          i32 quadLimit                             # the quads and billboards (0x5c bytes each)
0x906c     4          u8 *quads                                       # (see quadLimit) the records (ViewVolume_addQuad, ViewVolume_addBillboard)
0x9070     4          i32 quadCount                                   # (see quadLimit) queued (ViewVolume_addQuad / ViewVolume_addBillboard; a culled one taken back); cleared by ViewVolume_reset
0x9074     4          u8 *quadOrderA                            # sorted quads of kind 2
0x9078     4          i32 quadOrderACount                             # (see quadOrderA) listed by ViewVolume_draw (0 first); sorted, then merged back to front with the triangles
0x907c     4          u8 *quadOrderB                            # ... of kind 3
0x9080     4          i32 quadOrderBCount                             # (see quadOrderB) listed by ViewVolume_draw; sorted, drawn last without fog or depth test
0x9084     4          i32 segmentLimit                          # the coloured lines (0x24 bytes each: a packed RGBA colour, then two clip-space points; ViewVolume_addSegment: the debug grid in red, the map lights' yellow stars), drawn by ViewVolume_draw as GL_LINES
0x9088     4          u8 *segments                                    # (see segmentLimit) the records (ViewVolume_addSegment)
0x908c     4          i32 segmentCount                                # (see segmentLimit) queued (ViewVolume_addSegment; a culled one taken back); drawn by ViewVolume_draw; cleared by ViewVolume_reset
0x9090     4          i32 entriesFull                           # 1: a list overflowed (what did not fit is left out); cleared by ViewVolume_reset; set, never read
0x9094     4          i32 matricesFull                                # (see entriesFull) the matrices (ViewVolume_queueModel)
0x9098     4          i32 trianglesFull                               # (see entriesFull) the triangles (ViewVolume_addTriangle)
0x909c     4          i32 quadsFull                                   # (see entriesFull) the quads (ViewVolume_addQuad / ViewVolume_addBillboard)
0x90a0     4          i32 segmentsFull                                # (see entriesFull) the lines (ViewVolume_addSegment)
0x90a4     4          i32 trianglesDrawn                              # draw counters (cleared by ViewVolume_clearDrawCounts: by ViewVolume_initBy, and by match_drawFrame each match frame - so per frame only in a match; outside one they keep counting); counted up, never read
0x90a8     4          i32 meshesDrawn                                 # (see trianglesDrawn) material list items walked by ViewVolume_draw (counted even when their colours do not fit); never read
0x90ac     4          i32 textureBinds                                # textures bound (view_volume.c bind: +1 per tex_bind while drawing; see trianglesDrawn); counted up, never read
0x90b0     0x40       float projection[16]                            # the projection matrix: copied from the one given or read from GL (ViewVolume_captureMatrices); loaded back to draw (ViewVolume_draw), maps the fog range to depth there, projects billboards (ViewVolume_addBillboard)
0x90f0     0x40       float modelview[16]                             # the view matrix: copied from the one given (Scene.modelview) or read from GL (ViewVolume_captureMatrices); loaded back to draw (ViewVolume_draw); puts billboards in camera space (ViewVolume_addBillboard)
0x9130     0x40       float clip[16]                            # projection x modelview: points to clip space

struct Skeleton 0x24                                            # a skeleton (shapes_skeletons.c): its 0x24-byte header and the block its bones and their tables are in
4          4          i32 blockSize                                   # its block's size: bones x 0x70 + rotKeyTotal x 0x28 + posKeyTotal x 0x20 (the .ske header's, take_block in skel_loadFromFile; worked out by skel_loadAseFrom); added to the manager's dataUsed (skel_getSkeletonPtrBy)
8          4          u8 *block                                 # its bones (from the start) and their key tables
0xc        4          i32 ownsBlock                             # 1: allocated here (freed with it)
0x10       4          i32 boneCount                                   # its bones (0x70 bytes each at bones): the .ske header's (skel_loadFromFile) or the ASE's GEOMOBJECTs (skel_loadAseFrom); a bone index past it gets the identity (skel_getBoneMatrix), ObjectList_poseBones stops at it
0x14       4          u8 *bones                                 # boneCount Bone records
0x18       4          i32 posKeyTotal                           # its bones' position keys summed (the .ske header's; counted by skel_loadAseFrom for an ASE file, with rotKeyTotal sizing the block)
0x1c       4          i32 rotKeyTotal                            # its rotation keys
0x20       4          i32 duration                              # its animation's length in milliseconds (ASE: SCENE_LASTFRAME x (1000 / SCENE_FRAMESPEED); Skeleton.dat: 3300 = 100 frames at 33 ms, 1650 for some weapons); the key times are in the same units; skel_getBoneMatrix's t (0 .. 1) and anim_setTime scale it, ObjectList_poseBones takes animTick % (duration + 1)

struct Bone 0x70                                                # a skeleton's bone (Skeleton.bones)
0x40       4          i32 parent                                # its parent bone (< 0: the root)
0x44       0xc        float pos[3]                              # its position without keys
0x50       0x10       float rotation[4]                         # its rotation without keys: angle (radians), then axis
0x60       4          i32 posKeyCount                           # position keys, 0x20 bytes each: time, length (ms), base, delta
0x64       4          u8 *posKeys                                     # its posKeyCount position keys (PosKey) in the skeleton's block after the bones (skel_loadFromFile, skel_loadAseFrom); read through key_at by skel_getBoneMatrix and ObjectList_poseBones
0x68       4          i32 rotKeyCount                           # rotation keys, 0x28 bytes each: time, length (ms), base angle + axis, delta angle + axis
0x6c       4          u8 *rotKeys                                     # its rotKeyCount rotation keys (RotKey) in the block, after its position keys (skel_loadFromFile, skel_loadAseFrom); read through key_at by skel_getBoneMatrix and ObjectList_poseBones

struct PosKey 0x20                                              # a bone's position key (Bone.posKeys)
0          4          i32 time                                  # the time it starts at, in milliseconds (whole frames x 1000 / FRAMESPEED, as Skeleton.duration)
4          4          i32 length                                # milliseconds to the next key (0: the last)
8          0xc        float pos[3]                                    # the bone's position at the key's time (ASE: y and z swapped, skel_loadAseFrom); pos + delta x the fraction of length passed is translated to (skel_getBoneMatrix; ObjectList_poseBones also x the entry's scale)
0x14       0xc        float delta[3]                             # to the next key's position

struct RotKey 0x28                                              # a bone's rotation key (Bone.rotKeys)
0          4          i32 time                                  # the time it starts at, in milliseconds (as PosKey.time)
4          4          i32 length                                # milliseconds to the next key (0: the last)
8          0x10       float rotation[4]                         # its rotation: angle (radians), then axis (from the ASE, combined with the ones before)
0x18       0x10       float step[4]                              # the rotation to the next key (angle, axis)

struct ShapeManager 0x24c                                       # a shape manager (the game's class ShapeManager; shapes_skeletons.c; a skeleton manager is its first 0x130 bytes: SkelManager): shapes loaded by name into one block, found through a name tree
4          4          i32 blockSize                                   # its block's size: capacity x 0x98 (a 0x4c-byte name node and a 0x4c-byte shape each) + dataSize (ShapeManager_initBy); take_block allocates it or checks the memory given against it
8          4          u8 *block                                 # the name nodes, then the items, then the data memory
0xc        4          i32 ownsBlock                             # 1: allocated here
0x10       0x100      char dir[0x100]                           # the folder of its loose item files (item_path, sources 0 / 1 only; not read with source 2, which every caller passes)
0x110      4          u32 source                                # where its items load from: 0 / 1 loose files with the first / second extension (shp / obj, ske / ase), 2 the packed archive (Shape.dat / Skeleton.dat); every caller passes 2
0x114      4          i32 capacity                              # items it has room for
0x118      4          u8 *nodes                                 # the name tree: one 0x4c-byte TreeNode per item
0x11c      4          u8 *items                                 # the items (skeletons 0x24 bytes, shapes 0x4c)
0x120      4          i32 count                                 # items loaded
0x124      4          i32 dataSize                              # the data memory items are read into
0x128      4          u8 *data                                        # the data memory: block + capacity x 0x98, after the nodes and items (ShapeManager_initBy); each shape is read in at data + dataUsed (shape_getByName); 0: each takes its own block
0x12c      4          i32 dataUsed                                    # bytes of data used: each loaded shape's blockSize added (shape_getByName); 0 again when its shapes are released (ShapeManager_releaseModels: release_all)
0x130      0x100      char textureSuffix[0x100]                 # (shapes) a suffix for its parts' texture names (playerRecord_setPartColour via shape_setTextureSuffix: "_T<player>"; empty: none): shape_bindTextureBy appends "*" and it to each part's name before tex_getIdByName, with bindFlags and the tint
0x230      4          u32 bindFlags                              # (shapes) given to shape_bindTextureBy with the tint; bit 1: tinted (shape_setTint)
0x234      0x18       float tint[6]                             # two hue / saturation / value triples (shape_setTint; passed as bits to shape_bindTextureBy)

struct SkelManager 0x130                                        # a skeleton manager (shapes_skeletons.c: SkeletonManager_initBy): Manager's first 0x130 bytes, without the textures and tint
4          4          i32 blockSize                                   # its block's size: capacity x 0x70 (a 0x4c-byte name node and a 0x24-byte skeleton each) + dataSize (SkeletonManager_initBy); take_block allocates it or checks the memory given against it
8          4          u8 *block                                 # the name nodes, then the items, then the data memory
0xc        4          i32 ownsBlock                             # 1: allocated here
0x10       0x100      char dir[0x100]                           # the folder of its loose .ske / .ase files (item_path, sources 0 / 1 only; not read with source 2, which every caller passes)
0x110      4          u32 source                                # where its skeletons load from: 0 / 1 loose .ske / .ase files, 2 the packed Data\\Skeleton.dat (skelDat_getItemFileBy); every caller passes 2
0x114      4          i32 capacity                              # items it has room for
0x118      4          u8 *nodes                                 # the name tree: one 0x4c-byte TreeNode per item
0x11c      4          u8 *items                                 # its skeletons (0x24 bytes each)
0x120      4          i32 count                                 # items loaded
0x124      4          i32 dataSize                              # the data memory items are read into
0x128      4          u8 *data                                        # the data memory: block + capacity x 0x70, after the nodes and items (SkeletonManager_initBy); each skeleton is read in at data + dataUsed (skel_getSkeletonPtrBy)
0x12c      4          i32 dataUsed                                    # bytes of data used: each loaded skeleton's blockSize added (skel_getSkeletonPtrBy); 0 again when its skeletons are released (SkeletonManager_releaseSkeletons: release_all)
struct PlayerRecord 0x47fd2                                      # a player of the match (Scene / Stage playerRecords): its team, mech parts and items; its actor points back (Actor.player)
0          4          i32 used                                   # (by use; seen running) 1: in use (playerRecord_markUsed / markFree)
0x479a4    0xa        signed char partHue[5][2]                 # per part its two tints' hue as a signed byte: hue_byte (the hue wrapped to -180 .. 180, (h + 180) x 0.7083333 - 128, about 256 / 360 a degree; playerRecord_setPartColour); sent in packet 2 (net_sendPlayerInfo, 30 bytes from here) and read back signed x 1.40625 (playerRecord_applyNetColours)
0x479ae    0xa        signed char partSaturation[5][2]          # per part its two tints' saturation x 128, kept to -1 .. 0.999 first (playerRecord_setPartColour: level_byte), a signed byte; sent in packet 2 (net_sendPlayerInfo, 30 bytes from partHue) and read back signed (playerRecord_applyNetColours: x k_0_0078125f)
0x479b8    0xa        signed char partValue[5][2]               # per part its two tints' value (brightness) x 128, kept to -1 .. 0.999 first (playerRecord_setPartColour: level_byte), a signed byte; sent in packet 2 (net_sendPlayerInfo) and read back signed (playerRecord_applyNetColours)
0x479c2    0x600      u32 flag[16][24]                         # (by use; seen running) its flag: 24 x 16 RGBA (the pilot's own picture, Save\<name>.BMP; drawn after its name and in the ranking)
0x47fca    4          i32 flagChanged                          # 1: to be copied into the flag atlas (flagShown: it is there)
0x47fce    4          i32 flagSent                             # (by use; seen running) its flag's pixels sent so far (0x180 = 24 x 16: all; the map's players start with all)
4          0x40       char name[0x40]                           # its name (player_setName, which also names its actors); its flag picture is Save\\<name>.BMP (playerRecord_loadFlag); shown in notices and messages
0x44       4          i32 character                              # its pilot character (g_characterProfiles: the skills and damage factors by it)
0x48       4          i32 team                                        # its team (< 0: none): set by player_setTeam (also its actors' team), -1 by stage_resetPlayerRecords / stage_newRound / leaving; copied to its actor (actor_setupFromParts); sent in packet 2 (net_sendPlayerInfo); bot_spawns' team colours
0x4c       0x140      char partNames[5][0x40]                   # its parts' type names (head, chest, arms, legs, booster: copied from the part type record by set_part / actor_setActorType*InfoBy; cleared by record_clearPartsItems); written, never read
0x18c      0x180      char itemNames[6][0x40]                   # its items' names (actor_setActorTypeItemInfoBy: the ActorItem's name, empty for none; cleared by record_clearPartsItems); written, never read
0x30c      0x14       i32 parts[5]                               # its mech's parts: head, chest, arms, legs, booster (records of the stage's part tables; "invalid headIndex")
0x320      0x18       i32 items[6]                              # per item slot (Actor.slot): its item (index into Stage.actorItems: a weapon or other hand / shoulder item; < 0 none; actor_setActorTypeItemInfoBy)
