0x8284     0x24c      ShapeManager chestShapes                    # (by use; seen running) its chest type's shapes (model_sets: ShapeManager_initBy over the data after it)
0x84d0     0x7d00     u8 chestShapeData[0x7d00]                       # chestShapes' block (stage_build: model_sets): 8 name nodes and shapes (0x98 bytes each), then 0x7840 bytes of shape data
0x101d0    0x24c      ShapeManager armShapes                      # (by use; seen running) its arm type's shapes (model_sets: ShapeManager_initBy over the data after it)
0x1041c    0xfa00     u8 armShapeData[0xfa00]                         # armShapes' block (stage_build: model_sets): 16 name nodes and shapes (0x98 bytes each), then 0xf080 bytes of shape data
0x1fe1c    0x24c      ShapeManager legShapes                      # (by use; seen running) its leg type's shapes (model_sets: ShapeManager_initBy over the data after it)
0x20068    0xfa00     u8 legShapeData[0xfa00]                         # legShapes' block (stage_build: model_sets): 16 name nodes and shapes (0x98 bytes each), then 0xf080 bytes of shape data
0x2fa68    0x24c      ShapeManager boosterShapes                  # (by use; seen running) its booster type's shapes (model_sets: ShapeManager_initBy over the data after it)
0x2fcb4    0x13880    u8 boosterShapeData[0x13880]                    # boosterShapes' block (stage_build: model_sets): 20 name nodes and shapes (0x98 bytes each), then 0x12ca0 bytes of shape data
