0x45804    0x130      SkelManager legSkels                  # its skeletons (SkeletonManager_initBy over the data after it)
0x45934    0xfa0      u8 legSkelData[0xfa0]                           # legSkels' block (stage_build: model_sets): 2 name nodes and skeletons (0x70 bytes each), then 0xec0 bytes of skeleton data
0x468d4    0x130      SkelManager boosterSkels              # its skeletons (SkeletonManager_initBy over the data after it)
