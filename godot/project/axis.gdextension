[configuration]

entry_symbol = "axis_godot_init"
compatibility_minimum = "4.5"

[libraries]

windows.debug.x86_64 = "res://bin/axis_godot.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/axis_godot.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libaxis_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libaxis_godot.linux.template_release.x86_64.so"
macos.debug = "res://bin/libaxis_godot.macos.template_debug.dylib"
macos.release = "res://bin/libaxis_godot.macos.template_release.dylib"

[dependencies]

macos.debug = { "res://bin/libaxis64.dylib": "Contents/Frameworks" }
macos.release = { "res://bin/libaxis64.dylib": "Contents/Frameworks" }
